<section class="tab epm-aba epm-combate {{cls.combate}}" data-group="primary" data-tab="combate">
  <div class="epm-combate-grade">
    <div class="epm-coluna">
      <section class="epm-painel">
        <header class="epm-painel-titulo"><h3>Defesa e movimento</h3></header>
        <div class="epm-combate-numeros">
          <div class="epm-numero">
            <span class="epm-rotulo">CA</span>
            <span class="epm-numero-valor">{{ficha.ca.total}}</span>
            {{#if edicao}}<div class="epm-numero-campos">
              <label class="epm-mini"><span>base</span><input type="number" name="flags.epm-ficha.ca.base" value="{{dados.ca.base}}" /></label>
              <label class="epm-mini"><span>bônus</span><input type="number" name="flags.epm-ficha.ca.bonus" value="{{dados.ca.bonus}}" /></label>
            </div>{{/if}}
          </div>
          <div class="epm-numero{{#if ficha.deslocamento.reduzido}} reduzido{{/if}}">
            <span class="epm-rotulo">Deslocamento</span>
            <span class="epm-numero-valor">{{epmNumero ficha.deslocamento.final}}<small>m</small></span>
            {{#if edicao}}<div class="epm-numero-campos"><label class="epm-mini"><span>base</span><input type="number" step="0.5" name="flags.epm-ficha.deslocamento.base" value="{{dados.deslocamento.base}}" /></label></div>{{/if}}
            {{#if ficha.deslocamento.motivos.length}}<span class="epm-numero-nota">{{epmJoin ficha.deslocamento.motivos}}</span>{{/if}}
          </div>
          <div class="epm-numero">
            <span class="epm-rotulo">Iniciativa</span>
            <button type="button" class="epm-numero-valor epm-rolavel" data-action="rolarIniciativa" title="Rolar iniciativa (Destreza). O resultado entra no combate ativo.">{{epmSinal ficha.iniciativa.total}}</button>
            {{#if edicao}}<div class="epm-numero-campos"><label class="epm-mini"><span>bônus</span><input type="number" name="flags.epm-ficha.iniciativa.bonus" value="{{dados.iniciativa.bonus}}" /></label></div>{{/if}}
          </div>
        </div>
        <div class="epm-defesas">
          {{#each ficha.defesas}}
          <button type="button" class="epm-defesa" data-action="defesa" data-defesa="{{id}}" title="{{descricao}}">
            <i class="{{icone}}" aria-hidden="true"></i>
            <span class="epm-defesa-nome">{{label}}</span>
            <span class="epm-defesa-valor">{{valor}}</span>
            <span class="epm-defesa-formula">CA + {{periciaNome}} {{epmSinal periciaBonus}}{{#if faltaPericia}} (perícia ausente){{/if}}</span>
          </button>
          {{/each}}
        </div>
      </section>

      <section class="epm-painel">
        <header class="epm-painel-titulo"><h3>Turno</h3></header>
        <div class="epm-turno">
          <div class="epm-turno-linha">
            <span class="epm-rotulo">Ações</span>
            <div class="epm-turno-acoes">
              {{#each acoesTurno}}<button type="button" class="epm-pip-acao{{#if usada}} usada{{/if}}" data-action="alternarAcao" data-acao="{{id}}" aria-pressed="{{#if usada}}true{{else}}false{{/if}}" title="{{#if usada}}Usada neste turno{{else}}Disponível{{/if}}">{{label}}</button>{{/each}}
            </div>
          </div>
          <div class="epm-turno-linha" title="Cada defesa gasta 1 ação do seu próximo turno">
            <span class="epm-rotulo">Defesas usadas</span>
            <div class="epm-pips">{{#each defesasPendentes}}<span class="epm-pip{{#if ativa}} ativa{{/if}}"></span>{{/each}}</div>
            <button type="button" class="epm-botao" data-action="novoTurno" title="Restaura as ações e desconta as defesas usadas (Movimento, depois Bônus, depois Padrão)">Novo turno</button>
          </div>
          <div class="epm-especiais">
            {{#each ficha.acoes.especiais}}
            {{#if (epmOr max @root.edicao)}}
            <div class="epm-especial{{#unless max}} inativa{{/unless}}" title="Só existe se alguma habilidade, magia ou item conceder">
              <span class="epm-especial-nome">{{label}}</span>
              <input type="number" min="0" name="flags.epm-ficha.acoes.{{id}}.value" value="{{value}}" aria-label="{{label}} disponíveis" />
              <span aria-hidden="true">/</span>
              {{#if @root.edicao}}<input type="number" min="0" name="flags.epm-ficha.acoes.{{id}}.max" value="{{max}}" aria-label="{{label}} por rodada" />{{else}}<span>{{max}}</span>{{/if}}
            </div>
            {{/if}}
            {{/each}}
          </div>
        </div>
        {{> "epm-exaustao"}}
        <div class="epm-descansos">
          <button type="button" class="epm-botao" data-action="descanso" data-tipo="curto"><i class="fa-solid fa-mug-hot" aria-hidden="true"></i> Descanso curto</button>
          <button type="button" class="epm-botao" data-action="descanso" data-tipo="longo"><i class="fa-solid fa-bed" aria-hidden="true"></i> Descanso longo</button>
        </div>
      </section>
    </div>

    <div class="epm-coluna">
      <section class="epm-painel epm-ataques">
        <header class="epm-painel-titulo">
          <h3>Ataques</h3>
          {{#if edicao}}<button type="button" class="epm-botao epm-botao-sutil" data-action="novoAtaque"><i class="fa-solid fa-plus"></i> Novo ataque</button>{{/if}}
        </header>
        {{#if ataques.vazio}}<p class="epm-vazio">Equipe uma arma no Inventário ou crie um ataque personalizado no modo edição.</p>{{/if}}
        <ol class="epm-lista-ataques">
          {{#each ataques.armas}}
          <li class="epm-ataque">
            <img class="epm-ataque-img" src="{{img}}" alt="" />
            <div class="epm-ataque-info"><span class="epm-ataque-nome">{{nome}}</span><span class="epm-ataque-sub">{{periciaNome}}, crítico {{critTexto}}</span></div>
            <span class="epm-ataque-acerto" title="Bônus de acerto">{{epmSinal acertoTotal}}</span>
            <span class="epm-ataque-dano" title="Dano">{{#if danoTexto}}{{danoTexto}}{{else}}—{{/if}}</span>
            <button type="button" class="epm-botao epm-botao-forte" data-action="atacar" data-tipo="arma" data-ref="{{id}}" title="Escolher vantagem, bônus e crítico, depois rolar acerto e dano">Atacar</button>
          </li>
          {{/each}}
          {{#each ataques.custom}}
          <li class="epm-ataque custom">
            <span class="epm-ataque-img epm-ataque-icone" aria-hidden="true"><i class="fa-solid fa-burst"></i></span>
            <div class="epm-ataque-info"><span class="epm-ataque-nome">{{nome}}</span><span class="epm-ataque-sub">{{periciaNome}}, crítico {{critTexto}}{{#if notas}}, {{notas}}{{/if}}</span></div>
            <span class="epm-ataque-acerto" title="Bônus de acerto">{{epmSinal acertoTotal}}</span>
            <span class="epm-ataque-dano" title="Dano">{{#if danoTexto}}{{danoTexto}}{{else}}—{{/if}}</span>
            <button type="button" class="epm-botao epm-botao-forte" data-action="atacar" data-tipo="custom" data-ref="{{id}}">Atacar</button>
            {{#if @root.edicao}}
            <div class="epm-ataque-campos">
              <label class="epm-mini largo"><span>nome</span><input type="text" name="flags.epm-ficha.ataques.{{id}}.nome" value="{{nome}}" /></label>
              <label class="epm-mini"><span>perícia</span><select name="flags.epm-ficha.ataques.{{id}}.pericia">{{#each opcoesPericia}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{nome}}</option>{{/each}}</select></label>
              <label class="epm-mini"><span>acerto</span><input type="number" name="flags.epm-ficha.ataques.{{id}}.bonusAcerto" value="{{bonusAcerto}}" /></label>
              <label class="epm-mini"><span>dano</span><input type="text" name="flags.epm-ficha.ataques.{{id}}.dano" value="{{dano}}" placeholder="1d8 + @atr.forca" /></label>
              <label class="epm-mini"><span>tipo</span><input type="text" name="flags.epm-ficha.ataques.{{id}}.tipoDano" value="{{tipoDano}}" placeholder="Corte" /></label>
              <label class="epm-mini"><span>margem</span><input type="number" min="2" max="20" name="flags.epm-ficha.ataques.{{id}}.critMargem" value="{{critMargem}}" /></label>
              <label class="epm-mini"><span>×crítico</span><input type="number" min="2" name="flags.epm-ficha.ataques.{{id}}.critMult" value="{{critMult}}" /></label>
              <label class="epm-mini largo"><span>notas</span><input type="text" name="flags.epm-ficha.ataques.{{id}}.notas" value="{{notas}}" placeholder="alcance, efeito…" /></label>
              <button type="button" class="epm-icone-botao perigo" data-action="excluirAtaque" data-ref="{{id}}" title="Excluir ataque"><i class="fa-solid fa-trash"></i></button>
            </div>
            {{/if}}
          </li>
          {{/each}}
        </ol>
        {{#if ataques.armasGuardadas}}<p class="epm-dica">{{ataques.armasGuardadas}} arma(s) não equipada(s) no Inventário.</p>{{/if}}
      </section>

      <section class="epm-painel epm-cena">
        <header class="epm-painel-titulo">
          <h3>Bônus de cena</h3>
          {{#if edicao}}<button type="button" class="epm-botao epm-botao-sutil" data-action="novoBonusCena"><i class="fa-solid fa-plus"></i> Novo bônus</button>{{/if}}
        </header>
        <p class="epm-dica">Ligados, somam em todos os ataques. Ex.: uma habilidade que dá +1d8 de dano pela cena.</p>
        {{#unless bonusCena.length}}<p class="epm-vazio">Nenhum bônus preparado.{{#unless edicao}} Crie no modo edição.{{/unless}}</p>{{/unless}}
        {{#each bonusCena}}
        <div class="epm-bonus{{#if ativo}} ativo{{/if}}">
          <label class="epm-interruptor" title="{{#if ativo}}Ligado{{else}}Desligado{{/if}}">
            <input type="checkbox" name="flags.epm-ficha.bonusCena.{{id}}.ativo" {{epmChecked ativo}} aria-label="Ligado" />
            <span class="epm-interruptor-trilho" aria-hidden="true"></span>
          </label>
          {{#if @root.edicao}}
          <input type="text" class="epm-bonus-nome" name="flags.epm-ficha.bonusCena.{{id}}.nome" value="{{nome}}" placeholder="Nome do bônus" aria-label="Nome" />
          <label class="epm-mini"><span>acerto</span><input type="number" name="flags.epm-ficha.bonusCena.{{id}}.acerto" value="{{acerto}}" /></label>
          <label class="epm-mini"><span>dano</span><input type="text" name="flags.epm-ficha.bonusCena.{{id}}.dano" value="{{dano}}" placeholder="1d8" /></label>
          <button type="button" class="epm-icone-botao perigo" data-action="excluirBonusCena" data-ref="{{id}}" title="Excluir"><i class="fa-solid fa-trash"></i></button>
          {{else}}
          <span class="epm-bonus-nome">{{#if nome}}{{nome}}{{else}}Bônus sem nome{{/if}}</span>
          {{#if acerto}}<span class="epm-tag">{{epmSinal acerto}} acerto</span>{{/if}}
          {{#if dano}}<span class="epm-tag epm-tag-dano">+{{dano}} dano</span>{{/if}}
          {{/if}}
        </div>
        {{/each}}
      </section>
    </div>
  </div>
</section>
