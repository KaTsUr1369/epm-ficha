<section class="tab epm-aba epm-combate {{cls.combate}}" data-group="primary" data-tab="combate">
  <div class="epm-combate-grade">
    <div class="epm-coluna">
      <section class="epm-painel">
        <header class="epm-painel-titulo"><h3>Defesa e movimento</h3></header>
        <div class="epm-combate-numeros">
          <div class="epm-numero">
            <span class="epm-rotulo">CA</span>
            <span class="epm-numero-valor{{#if ficha.ca.penal}} penalizado{{/if}}" title="{{caFormula}}{{#if ficha.ca.penal}}&#10;Defesa {{epmSinal ficha.ca.penal}}: {{@root.caPenalTexto}}{{/if}}">{{ficha.ca.total}}</span>
            <span class="epm-numero-nota epm-ca-formula">{{ficha.ca.base}} + {{ficha.ca.atributoLabel}} {{epmSinal ficha.ca.atributoValor}} + Armaduras e escudos {{ficha.ca.armadura}}</span>
            {{#if edicao}}<div class="epm-numero-campos epm-ca-campos">
              <label class="epm-mini"><span>base</span><input type="number" name="flags.epm-ficha.ca.base" value="{{dados.ca.base}}" /></label>
              <label class="epm-mini epm-ca-atributo"><span>atributo</span><select name="flags.epm-ficha.ca.atributo" aria-label="Atributo somado na CA">{{#each caAtributos}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.abrev}}</option>{{/each}}</select></label>
              <label class="epm-mini epm-ca-fixo" title="Vem só das armaduras e escudos equipados no Inventário{{#if caArmaduraFontes}}: {{caArmaduraFontes}}{{/if}}"><span>armaduras e escudos</span><input type="number" value="{{ficha.ca.armadura}}" readonly disabled aria-readonly="true" /></label>
              <label class="epm-mini"><span>outros</span><input type="number" name="flags.epm-ficha.ca.bonus" value="{{dados.ca.bonus}}" /></label>
            </div>
            <span class="epm-numero-nota">Armaduras e escudos: só o que está equipado no Inventário.</span>{{/if}}
          </div>
          <div class="epm-numero{{#if ficha.deslocamento.reduzido}} reduzido{{/if}}">
            <span class="epm-rotulo">Deslocamento</span>
            <span class="epm-numero-valor">{{epmNumero ficha.deslocamento.final}}<small>m</small></span>
            {{#if edicao}}<div class="epm-numero-campos"><label class="epm-mini"><span>base</span><input type="number" step="0.5" name="flags.epm-ficha.deslocamento.base" value="{{dados.deslocamento.base}}" /></label></div>{{/if}}
            {{#if ficha.deslocamento.motivos.length}}<span class="epm-numero-nota">{{epmJoin ficha.deslocamento.motivos}}</span>{{/if}}
          </div>
          <div class="epm-numero">
            <span class="epm-rotulo">Iniciativa</span>
            <button type="button" class="epm-numero-valor epm-rolavel" data-action="rolarIniciativa" title="Rolar iniciativa (Destreza). O resultado entra no combate ativo.">{{epmSinal ficha.iniciativa.total}}</button>
            {{#if ficha.iniciativa.testeMod}}<span class="epm-selo {{#if (epmMenor ficha.iniciativa.testeMod 0)}}penal{{else}}bonus{{/if}}" title="Penalidades nos testes de Destreza">{{epmSinal ficha.iniciativa.testeMod}}</span>{{/if}}
            {{#if ficha.iniciativa.zero.length}}<span class="epm-numero-nota">Iniciativa 0: {{epmJoin ficha.iniciativa.zero}}</span>{{/if}}
            {{#if edicao}}<div class="epm-numero-campos"><label class="epm-mini"><span>bônus</span><input type="number" name="flags.epm-ficha.iniciativa.bonus" value="{{dados.iniciativa.bonus}}" /></label></div>{{/if}}
          </div>
        </div>
        <div class="epm-defesas">
          {{#each ficha.defesas}}
          <button type="button" class="epm-defesa" data-action="defesa" data-defesa="{{this.id}}" title="{{this.descricao}}">
            <span class="epm-defesa-nome"><i class="{{this.icone}}" aria-hidden="true"></i> {{this.label}}</span>
            <span class="epm-defesa-valor">{{this.valor}}</span>
            <span class="epm-defesa-formula">CA + {{this.periciaNome}} {{epmSinal periciaBonus}}{{#if faltaPericia}} (perícia ausente){{/if}}</span>
          </button>
          {{/each}}
        </div>
      </section>

      <section class="epm-painel epm-rd">
        <header class="epm-painel-titulo"><h3>Redução de dano (RD)</h3>
          {{#if edicao}}<button type="button" class="epm-link" data-action="novaRd"><i class="fa-solid fa-plus" aria-hidden="true"></i> RD</button>{{/if}}</header>
        <p class="epm-dica">Como uma resistência a um tipo de dano, mas em vez de cortar à metade tira o número escolhido. Entra sozinha no "Aplicar dano", depois da imunidade, da vulnerabilidade (×2) e da resistência (metade). Nível entre parênteses: "Fogo (Mágico)" segura até dano Mágico; sem nível, só Natural.</p>
        {{#if edicao}}
        {{#each rdBox.manuais}}
        <div class="epm-rd-linha">
          <label class="epm-mini"><span>RD</span><input type="number" min="0" name="flags.epm-ficha.rd.{{this.id}}.valor" value="{{this.valor}}" /></label>
          <label class="epm-mini largo"><span>tipo de dano</span><input type="text" name="flags.epm-ficha.rd.{{this.id}}.tipo" value="{{this.tipo}}" list="epm-sug-rd-{{@root.actor.id}}" placeholder="Todos os danos" /></label>
          <button type="button" class="epm-icone-botao" data-action="removerRd" data-rd="{{this.id}}" title="Remover" aria-label="Remover RD"><i class="fa-solid fa-trash"></i></button>
        </div>
        {{/each}}
        <datalist id="epm-sug-rd-{{@root.actor.id}}">{{#each rdBox.sugestoes}}<option value="{{this}}"></option>{{/each}}</datalist>
        {{#unless rdBox.manuais.length}}<p class="epm-vazio">Nenhuma RD na ficha. Clique em + RD.</p>{{/unless}}
        {{else}}
        <div class="epm-chips">
          {{#each rdBox.manuais}}{{#if ativa}}<span class="epm-chip epm-chip-rd">{{this.texto}}</span>{{/if}}{{/each}}
        </div>
        {{#if rdBox.vazio}}<p class="epm-vazio">Nenhuma redução de dano.</p>{{/if}}
        {{/if}}
        {{#if rdBox.deItens.length}}<div class="epm-chips"><span class="epm-rotulo">De itens</span>{{#each rdBox.deItens}}<span class="epm-chip epm-chip-rd" title="{{this.fonte}}">{{this.texto}}</span>{{/each}}</div>{{/if}}
      </section>

      <section class="epm-painel epm-defesas-dano">
        <header class="epm-painel-titulo"><h3>Defesas contra dano</h3></header>
        {{#if edicao}}
        <div class="epm-tags-grade">
          {{#each tagsCondicoes}}
          <div class="epm-tags" data-campo="{{this.campo}}">
            <span class="epm-rotulo">{{this.label}}</span>
            <p class="epm-dica">{{this.dica}}</p>
            <ul class="epm-tag-lista">
              {{#each itens}}<li class="epm-chip">{{this}}<button type="button" data-action="removerTag" data-campo="{{../campo}}" data-valor="{{this}}" aria-label="Remover {{this}}"><i class="fa-solid fa-xmark"></i></button></li>{{/each}}
            </ul>
            <input type="text" class="epm-tag-input" data-tag-campo="{{this.campo}}" list="epm-sug-{{this.campo}}-{{@root.actor.id}}" placeholder="Escolha ou digite e tecle Enter" aria-label="Adicionar em {{this.label}}" />
            <datalist id="epm-sug-{{this.campo}}-{{@root.actor.id}}">{{#each sugestoes}}<option value="{{this}}"></option>{{/each}}</datalist>
          </div>
          {{/each}}
        </div>
        {{#if defesasBox.deFora}}<p class="epm-dica">Também valem as que vêm de itens, bênçãos e condições (aparecem fora do modo edição).</p>{{/if}}
        {{else}}
        {{#if defesasBox.vazio}}<p class="epm-vazio">Nenhuma resistência, imunidade ou vulnerabilidade.</p>{{/if}}
        {{#if defesasBox.resistencias.length}}<div class="epm-chips"><span class="epm-rotulo">Resiste</span>{{#each defesasBox.resistencias}}<span class="epm-chip" {{#if fonte}}title="{{this.fonte}}"{{/if}}>{{this.texto}}</span>{{/each}}</div>{{/if}}
        {{#if defesasBox.imunidades.length}}<div class="epm-chips"><span class="epm-rotulo">Imune</span>{{#each defesasBox.imunidades}}<span class="epm-chip epm-chip-imune" {{#if fonte}}title="{{this.fonte}}"{{/if}}>{{this.texto}}</span>{{/each}}</div>{{/if}}
        {{#if defesasBox.vulnerabilidades.length}}<div class="epm-chips"><span class="epm-rotulo">Vulnerável</span>{{#each defesasBox.vulnerabilidades}}<span class="epm-chip epm-chip-vulneravel{{#if anulada}} anulada{{/if}}" title="{{this.fonte}}{{#if anulada}}&#10;Anulada por {{this.anulada}}{{/if}}">{{this.texto}}</span>{{/each}}</div>{{/if}}
        <p class="epm-dica">Ordem do dano: imunidade → vulnerabilidade (×2) → resistência (metade) → RD.</p>
        {{/if}}
      </section>

      <section class="epm-painel">
        <header class="epm-painel-titulo"><h3>Turno</h3></header>
        <div class="epm-turno">
          <div class="epm-turno-linha">
            <span class="epm-rotulo">Ações</span>
            <div class="epm-turno-acoes">
              {{#each acoesTurno}}<button type="button" class="epm-pip-acao{{#if usada}} usada{{/if}}{{#if bloqueada}} bloqueada{{/if}}" data-action="alternarAcao" data-acao="{{this.id}}" aria-pressed="{{#if usada}}true{{else}}false{{/if}}" title="{{#if motivo}}{{this.motivo}}{{else if usada}}Usada neste turno{{else}}Disponível{{/if}}">{{#if bloqueada}}<i class="fa-solid fa-lock" aria-hidden="true"></i> {{/if}}{{this.label}}</button>{{/each}}
            </div>
          </div>
          <div class="epm-turno-linha" title="Cada defesa gasta 1 ação do seu próximo turno">
            <span class="epm-rotulo">Defesas usadas</span>
            <div class="epm-pips">{{#each defesasPendentes}}<span class="epm-pip{{#if ativa}} ativa{{/if}}"></span>{{/each}}</div>
            <button type="button" class="epm-botao{{#if efeitosTurno.dots}} epm-botao-forte{{else if efeitosTurno.insano}} epm-botao-forte{{/if}}" data-action="novoTurno" title="Restaura as ações, desconta as defesas usadas (Movimento, depois Bônus, depois Padrão){{#if efeitosTurno.dots}}, aplica o dano contínuo das condições{{/if}}{{#if efeitosTurno.insano}} e rola a tabela de Insano{{/if}}">Novo turno</button>
          </div>
{{#if temSustentadas}}<div class="epm-sustentadas" aria-label="Sustentadas"><span class="epm-rotulo"><i class="fa-solid fa-hourglass-start" aria-hidden="true"></i> Sustentando</span>{{#each sustentadas}}<span class="epm-tag epm-sustentada">{{this.nome}} · {{this.custoTexto}}{{#if editavel}} <button type="button" class="epm-icone-botao" data-action="encerrarSustentada" data-sustentada="{{this.id}}" title="Encerrar (para de gastar)"><i class="fa-solid fa-xmark"></i></button>{{/if}}</span>{{/each}}</div>{{/if}}
          <div class="epm-turno-extras">
            <button type="button" class="epm-botao epm-botao-sutil" data-action="ataqueOportunidade" {{#unless editavel}}disabled{{/unless}} title="Um inimigo a até 1,5 m tenta sair do seu alcance: gasta a Reação e faz 1 ataque simples"><i class="fa-solid fa-person-running" aria-hidden="true"></i> Ataque de oportunidade</button>
            <button type="button" class="epm-botao epm-botao-sutil" data-action="atrasarTurno" {{#unless editavel}}disabled{{/unless}} title="No início do seu turno: escolha depois de quem agir. 1 vez por combate; a nova posição fica até o fim"><i class="fa-solid fa-hourglass-half" aria-hidden="true"></i> Atrasar turno</button>
          </div>
          <div class="epm-especiais">
            {{#each ficha.acoes.especiais}}
            {{#if (epmOr max @root.edicao)}}
            <div class="epm-especial{{#unless max}} inativa{{/unless}}" title="Só existe se alguma habilidade, magia ou item conceder">
              <span class="epm-especial-nome">{{this.label}}</span>
              <input type="number" min="0" name="flags.epm-ficha.acoes.{{this.id}}.value" value="{{this.value}}" aria-label="{{this.label}} disponíveis" />
              <span aria-hidden="true">/</span>
              {{#if @root.edicao}}<input type="number" min="0" name="flags.epm-ficha.acoes.{{this.id}}.max" value="{{this.max}}" aria-label="{{this.label}} por rodada" />{{else}}<span>{{this.max}}</span>{{/if}}
            </div>
            {{/if}}
            {{/each}}
          </div>
        </div>
        {{> "epm-exaustao"}}
        <div class="epm-descansos">
          <button type="button" class="epm-botao" data-action="descanso" data-tipo="curto"><i class="fa-solid fa-mug-hot" aria-hidden="true"></i> Descanso curto</button>
          <button type="button" class="epm-botao" data-action="descanso" data-tipo="longo"><i class="fa-solid fa-bed" aria-hidden="true"></i> Descanso longo</button>
        </div>
      </section>
    </div>

    <div class="epm-coluna">
      {{#if combateArquetipo.length}}
      <section class="epm-painel epm-arq-combate">
        <header class="epm-painel-titulo"><h3>Arquétipo em combate</h3></header>
        {{#each combateArquetipo}}
        <div class="epm-arq-combate-bloco" style="--cor: {{this.cor}}">
          <h4><i class="{{this.icone}}" aria-hidden="true"></i> {{this.nome}} <span class="epm-contador">Nv. {{this.nivel}}</span></h4>
          <ul class="epm-arq-linhas">{{#each linhas}}<li>{{this}}</li>{{/each}}</ul>
          {{#if botoes.length}}<div class="epm-chips">{{#each botoes}}<button type="button" class="epm-botao" data-action="{{this.acao}}" title="{{this.dica}}" {{#if desabilitado}}disabled{{/if}}><i class="{{this.icone}}" aria-hidden="true"></i> {{this.label}}</button>{{/each}}</div>{{/if}}
        </div>
        {{/each}}
      </section>
      {{/if}}
      <section class="epm-painel epm-ataques">
        <header class="epm-painel-titulo">
          <h3>Ataques</h3>
          {{#if edicao}}<button type="button" class="epm-botao epm-botao-sutil" data-action="novoAtaque"><i class="fa-solid fa-plus"></i> Novo ataque</button>{{/if}}
        </header>
        {{#if ataques.vazio}}<p class="epm-vazio">Equipe uma arma no Inventário ou crie um ataque personalizado no modo edição.</p>{{/if}}
        {{#if ataques.bloqueados}}<p class="epm-aviso"><i class="fa-solid fa-ban" aria-hidden="true"></i> Não pode atacar: {{ataques.bloqueados}}</p>{{/if}}
        <ol class="epm-lista-ataques">
          {{#each ataques.armas}}
          <li class="epm-ataque">
            <img class="epm-ataque-img" src="{{this.img}}" alt="" />
            <div class="epm-ataque-info"><span class="epm-ataque-nome">{{this.nome}}{{#if favoritaCombatente}} <span class="epm-tag epm-tag-ok" title="Arma Favorita do Combatente ({{this.tipoArma}})"><i class="fa-solid fa-medal" aria-hidden="true"></i> Maestria</span>{{/if}}</span><span class="epm-ataque-sub">{{this.periciaNome}}, crítico {{this.critTexto}}</span>{{#if (epmOr municaoTexto (epmOr cargasTexto penteTexto))}}<span class="epm-ataque-sub">{{#if penteTexto}}<span class="epm-item-recurso{{#if penteVazio}} acabou{{/if}}"><i class="fa-solid fa-gun" aria-hidden="true"></i> {{this.penteTexto}}</span> <button type="button" class="epm-link" data-action="recarregarArma" data-item-id="{{this.id}}" title="Enche o pente com a munição ligada e gasta a {{this.recargaTexto}}"><i class="fa-solid fa-rotate" aria-hidden="true"></i> Recarregar ({{this.recargaTexto}})</button> {{/if}}{{#if municaoTexto}}<span class="epm-item-recurso{{#if semMunicao}} acabou{{/if}}"><i class="fa-solid fa-bullseye" aria-hidden="true"></i> {{this.municaoTexto}}</span> {{/if}}{{#if cargasTexto}}<span class="epm-item-recurso"><i class="fa-solid fa-bolt" aria-hidden="true"></i> {{this.cargasTexto}}</span>{{/if}}</span>{{/if}}</div>
            <span class="epm-ataque-acerto{{#if acertoMods}} penalizado{{/if}}" title="Bônus de acerto{{#if acertoModsTexto}}&#10;{{this.acertoModsTexto}}{{/if}}">{{epmSinal acertoTotal}}</span>
            <span class="epm-ataque-dano" title="Dano{{#if danoMult}} (×{{this.danoMult}}){{/if}}">{{#if danoTexto}}{{this.danoTexto}}{{else}}—{{/if}}{{#if danoMult}} <strong>×{{this.danoMult}}</strong>{{/if}}</span>
            <button type="button" class="epm-botao epm-botao-forte" data-action="atacar" data-tipo="arma" data-ref="{{this.id}}" title="Escolher vantagem, bônus e crítico, depois rolar acerto e dano">Atacar</button>
          </li>
          {{/each}}
          {{#each ataques.custom}}
          <li class="epm-ataque custom">
            <span class="epm-ataque-img epm-ataque-icone" aria-hidden="true"><i class="fa-solid fa-burst"></i></span>
            <div class="epm-ataque-info"><span class="epm-ataque-nome">{{this.nome}}</span><span class="epm-ataque-sub">{{this.periciaNome}}, crítico {{this.critTexto}}{{#if notas}}, {{this.notas}}{{/if}}</span></div>
            <span class="epm-ataque-acerto{{#if acertoMods}} penalizado{{/if}}" title="Bônus de acerto{{#if acertoModsTexto}}&#10;{{this.acertoModsTexto}}{{/if}}">{{epmSinal acertoTotal}}</span>
            <span class="epm-ataque-dano" title="Dano">{{#if danoTexto}}{{this.danoTexto}}{{else}}—{{/if}}{{#if danoMult}} <strong>×{{this.danoMult}}</strong>{{/if}}</span>
            <button type="button" class="epm-botao epm-botao-forte" data-action="atacar" data-tipo="custom" data-ref="{{this.id}}">Atacar</button>
            {{#if @root.edicao}}
            <div class="epm-ataque-campos">
              <label class="epm-mini largo"><span>nome</span><input type="text" name="flags.epm-ficha.ataques.{{this.id}}.nome" value="{{this.nome}}" /></label>
              <label class="epm-mini"><span>perícia</span><select name="flags.epm-ficha.ataques.{{this.id}}.pericia">{{#each opcoesPericia}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.nome}}</option>{{/each}}</select></label>
              <label class="epm-mini"><span>acerto</span><input type="number" name="flags.epm-ficha.ataques.{{this.id}}.bonusAcerto" value="{{this.bonusAcerto}}" /></label>
              <label class="epm-mini"><span>dano</span><input type="text" name="flags.epm-ficha.ataques.{{this.id}}.dano" value="{{this.dano}}" placeholder="1d8 + @atr.forca" /></label>
              <label class="epm-mini"><span>tipo</span><input type="text" name="flags.epm-ficha.ataques.{{this.id}}.tipoDano" value="{{this.tipoDano}}" list="epm-sug-dano-{{@root.actor.id}}" placeholder="Cortante" /></label>
              <label class="epm-mini"><span>margem</span><input type="number" min="2" max="20" name="flags.epm-ficha.ataques.{{this.id}}.critMargem" value="{{this.critMargem}}" /></label>
              <label class="epm-mini"><span>×crítico</span><input type="number" min="2" name="flags.epm-ficha.ataques.{{this.id}}.critMult" value="{{this.critMult}}" /></label>
              <label class="epm-mini largo"><span>notas</span><input type="text" name="flags.epm-ficha.ataques.{{this.id}}.notas" value="{{this.notas}}" placeholder="alcance, efeito…" /></label>
              <button type="button" class="epm-icone-botao perigo" data-action="excluirAtaque" data-ref="{{this.id}}" title="Excluir ataque"><i class="fa-solid fa-trash"></i></button>
            </div>
            {{/if}}
          </li>
          {{/each}}
        </ol>
        {{#if ataques.armasGuardadas}}<p class="epm-dica">{{ataques.armasGuardadas}} arma(s) não equipada(s) no Inventário.</p>{{/if}}
      </section>

      <section class="epm-painel epm-cena">
        <header class="epm-painel-titulo">
          <h3>Bônus de cena</h3>
          {{#if edicao}}<button type="button" class="epm-botao epm-botao-sutil" data-action="novoBonusCena"><i class="fa-solid fa-plus"></i> Novo bônus</button>{{/if}}
        </header>
        <p class="epm-dica">Ligados, somam em todos os ataques (acerto e dano), na CA e na RD. Ex.: uma habilidade que dá +1d8 de dano pela cena. Os criados por bônus situacionais de habilidades somem no fim do combate.</p>
        {{#unless bonusCena.length}}<p class="epm-vazio">Nenhum bônus preparado.{{#unless edicao}} Crie no modo edição.{{/unless}}</p>{{/unless}}
        {{#each bonusCena}}
        <div class="epm-bonus{{#if ativo}} ativo{{/if}}">
          <label class="epm-interruptor" title="{{#if ativo}}Ligado{{else}}Desligado{{/if}}">
            <input type="checkbox" name="flags.epm-ficha.bonusCena.{{this.id}}.ativo" {{epmChecked ativo}} aria-label="Ligado" />
            <span class="epm-interruptor-trilho" aria-hidden="true"></span>
          </label>
          {{#if @root.edicao}}
          <input type="text" class="epm-bonus-nome" name="flags.epm-ficha.bonusCena.{{this.id}}.nome" value="{{this.nome}}" placeholder="Nome do bônus" aria-label="Nome" />
          <label class="epm-mini"><span>acerto</span><input type="number" name="flags.epm-ficha.bonusCena.{{this.id}}.acerto" value="{{this.acerto}}" /></label>
          <label class="epm-mini"><span>dano</span><input type="text" name="flags.epm-ficha.bonusCena.{{this.id}}.dano" value="{{this.dano}}" placeholder="1d8" /></label>
          <label class="epm-mini"><span>CA</span><input type="number" name="flags.epm-ficha.bonusCena.{{this.id}}.ca" value="{{this.ca}}" /></label>
          <label class="epm-mini"><span>RD</span><input type="number" min="0" name="flags.epm-ficha.bonusCena.{{this.id}}.rd" value="{{this.rd}}" /></label>
          <button type="button" class="epm-icone-botao perigo" data-action="excluirBonusCena" data-ref="{{this.id}}" title="Excluir"><i class="fa-solid fa-trash"></i></button>
          {{else}}
          <span class="epm-bonus-nome">{{#if nome}}{{this.nome}}{{else}}Bônus sem nome{{/if}}</span>
          {{#if acerto}}<span class="epm-tag">{{epmSinal acerto}} acerto</span>{{/if}}
          {{#if dano}}<span class="epm-tag epm-tag-dano">+{{this.dano}} dano</span>{{/if}}
          {{#if ca}}<span class="epm-tag">{{epmSinal ca}} CA</span>{{/if}}
          {{#if rd}}<span class="epm-tag epm-chip-rd">RD {{this.rd}}{{#if rdTipo}} ({{this.rdTipo}}){{/if}}</span>{{/if}}
          {{#if testes}}<span class="epm-tag">{{epmSinal testes}} testes</span>{{/if}}
          {{#if deslocamento}}<span class="epm-tag">+{{this.deslocamento}} m</span>{{/if}}
          {{#if cena}}<span class="epm-tag fraca" title="Some no fim do combate ou no descanso">pela cena</span>{{/if}}
          {{/if}}
        </div>
        {{/each}}
      </section>
    </div>
  </div>
</section>
