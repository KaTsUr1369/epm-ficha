<section class="tab epm-aba epm-habilidades {{cls.habilidades}}" data-group="primary" data-tab="habilidades">
  <header class="epm-aba-topo">
    <div class="epm-aba-resumo">
      <span class="epm-contador" title="Pontos de Habilidade disponíveis">{{ficha.pontos.ph}} PH</span>
      <span class="epm-contador" title="CD dos testes de resistência contra você: 8 + {{ficha.cd.periciaNome}}">CD {{ficha.cd.valor}}</span>
      <span class="epm-contador" title="Habilidades conhecidas (sub-aba Geral) e espaços. Habilidades Únicas e as de Arquétipo e Classe não contam.">{{habilidades.conhecidas}} de {{habilidades.espacos}} conhecidas</span>
    </div>
    {{#if editavel}}<button type="button" class="epm-botao epm-botao-forte" data-action="novoPoder" data-tipo="habilidade" title="Cria na sub-aba aberta"><i class="fa-solid fa-plus"></i> Nova habilidade</button>{{/if}}
  </header>
  <nav class="epm-subnav" aria-label="Tipos de habilidade">
    {{#each habilidades.subabas}}
    <button type="button" class="epm-subnav-item {{this.cls}}" data-action="aba" data-group="habilidades" data-tab="{{this.id}}">{{this.label}}<span class="epm-subnav-qtd">{{this.total}}</span></button>
    {{/each}}
  </nav>
  {{#each habilidades.subabas}}
  <div class="tab epm-subaba-habilidades {{this.cls}}" data-group="habilidades" data-tab="{{this.id}}">
    {{#if origem}}<p class="epm-dica">Habilidades de {{this.label}} usam só Passiva e Comum.{{#if @root.dados.personalizacao.abasExtras.arqclasse}} Elas também aparecem na aba Arquétipo e Classe.{{/if}}</p>{{/if}}
    {{#each secoes}}
    <section class="epm-secao-poder" style="--cor: {{this.cor}}" data-secao="{{../id}}-{{this.id}}">
      <header class="epm-secao-titulo">
        <h3>{{this.label}}</h3>
        {{#if limite}}<span class="epm-contador{{#if excedido}} excedido{{else if cheio}} cheio{{/if}}" title="Limite desta raridade{{#if (epmEq @root.modoLimites "combinados")}} (habilidades e magias somadas){{/if}}">{{this.usados}} de {{this.limite}}</span>{{/if}}
      </header>
      {{#if vazia}}<p class="epm-vazio">Nada nesta categoria.</p>{{/if}}
      <ol class="epm-poderes">{{#each itens}}{{> "epm-poder-linha"}}{{/each}}</ol>
    </section>
    {{/each}}
  </div>
  {{/each}}
</section>
