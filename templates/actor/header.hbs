<header class="epm-cabecalho{{#if edicao}} modo-edicao{{/if}}">
  {{#if editavel}}
  <button type="button" class="epm-modo-edicao{{#if edicao}} ativo{{/if}}" data-action="alternarEdicao" aria-pressed="{{#if edicao}}true{{else}}false{{/if}}" title="{{#if edicao}}Sair do modo edição{{else}}Entrar no modo edição para mudar atributos, máximos e detalhes{{/if}}">
    <span class="epm-modo-trilho" aria-hidden="true"></span><span>{{#if edicao}}Editando{{else}}Editar{{/if}}</span>
  </button>
  {{/if}}
  <div class="epm-astrolabio" title="Anéis: Vida, Mana, Estamina e Sanidade (de fora para dentro)">
    <svg class="epm-aneis" viewBox="0 0 150 150" aria-hidden="true">
      {{#each marcas}}<line class="epm-marca{{#if longo}} longa{{/if}}" x1="{{this.x1}}" y1="{{this.y1}}" x2="{{this.x2}}" y2="{{this.y2}}" />{{/each}}
      {{#each aneis}}
      <circle class="epm-anel-trilho" cx="75" cy="75" r="{{this.r}}" />
      <circle class="epm-anel" cx="75" cy="75" r="{{this.r}}" style="stroke: {{this.cor}}" stroke-dasharray="{{this.dash}} {{this.resto}}" transform="rotate(-90 75 75)" />
      {{/each}}
    </svg>
    <img class="epm-retrato" src="{{retrato}}" alt="Retrato de {{actor.name}}" {{#if edicao}}data-action="editarImagem" title="Trocar retrato (do computador ou dos arquivos)"{{else}}data-action="verImagem" data-src="{{retrato}}" data-titulo="{{actor.name}}" title="Ver retrato"{{/if}} />
    {{#if transformacaoAtiva}}<span class="epm-selo-transformacao" title="Transformado{{#if transformacaoAtiva.turnos}}: faltam {{transformacaoAtiva.turnos}} turno(s){{/if}}"><i class="fa-solid fa-dragon" aria-hidden="true"></i> {{transformacaoAtiva.nome}}{{#if transformacaoAtiva.turnos}} · {{transformacaoAtiva.turnos}}{{/if}}</span>{{/if}}
  </div>

  <div class="epm-identidade">
    {{#if edicao}}
    <input class="epm-nome" type="text" name="name" value="{{actor.name}}" placeholder="Nome do personagem" aria-label="Nome do personagem" />
    <div class="epm-linha-identidade">
      <label class="epm-campo"><span>Raça</span><input type="text" name="flags.epm-ficha.raca" value="{{dados.raca}}" /></label>
      <label class="epm-campo"><span>Arquétipo</span><input type="text" name="flags.epm-ficha.arquetipo" value="{{dados.arquetipo}}" list="epm-arquetipos-{{actor.id}}" /></label>
      <button type="button" class="epm-icone-botao" data-action="abrirCompendioClasses" title="Compêndio de Arquétipos e Classes (arraste um para a ficha)"><i class="fa-solid fa-book-atlas"></i></button>
      {{#if classePainel.temArquetipo}}
      <label class="epm-campo"><span>Classe</span><select data-escolher-classe aria-label="Classe" title="Só as classes do arquétipo">
        <option value="">— Escolher —</option>
        {{#each classePainel.opcoes}}<option value="{{this.id}}" {{#if (epmEq this.id @root.classePainel.id)}}selected{{/if}}>{{this.nome}}</option>{{/each}}
        {{#if classePainel.foraDoArquetipo}}<option value="{{classePainel.id}}" selected>{{classePainel.nome}} (outro arquétipo)</option>{{/if}}
        <option value="__livre" {{#if classePainel.livre}}selected{{/if}}>Outra (escrever)…</option>
      </select></label>
      {{#if classePainel.livre}}<label class="epm-campo"><span>Nome da classe</span><input type="text" name="flags.epm-ficha.classe" value="{{dados.classe}}" placeholder="Escreva a classe" /></label>{{/if}}
      {{else if dados.classe}}
      <label class="epm-campo" title="Escolha o arquétipo para trocar a classe"><span>Classe</span><input type="text" disabled value="{{dados.classe}}" /></label>
      {{/if}}
      <label class="epm-campo epm-campo-nivel"><span>Nível</span><input type="number" name="flags.epm-ficha.nivel" value="{{dados.nivel}}" min="1" max="50" /></label>
      <datalist id="epm-arquetipos-{{actor.id}}">{{#each arquetiposSugeridos}}<option value="{{this}}"></option>{{/each}}</datalist>
    </div>
    {{else}}
    <h1 class="epm-nome-texto">{{actor.name}}{{#if musica}} <button type="button" class="epm-musica" data-action="tocarMusica" data-url="{{musica}}" title="Música tema{{#if musicaNome}}: {{musicaNome}}{{/if}} (abre em outra aba)"><i class="fa-solid fa-music" aria-hidden="true"></i></button>{{/if}}</h1>
    {{#if tituloAtivo}}<p class="epm-titulo-ativo" title="Título ativo"><i class="fa-solid fa-award" aria-hidden="true"></i> {{tituloAtivo}}</p>{{/if}}
    {{#if bordao}}<p class="epm-bordao" title="Bordão">“{{bordao}}”</p>{{/if}}
    <dl class="epm-identidade-texto">
      <div><dt>Raça</dt><dd>{{#if dados.raca}}{{dados.raca}}{{else}}—{{/if}}</dd></div>
      <div><dt>Arquétipo</dt><dd>{{#if dados.arquetipo}}{{dados.arquetipo}}{{else}}—{{/if}}{{#if ficha.progressao.temSegundo}} e {{dados.arquetipo2}}{{/if}}</dd></div>
      <div><dt>Classe</dt><dd>{{#if dados.classe}}{{dados.classe}}{{else}}—{{/if}}</dd></div>
      <div><dt>Nível</dt><dd>{{ficha.nivelTotal}}</dd></div>
    </dl>
    {{/if}}
    {{#if novas}}{{> "epm-novas" secao="cabecalho"}}{{/if}}

    <div class="epm-recursos">
      {{#each recursosLista}}
      <div class="epm-recurso" style="--cor: {{this.cor}}" data-recurso="{{this.id}}">
        <div class="epm-recurso-topo">
          <span class="epm-recurso-sigla">{{this.abrev}}</span>
          <span class="epm-recurso-nome">{{this.label}}</span>
          <button type="button" class="epm-temp-caixa{{#if temTemp}} ativa{{/if}}{{#if tempAberto}} aberta{{/if}}" style="--cor-temp: {{this.corTemp}}" data-action="alternarTemp" data-recurso="{{this.id}}" aria-expanded="{{#if tempAberto}}true{{else}}false{{/if}}" title="{{this.tempLabel}}: clique para ajustar" {{#unless @root.editavel}}disabled{{/unless}}>Temp{{#if temTemp}} <strong>{{this.temp}}</strong>{{/if}}</button>
        </div>
        <div class="epm-recurso-valores">
          <button type="button" class="epm-seta" data-action="ajustarRecurso" data-recurso="{{this.id}}" data-delta="-5" title="Diminuir 5" aria-label="Diminuir {{this.label}} em 5" {{#unless @root.editavel}}disabled{{/unless}}><i class="fa-solid fa-angles-left"></i></button>
          <button type="button" class="epm-seta" data-action="ajustarRecurso" data-recurso="{{this.id}}" data-delta="-1" title="Diminuir 1" aria-label="Diminuir {{this.label}} em 1" {{#unless @root.editavel}}disabled{{/unless}}><i class="fa-solid fa-angle-left"></i></button>
          <input class="epm-recurso-atual" type="text" inputmode="numeric" data-recurso-valor="{{this.id}}" value="{{this.value}}"
                 aria-label="{{this.label}} atual" title="Digite o valor, ou +5 / -3 para somar ou tirar" />
          <span class="epm-recurso-barra-sep" aria-hidden="true">/</span>
          {{#if @root.edicao}}
          <input class="epm-recurso-max" type="number" name="{{this.nomeMax}}" value="{{this.maxFonte}}" min="0" aria-label="{{this.label}} máxima" title="{{this.label}} máxima (sem bônus){{#if motivosTexto}}&#10;{{this.motivosTexto}}{{/if}}" />
          {{else}}
          <span class="epm-recurso-max-texto" {{#if motivosTexto}}title="{{this.motivosTexto}}"{{/if}}>{{this.max}}</span>
          {{/if}}
          <button type="button" class="epm-seta" data-action="ajustarRecurso" data-recurso="{{this.id}}" data-delta="1" title="Aumentar 1" aria-label="Aumentar {{this.label}} em 1" {{#unless @root.editavel}}disabled{{/unless}}><i class="fa-solid fa-angle-right"></i></button>
          <button type="button" class="epm-seta" data-action="ajustarRecurso" data-recurso="{{this.id}}" data-delta="5" title="Aumentar 5" aria-label="Aumentar {{this.label}} em 5" {{#unless @root.editavel}}disabled{{/unless}}><i class="fa-solid fa-angles-right"></i></button>
        </div>
        <div class="epm-barra" aria-hidden="true"><span style="width: {{epmPct pct}}"></span></div>
        {{#if temTemp}}<div class="epm-barra epm-barra-temp" aria-hidden="true"><span style="width: {{epmPct tempPct}}; background: {{this.corTemp}}"></span></div>{{/if}}
        {{#if tempAberto}}
        <div class="epm-temp-editor" role="group" aria-label="{{this.tempLabel}}" style="--cor-temp: {{this.corTemp}}">
          <span class="epm-temp-rotulo">Temp.</span>
          <button type="button" class="epm-seta" data-action="ajustarRecurso" data-recurso="{{this.tempId}}" data-delta="-5" title="Diminuir 5" aria-label="Diminuir {{this.tempLabel}} em 5"><i class="fa-solid fa-angles-left"></i></button>
          <button type="button" class="epm-seta" data-action="ajustarRecurso" data-recurso="{{this.tempId}}" data-delta="-1" title="Diminuir 1" aria-label="Diminuir {{this.tempLabel}} em 1"><i class="fa-solid fa-angle-left"></i></button>
          <input type="text" inputmode="numeric" class="epm-temp-input" data-recurso-valor="{{this.tempId}}" value="{{this.temp}}" aria-label="{{this.tempLabel}}" title="Digite o valor, ou +5 / -3. Enter confirma, Esc fecha." />
          <button type="button" class="epm-seta" data-action="ajustarRecurso" data-recurso="{{this.tempId}}" data-delta="1" title="Aumentar 1" aria-label="Aumentar {{this.tempLabel}} em 1"><i class="fa-solid fa-angle-right"></i></button>
          <button type="button" class="epm-seta" data-action="ajustarRecurso" data-recurso="{{this.tempId}}" data-delta="5" title="Aumentar 5" aria-label="Aumentar {{this.tempLabel}} em 5"><i class="fa-solid fa-angles-right"></i></button>
          <button type="button" class="epm-icone-botao epm-temp-fechar" data-action="alternarTemp" data-recurso="{{this.id}}" title="Fechar" aria-label="Fechar"><i class="fa-solid fa-check"></i></button>
        </div>
        {{/if}}
      </div>
      {{/each}}
    </div>
  </div>
</header>
