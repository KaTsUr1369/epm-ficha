<section class="tab epm-aba epm-magias {{cls.magias}}" data-group="primary" data-tab="magias">
  <header class="epm-aba-topo">
    <div class="epm-aba-resumo">
      <span class="epm-contador" title="Pontos de Habilidade disponíveis">{{ficha.pontos.ph}} PH</span>
      <span class="epm-contador" title="DT dos testes de resistência contra as suas magias: {{ficha.cd.formula}}">DT {{ficha.cd.valor}}</span>
      <span class="epm-contador" title="Magias de 1º círculo ou acima. Magias Únicas não contam.">{{magias.conhecidas}} de {{magias.espacosMagias}} magias</span>
      <span class="epm-contador">{{magias.truques}} de {{magias.espacosTruques}} truques</span>
      {{#each magias.limites}}<span class="epm-contador epm-limite{{#if excedido}} excedido{{else if cheio}} cheio{{/if}}" style="--cor: {{this.cor}}" title="Limite de magias {{this.label}}{{#if (epmEq @root.modoLimites "combinados")}} (somado às habilidades){{/if}}">{{this.label}} {{this.usados}}/{{this.limite}}</span>{{/each}}
    </div>
    <div class="epm-aba-acoes">
      <button type="button" class="epm-botao{{#if selecao.magias}} ativo{{/if}}" data-action="selecionarPoderes" data-aba="magias" aria-pressed="{{#if selecao.magias}}true{{else}}false{{/if}}" title="Marcar várias para usar, favoritar, mudar o círculo ou apagar de uma vez"><i class="fa-solid fa-list-check" aria-hidden="true"></i> {{#if selecao.magias}}Sair da seleção{{else}}Selecionar{{/if}}</button>
      {{#if editavel}}<button type="button" class="epm-botao epm-botao-forte" data-action="novoPoder" data-tipo="magia" title="Cria no círculo aberto"><i class="fa-solid fa-plus"></i> Nova magia</button>{{/if}}
    </div>
  </header>
  {{#if temSustentadas}}<div class="epm-sustentadas" aria-label="Sustentadas"><span class="epm-rotulo"><i class="fa-solid fa-hourglass-start" aria-hidden="true"></i> Sustentando</span>{{#each sustentadas}}<span class="epm-tag epm-sustentada">{{this.nome}} · {{this.custoTexto}}{{#if editavel}} <button type="button" class="epm-icone-botao" data-action="encerrarSustentada" data-sustentada="{{this.id}}" title="Encerrar (para de gastar)"><i class="fa-solid fa-xmark"></i></button>{{/if}}</span>{{/each}}</div>{{/if}}
  {{#if selecao.magias}}
  <div class="epm-selecao-barra" role="toolbar" aria-label="Ações nas selecionadas">
    <span class="epm-selecao-qtd"><strong>{{selecao.qtd}}</strong> selecionada{{#unless (epmEq selecao.qtd 1)}}s{{/unless}}</span>
    <button type="button" class="epm-link" data-action="selecaoTudo">Marcar todas desta aba</button>
    <button type="button" class="epm-link" data-action="selecaoLimpar" {{#unless selecao.qtd}}disabled{{/unless}}>Limpar</button>
    <span class="epm-selecao-acoes">
      <button type="button" class="epm-botao" data-action="selecaoAcao" data-op="usar" {{#unless selecao.qtd}}disabled{{/unless}} title="Usa uma por uma (as que têm várias formas perguntam qual)"><i class="fa-solid fa-play" aria-hidden="true"></i> Usar</button>
      <button type="button" class="epm-botao" data-action="selecaoAcao" data-op="favoritar" {{#unless selecao.qtd}}disabled{{/unless}}><i class="fa-solid fa-star" aria-hidden="true"></i> Favoritar</button>
      <button type="button" class="epm-botao" data-action="selecaoAcao" data-op="chat" {{#unless selecao.qtd}}disabled{{/unless}}><i class="fa-solid fa-comment" aria-hidden="true"></i> No chat</button>
      {{#if edicao}}
      <button type="button" class="epm-botao" data-action="selecaoAcao" data-op="raridade" {{#unless selecao.qtd}}disabled{{/unless}}><i class="fa-solid fa-gem" aria-hidden="true"></i> Raridade</button>
      <button type="button" class="epm-botao" data-action="selecaoAcao" data-op="circulo" {{#unless selecao.qtd}}disabled{{/unless}}><i class="fa-solid fa-circle-nodes" aria-hidden="true"></i> Círculo</button>
      <button type="button" class="epm-botao" data-action="selecaoAcao" data-op="duplicar" {{#unless selecao.qtd}}disabled{{/unless}}><i class="fa-solid fa-clone" aria-hidden="true"></i> Duplicar</button>
      <button type="button" class="epm-botao perigo" data-action="selecaoAcao" data-op="apagar" {{#unless selecao.qtd}}disabled{{/unless}}><i class="fa-solid fa-trash" aria-hidden="true"></i> Apagar</button>
      {{/if}}
    </span>
    {{#unless edicao}}<span class="epm-dica">Raridade, mover, duplicar e apagar: no modo edição.</span>{{/unless}}
  </div>
  {{/if}}

  {{#if edicao}}
  <div class="epm-dt-editor">
    <span class="epm-rotulo">DT das magias e habilidades</span>
    <span>10 +</span>
    <label class="epm-mini"><span>atributo</span><select name="flags.epm-ficha.dt.atributo">{{#each dtOpcoes.atributos}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>
    <span>+</span>
    <label class="epm-mini"><span>perícia</span><select name="flags.epm-ficha.dt.pericia">{{#each dtOpcoes.pericias}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.nome}}</option>{{/each}}</select></label>
    <span>= <strong>{{ficha.cd.valor}}</strong></span>
    <span class="epm-dica">{{ficha.cd.formula}}. A perícia entra sem o próprio atributo.</span>
  </div>
  {{/if}}
  <nav class="epm-subnav" aria-label="Círculos de magia">
    {{#each magias.circulos}}
    <button type="button" class="epm-subnav-item {{this.cls}}{{#if trancado}} trancado{{/if}}" data-action="aba" data-group="magias" data-tab="{{this.chave}}" {{#if trancado}}title="Conjurador: libera no nível {{this.conj.liberaEm}}"{{/if}}>{{#if trancado}}<i class="fa-solid fa-lock" aria-hidden="true"></i> {{/if}}{{this.curto}}<span class="epm-subnav-qtd">{{this.total}}</span></button>
    {{/each}}
  </nav>
  {{#each magias.circulos}}
  <section class="tab epm-circulo {{this.cls}}" data-group="magias" data-tab="{{this.chave}}">
    <header class="epm-secao-titulo"><h3>{{this.label}}</h3>{{#if conj}}<span class="epm-contador" title="Custo do Conjurador para este círculo (já vem nas magias novas)">{{this.conj.custo}} PM</span>{{#if trancado}}<span class="epm-contador excedido">Conjurador: libera no nível {{this.conj.liberaEm}}</span>{{/if}}{{/if}}</header>
    {{#if vazia}}<p class="epm-vazio">Nenhuma magia neste círculo.</p>{{/if}}
    <ol class="epm-poderes">{{#each itens}}{{> "epm-poder-linha"}}{{/each}}</ol>
  </section>
  {{/each}}
</section>
