<section class="tab epm-aba epm-npcv-aba {{cls.npc}}" data-group="primary" data-tab="npc" style="--npc-ac: {{npcVisual.cor}}">
{{#if npcFicha}}{{#if isGM}}
  <section class="epm-npcv-painel">
    <h3>Tipo de ficha<span class="tag gm">só o Mestre vê esta aba</span></h3>
    <div class="in">
      <div class="epm-npcv-tipos" role="group" aria-label="Tipo de ficha">
        {{#each npcFicha.tipos}}<button type="button" class="epm-npcv-tipo{{#if sel}} sel{{/if}}" data-action="npcTipo" data-tipo="{{this.id}}" aria-pressed="{{#if sel}}true{{else}}false{{/if}}">{{this.label}}</button>{{/each}}
      </div>
      <p class="epm-npcv-nota">{{npcFicha.resumo}} Cada tipo tem as suas abas; no modo edição as outras abas aparecem no fim da barra.</p>
    </div>
  </section>

  <section class="epm-npcv-painel">
    <h3>Cabeçalho<span class="tag">o que aparece no topo da ficha</span></h3>
    <div class="in">
      <div class="epm-npcv-form">
        <label class="epm-mini largo"><span>linha abaixo do nome</span><input type="text" name="flags.epm-ficha.npc.titulo" value="{{npcVisual.titulo}}" placeholder="{{#if npcFicha.eCriatura}}Predador de túneis vulcânicos que caça pelo tremor do chão{{else}}Guarda do Portão Leste · combatente{{/if}}" /></label>
        <label class="epm-mini"><span>ND</span><input type="number" min="0" step="0.25" name="flags.epm-ficha.npc.nd" value="{{npcFicha.nd}}" /></label>
        <div class="epm-mini"><span>PEv ao derrotar</span><strong class="epm-npcv-num">{{npcFicha.pev}}</strong></div>
        <label class="epm-mini" title="Inimigo acima do comum do mesmo nível. O \"Preencher pelo nível\" soma o bônus; aqui muda só o selo e o custo."><span>raridade</span><select name="flags.epm-ficha.npc.raridade">{{#each npcFicha.raridades}}<option value="{{this.v}}" {{#if sel}}selected{{/if}}>{{this.l}}</option>{{/each}}</select></label>
        <label class="epm-mini" title="Custo no orçamento do encontro (cada jogador vale 1). Vazio = pelo tipo e pela raridade."><span>custo</span><input type="number" min="0" step="0.05" name="flags.epm-ficha.npc.custo" value="{{npcFicha.custo}}" placeholder="{{npcFicha.custoPadrao}}" /></label>
        {{#if npcFicha.eCriatura}}
        <label class="epm-mini"><span>categoria</span><input type="text" name="flags.epm-ficha.npc.categoria" value="{{npcFicha.categoria}}" placeholder="Besta, Morto-vivo, Construto…" /></label>
        <label class="epm-mini"><span>tamanho</span><select name="flags.epm-ficha.npc.tamanho"><option value="">—</option>{{#each npcFicha.tamanhos}}<option value="{{this.v}}" {{#if sel}}selected{{/if}}>{{this.v}}</option>{{/each}}</select></label>
        <label class="epm-mini largo"><span>{{#if npcFicha.eChefe}}região{{else}}habitat{{/if}}</span><input type="text" name="flags.epm-ficha.npc.habitat" value="{{npcFicha.habitat}}" placeholder="Umbra'Draxil (nível 1)" /></label>
        {{#if npcFicha.eChefe}}<label class="epm-mini"><span>covil</span><input type="text" name="flags.epm-ficha.npc.covilNome" value="{{npcFicha.covilNome}}" placeholder="Cripta do Eclipse" /></label>{{/if}}
        {{#unless npcFicha.eElite}}<label class="epm-mini"><span>bando</span><input type="text" name="flags.epm-ficha.npc.bando" value="{{npcFicha.bando}}" placeholder="1d4 + 1" /></label>{{/unless}}
        {{else}}
        {{#if npcFicha.eComum}}<label class="epm-mini"><span>função</span><input type="text" name="flags.epm-ficha.npc.funcao" value="{{npcFicha.funcao}}" placeholder="Guarda" /></label>{{/if}}
        <label class="epm-mini"><span>região</span><input type="text" name="flags.epm-ficha.npc.regiao" value="{{npcFicha.regiao}}" placeholder="Briavoterna (nível 2)" /></label>
        <label class="epm-mini"><span>disposição</span><select name="flags.epm-ficha.npc.disposicao"><option value="">—</option>{{#each npcFicha.disposicoes}}<option value="{{this.v}}" {{#if sel}}selected{{/if}}>{{this.v}}</option>{{/each}}</select></label>
        {{#if npcFicha.eComum}}<label class="epm-mini"><span>grupo</span><input type="text" name="flags.epm-ficha.npc.grupo" value="{{npcFicha.grupo}}" placeholder="Guarda da Cidade" /></label>
        <label class="epm-check"><input type="checkbox" name="flags.epm-ficha.npc.semCombate" {{#if npcFicha.semCombate}}checked{{/if}} /> sem combate (só loja e interpretação)</label>{{/if}}
        {{/if}}
      </div>
      {{#unless npcFicha.eCriatura}}<p class="epm-npcv-nota">Raça, arquétipo e nível vêm da ficha (aba Principal no modo edição). O Tema vem da aba Sobre.</p>{{/unless}}
    </div>
  </section>

  <section class="epm-npcv-painel">
    <h3>Vida</h3>
    <div class="in">
      <div class="epm-npcv-form">
        <label class="epm-mini largo"><span>fórmula da Vida</span><input type="text" name="flags.epm-ficha.npc.vidaFormula" value="{{npcFicha.vidaFormula}}" placeholder="4d8 + 6" /></label>
        <button type="button" class="epm-npcv-btn gm" data-action="npcRolarVida">Rolar Vida</button>
        <button type="button" class="epm-npcv-btn gm" data-action="npcRolarVidaTokens">Rolar nos tokens selecionados</button>
        <button type="button" class="epm-npcv-btn gm" data-action="npcPreencherNivel" title="CA, acerto, CD, Vida e ataques pela tabela de inimigos (níveis 1 a 100), com raridade e poder do grupo">Preencher pelo nível</button>
      </div>
      {{#if npcFicha.referencia}}<p class="epm-npcv-nota">Referência: {{npcFicha.referencia.tipoLabel}} de nível {{npcFicha.referencia.nivel}} · CA {{npcFicha.referencia.ca}} · Acerto +{{npcFicha.referencia.acerto}} · CD {{npcFicha.referencia.cd}} · Vida {{npcFicha.referencia.pv}} · dano por turno ~{{npcFicha.referencia.dano}}{{#if npcFicha.referencia.raridadeLabel}} · {{npcFicha.referencia.raridadeLabel}}{{/if}}{{#if npcFicha.referencia.poderLabel}} · grupo {{npcFicha.referencia.poderLabel}}{{/if}}{{#if npcFicha.referencia.projecao}} · projeção (acima do 50){{/if}}</p>{{/if}}
      <p class="epm-npcv-nota">{{#if npcFicha.eElite}}Monstro Forte e Chefe usam Vida fixa: escreva a máxima no cabeçalho (modo edição).{{else}}Cada token não vinculado pode ter a sua Vida rolada.{{/if}}</p>
    </div>
  </section>

  {{#if npcFicha.eImportante}}<div class="epm-npcv-forcar-edicao">{{> "epm-npc" secao="interpretacao" edicao=true}}</div>{{/if}}
  {{#if npcFicha.eComum}}{{> "epm-npc" secao="loot" edicao=true}}{{/if}}
  {{> "epm-npc" secao="notas" edicao=true}}
{{/if}}{{/if}}
</section>
