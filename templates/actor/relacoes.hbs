<section class="tab epm-aba epm-relacoes {{cls.relacoes}}" data-group="primary" data-tab="relacoes">
  <header class="epm-aba-topo">
    <p class="epm-dica">Conecte um personagem pela lista ou arraste-o da barra lateral para cá: nome e imagem vêm da ficha dele. Conforme a afinidade sobe, partes do background dele são reveladas.</p>
    <div class="epm-aba-acoes">
      {{#if editavel}}<button type="button" class="epm-botao epm-botao-forte" data-action="conectarRelacao"><i class="fa-solid fa-link"></i> Conectar personagem</button>{{/if}}
      {{#if isGM}}<button type="button" class="epm-botao" data-action="relacaoMultipla" title="Mudar a afinidade de vários personagens com alguém de uma vez"><i class="fa-solid fa-people-group"></i> Relação múltipla</button>{{/if}}
      {{#if edicao}}<button type="button" class="epm-botao epm-botao-sutil" data-action="novaRelacao" title="Relação com alguém que não tem ficha"><i class="fa-solid fa-plus"></i> Sem ficha</button>{{/if}}
    </div>
  </header>
  {{#if edicao}}{{#unless isGM}}{{#unless podeAfinidade}}{{#if relacoes.length}}<p class="epm-dica epm-afinidade-nota"><i class="fa-solid fa-lock" aria-hidden="true"></i> Neste mundo a afinidade é definida pelo Mestre.</p>{{/if}}{{/unless}}{{/unless}}{{/if}}
  {{#unless relacoes.length}}<div class="epm-vazio-grande epm-zona-soltar"><p>Nenhuma relação ainda.</p></div>{{/unless}}
  <div class="epm-relacoes-grade">
    {{#each relacoes}}
    <article class="epm-relacao{{#if aberta}} aberta{{/if}}{{#if perdido}} perdida{{/if}}" data-relacao="{{this.id}}">
      <div class="epm-relacao-linha">
        <img class="epm-relacao-img" src="{{this.img}}" alt="" {{#if ligado}}data-action="abrirRelacao" data-uuid="{{this.uuid}}" title="Abrir ficha"{{/if}} />
        <div class="epm-relacao-corpo">
          <div class="epm-relacao-topo-texto">
            {{#if ligado}}
            <span class="epm-relacao-nome">{{this.nome}}</span><i class="fa-solid fa-link epm-ligado" title="Ligado à ficha: nome e imagem se atualizam sozinhos"></i>
            {{else if @root.edicao}}
            <input type="text" class="epm-relacao-nome" name="flags.epm-ficha.relacoes.{{this.id}}.nome" value="{{this.nome}}" placeholder="Nome" aria-label="Nome" />
            {{else}}
            <span class="epm-relacao-nome">{{#if nome}}{{this.nome}}{{else}}Sem nome{{/if}}</span>
            {{/if}}
            {{#if @root.edicao}}
            <i class="{{this.tipoIcone}} epm-vinculo-icone" style="color: {{this.tipoCor}}" aria-hidden="true"></i><select name="flags.epm-ficha.relacoes.{{this.id}}.tipo" aria-label="Tipo de vínculo">{{#each opcoesTipo}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
            <button type="button" class="epm-icone-botao perigo" data-action="excluirRelacao" data-relacao="{{this.id}}" title="Excluir"><i class="fa-solid fa-trash"></i></button>
            {{else}}
            <span class="epm-vinculo" style="--cor-vinculo: {{this.tipoCor}}"><i class="{{this.tipoIcone}}" aria-hidden="true"></i> {{this.tipoLabel}}</span>
            {{/if}}
          </div>
          {{#if perdido}}<p class="epm-aviso">A ficha ligada não foi encontrada (pode ter sido apagada).</p>{{/if}}
          <div class="epm-afinidade" title="Afinidade {{epmSinal afinidade}}">
            <span>Afinidade <strong>{{this.afinidadeLabel}}</strong> ({{epmSinal afinidade}})</span>
            {{#if podeAfinidade}}
            <div class="epm-afinidade-controle">
              <button type="button" class="epm-seta" data-action="ajustarAfinidade" data-relacao="{{this.id}}" data-delta="-1" aria-label="Diminuir afinidade"><i class="fa-solid fa-minus"></i></button>
              <div class="epm-medidor"><span style="width: {{this.afinidadePct}}%"></span></div>
              <button type="button" class="epm-seta" data-action="ajustarAfinidade" data-relacao="{{this.id}}" data-delta="1" aria-label="Aumentar afinidade"><i class="fa-solid fa-plus"></i></button>
            </div>
            {{else}}
            <div class="epm-medidor" {{#if soMestreAqui}}title="Neste mundo a afinidade é definida pelo Mestre"{{/if}}><span style="width: {{this.afinidadePct}}%"></span></div>
            {{/if}}
          </div>
          {{#if @root.novas}}{{> "epm-novas" secao="relacao" rel=this}}{{/if}}
          <div class="epm-060-trilhas" title="Receio e Confiança (0 a 5), separados da afinidade. Confiança 5 libera Pacto; Receio 5 faz obedecer ordens que não arrisquem a vida.">
            <span class="epm-060-trilha"><span>Confiança</span>{{#each trilhaConfianca}}<button type="button" class="epm-pip{{#if ativa}} ativa{{/if}}" data-action="trilhaRelacao" data-relacao="{{../id}}" data-trilha="confianca" data-valor="{{this.valor}}" {{#unless @root.editavel}}disabled{{/unless}} aria-label="Confiança {{this.valor}}"></button>{{/each}}</span>
            <span class="epm-060-trilha receio"><span>Receio</span>{{#each trilhaReceio}}<button type="button" class="epm-pip{{#if ativa}} ativa{{/if}}" data-action="trilhaRelacao" data-relacao="{{../id}}" data-trilha="receio" data-valor="{{this.valor}}" {{#unless @root.editavel}}disabled{{/unless}} aria-label="Receio {{this.valor}}"></button>{{/each}}</span>
            {{#if @root.editavel}}{{#if (epmOr confianca receio)}}<button type="button" class="epm-botao epm-botao-mini epm-botao-sutil" data-action="rolarComRelacao" data-relacao="{{this.id}}" title="Diplomacia e Lábia: +2 por Confiança · Intimidação: +2 por Receio">Rolar com {{this.nome}}</button>{{/if}}{{/if}}
            {{#if @root.isGM}}<button type="button" class="epm-botao epm-botao-mini epm-botao-sutil" data-action="testeTraicao" data-relacao="{{this.id}}" title="d20 + Receio − Confiança; 15 ou mais: trai ou foge">Traição?</button>{{/if}}
          </div>
          {{> "epm-historico"}}
          {{#if @root.edicao}}
          <textarea name="flags.epm-ficha.relacoes.{{this.id}}.notas" rows="2" placeholder="Como se conheceram, o que um deve ao outro…" aria-label="Notas">{{this.notas}}</textarea>
          {{#if @root.podeVerPrivado}}<label class="epm-nota-privada"><span><i class="fa-solid fa-lock" aria-hidden="true"></i> Nota privada (só você e o Mestre)</span><textarea name="flags.epm-ficha.relacoes.{{this.id}}.notaPrivada" rows="2" placeholder="O que você pensa de verdade, segredos, planos…">{{this.notaPrivada}}</textarea></label>{{/if}}
          {{else}}
          {{#if notas}}<p class="epm-texto-livre">{{this.notas}}</p>{{/if}}
          {{#if @root.podeVerPrivado}}{{#if notaPrivada}}<p class="epm-texto-livre epm-nota-privada-texto" title="Só você e o Mestre veem"><i class="fa-solid fa-lock" aria-hidden="true"></i> {{this.notaPrivada}}</p>{{/if}}{{/if}}
          {{/if}}
        </div>
      </div>
      {{#if background}}
      <div class="epm-relacao-bg">
        <button type="button" class="epm-relacao-bg-botao" data-action="abrirBackground" data-relacao="{{this.id}}" aria-expanded="{{#if aberta}}true{{else}}false{{/if}}">
          <i class="fa-solid fa-chevron-{{#if aberta}}down{{else}}right{{/if}}" aria-hidden="true"></i>
          Background de {{this.nome}} <span class="epm-contador">{{this.liberadas}} parte{{#unless (epmEq liberadas 1)}}s{{/unless}} revelada{{#unless (epmEq liberadas 1)}}s{{/unless}}</span>
        </button>
        {{#if aberta}}
        <div class="epm-relacao-partes">
          {{#each background}}
          <section class="epm-parte{{#if revelado}} revelada{{else}} trancada{{/if}}">
            <h5>{{#unless revelado}}<i class="fa-solid fa-lock" aria-hidden="true"></i> {{/unless}}{{this.label}}{{#unless revelado}}<span class="epm-dica"> {{this.nivelTexto}}</span>{{/unless}}</h5>
            {{#if revelado}}
            {{#if conteudo.vazio}}<p class="epm-vazio">Nada escrito ainda.</p>{{/if}}
            {{#if conteudo.campos}}<dl class="epm-campos-texto">{{#each conteudo.campos}}<div><dt>{{this.label}}</dt><dd>{{this.valor}}</dd></div>{{/each}}</dl>{{/if}}
            {{#if conteudo.imagem}}<img class="epm-parte-img" src="{{conteudo.imagem}}" alt="" data-action="verImagem" data-src="{{conteudo.imagem}}" data-titulo="{{../nome}}" />{{/if}}
            {{#if conteudo.local}}<p class="epm-dica">Local: {{conteudo.local}}</p>{{/if}}
            {{#if conteudo.texto}}<p class="epm-texto-livre">{{conteudo.texto}}</p>{{/if}}
            {{#if conteudo.html}}<div class="epm-descricao">{{{conteudo.html}}}</div>{{/if}}
            {{/if}}
          </section>
          {{/each}}
        </div>
        {{/if}}
      </div>
      {{/if}}
    </article>
    {{/each}}
  </div>

  <section class="epm-painel epm-faccoes">
    <header class="epm-painel-titulo">
      <h3>Facções e reputação</h3>
      {{#if editavel}}<button type="button" class="epm-botao epm-botao-sutil" data-action="novaFaccao"><i class="fa-solid fa-plus" aria-hidden="true"></i> Nova facção</button>{{/if}}
    </header>
    {{#unless faccoes.length}}<p class="epm-vazio">Reinos, guildas, ordens, deuses… a reputação vai de −5 (Caçado) a +5 (Herói).</p>{{/unless}}
    <div class="epm-faccoes-grade">
      {{#each faccoes}}
      <article class="epm-faccao" data-faccao="{{this.id}}">
        <figure class="epm-faccao-img{{#unless img}} vazia{{/unless}}" {{#if @root.edicao}}data-action="imagemFaccao" data-faccao="{{this.id}}" title="Escolher brasão"{{/if}}>{{#if img}}<img src="{{this.img}}" alt="" />{{else}}<i class="fa-solid fa-flag" aria-hidden="true"></i>{{/if}}</figure>
        <div class="epm-faccao-corpo">
          <div class="epm-relacao-topo-texto">
            {{#if @root.edicao}}
            <input type="text" class="epm-relacao-nome" name="flags.epm-ficha.faccoes.{{this.id}}.nome" value="{{this.nomeBruto}}" placeholder="Nome da facção" aria-label="Nome" />
            <button type="button" class="epm-icone-botao perigo" data-action="excluirFaccao" data-faccao="{{this.id}}" title="Excluir"><i class="fa-solid fa-trash"></i></button>
            {{else}}
            <span class="epm-relacao-nome">{{this.nome}}</span>
            {{/if}}
          </div>
          <div class="epm-afinidade" title="Reputação {{epmSinal reputacao}}">
            <span>Reputação <strong>{{this.reputacaoLabel}}</strong> ({{epmSinal reputacao}})</span>
            {{#if (epmAnd podeAjustar @root.edicao)}}
            <div class="epm-afinidade-controle">
              <button type="button" class="epm-seta" data-action="ajustarReputacao" data-faccao="{{this.id}}" data-delta="-1" aria-label="Diminuir reputação"><i class="fa-solid fa-minus"></i></button>
              <div class="epm-medidor"><span style="width: {{this.reputacaoPct}}%"></span></div>
              <button type="button" class="epm-seta" data-action="ajustarReputacao" data-faccao="{{this.id}}" data-delta="1" aria-label="Aumentar reputação"><i class="fa-solid fa-plus"></i></button>
            </div>
            {{else}}
            <div class="epm-medidor"><span style="width: {{this.reputacaoPct}}%"></span></div>
            {{/if}}
          </div>
          {{> "epm-historico"}}
          {{#if @root.edicao}}
          <textarea name="flags.epm-ficha.faccoes.{{this.id}}.notas" rows="2" placeholder="O que fez por eles (ou contra eles), contatos, favores…" aria-label="Notas">{{this.notas}}</textarea>
          {{else}}{{#if notas}}<p class="epm-texto-livre">{{this.notas}}</p>{{/if}}{{/if}}
        </div>
      </article>
      {{/each}}
    </div>
  </section>
  {{#if novas}}{{> "epm-novas" secao="relacoes"}}{{/if}}
</section>
