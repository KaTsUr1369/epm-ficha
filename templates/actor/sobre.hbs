<section class="tab epm-aba epm-sobre {{cls.sobre}}" data-group="primary" data-tab="sobre">
  {{#if edicao}}
  <section class="epm-painel epm-voz-painel">
    <header class="epm-painel-titulo"><h3>Bordão e música tema</h3></header>
    <div class="epm-voz-campos">
      <label class="epm-campo largo"><span>Bordão ou frase marcante</span><input type="text" name="flags.epm-ficha.sobre.bordao" value="{{voz.bordao}}" placeholder="“As estrelas não mentem. Eu, às vezes.”" /></label>
      <label class="epm-campo"><span>Música tema (link)</span><input type="url" name="flags.epm-ficha.sobre.musica" value="{{voz.musica}}" placeholder="https://…" /></label>
      <label class="epm-campo"><span>Nome da música (opcional)</span><input type="text" name="flags.epm-ficha.sobre.musicaNome" value="{{voz.musicaNome}}" /></label>
    </div>
    <p class="epm-dica">O bordão aparece embaixo do nome, no topo da ficha. A música vira um botão ♪ ao lado do nome (abre o link em outra aba).</p>
  </section>
  {{else}}
  {{#unless voz.vazia}}
  <section class="epm-voz">
    {{#if bordao}}<blockquote class="epm-voz-bordao">“{{bordao}}”</blockquote>{{/if}}
    {{#if musica}}<button type="button" class="epm-botao" data-action="tocarMusica" data-url="{{musica}}"><i class="fa-solid fa-music" aria-hidden="true"></i> {{#if musicaNome}}{{musicaNome}}{{else}}Música tema{{/if}}</button>{{/if}}
  </section>
  {{/unless}}
  {{/if}}
  <div class="epm-sobre-grade">
    <section class="epm-painel epm-sobre-campos">
      <header class="epm-painel-titulo"><h3>Traços</h3></header>
      {{#if edicao}}
      <div class="epm-campos-grade">
        {{#each camposSobre}}<label class="epm-campo"><span>{{this.label}}</span><input type="text" name="flags.epm-ficha.sobre.{{this.id}}" value="{{this.valor}}" {{#if dica}}placeholder="{{this.dica}}"{{/if}} /></label>{{/each}}
        <label class="epm-campo" title="Fase de vida na raça (geração). Automática: pela idade e pela raça. Escolha à mão quando a idade em anos não diz a fase (ex.: 3 anos e adulto, 900 e criança)."><span>Fase de vida (geração)</span><select name="flags.epm-ficha.faixaIdade">{{#each faixaIdadeOpcoes}}<option value="{{this.id}}" {{#if dica}}title="{{this.dica}}"{{/if}} {{#if selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>
      </div>
      {{else}}
      <dl class="epm-campos-grade epm-campos-texto">
        {{#each camposSobre}}<div><dt>{{this.label}}</dt><dd>{{#if valor}}{{this.valor}}{{else}}—{{/if}}</dd></div>{{/each}}
        {{#if faixaIdadeTexto}}<div title="{{faixaIdadeDica}}"><dt>Fase de vida</dt><dd>{{faixaIdadeTexto}} <i class="fa-solid fa-circle-info" aria-hidden="true"></i></dd></div>{{/if}}
      </dl>
      {{/if}}
    </section>
    <section class="epm-painel epm-imagem-painel epm-aparencia-painel">
      <header class="epm-painel-titulo"><h3>Aparência</h3>{{#if edicao}}{{#if aparencia.imagem}}<button type="button" class="epm-link" data-action="removerImagemSobre" data-campo="imagemAparencia">Remover imagem</button>{{/if}}{{/if}}</header>
      {{#if edicao}}
      <figure class="epm-imagem-slot{{#unless aparencia.imagem}} vazia{{/unless}}" data-action="imagemSobre" data-campo="imagemAparencia" title="Escolher imagem do computador ou dos arquivos">
        {{#if aparencia.imagem}}<img src="{{aparencia.imagem}}" alt="Aparência de {{actor.name}}" />{{else}}<span>Imagem (opcional): clique para escolher</span>{{/if}}
      </figure>
      <span class="epm-rotulo">Descrição (opcional)</span>
      {{{aparencia.editor}}}
      {{else}}
      {{#if aparencia.imagem}}
      <figure class="epm-imagem-slot{{#if aparencia.texto}} com-texto{{/if}}" data-action="verImagem" data-src="{{aparencia.imagem}}" data-titulo="{{actor.name}}" title="Ampliar">
        <img src="{{aparencia.imagem}}" alt="Aparência de {{actor.name}}" />
      </figure>
      {{/if}}
      {{#if aparencia.texto}}<div class="epm-descricao">{{{aparencia.texto}}}</div>{{/if}}
      {{#if aparencia.vazia}}<p class="epm-vazio">Sem aparência definida. No modo edição você pode pôr uma imagem, um texto ou os dois.</p>{{/if}}
      {{/if}}
    </section>
  </div>

  <section class="epm-painel epm-idiomas-painel">
    <header class="epm-painel-titulo">
      <h3>Idiomas</h3>
      {{#if idiomasInfo.polyglot}}<span class="epm-contador epm-polyglot" title="A lista vem do módulo Polyglot e os idiomas marcados aqui valem para ele no chat"><i class="fa-solid fa-language" aria-hidden="true"></i> Polyglot</span>{{/if}}
    </header>
    <ul class="epm-tag-lista">
      {{#each idiomas}}<li class="epm-chip epm-chip-idioma{{#if custom}} custom{{/if}}{{#if basico}} basico{{/if}}" {{#if custom}}title="Idioma escrito à mão (não está na lista{{#if @root.idiomasInfo.polyglot}} do Polyglot{{/if}})"{{/if}}>{{this.label}}{{#if @root.edicao}}<select class="epm-idioma-nivel" name="flags.epm-ficha.idiomasNivel.{{this.slug}}" aria-label="Nível em {{this.label}}">{{#each niveis}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>{{else}}{{#unless (epmEq nivel "fluente")}} <span class="epm-idioma-tag">{{this.nivelLabel}}</span>{{/unless}}{{/if}}{{#if @root.edicao}}<button type="button" data-action="removerIdioma" data-chave="{{this.key}}" data-rotulo="{{this.label}}" aria-label="Remover {{this.label}}"><i class="fa-solid fa-xmark"></i></button>{{/if}}</li>{{/each}}
    </ul>
    {{#unless idiomas.length}}<p class="epm-vazio">Nenhum idioma.</p>{{/unless}}
    {{#if edicao}}
    <div class="epm-idiomas-adicionar">
      <input type="text" class="epm-tag-input" data-idioma-input="1" list="epm-idiomas-{{actor.id}}" placeholder="Escolha da lista ou digite e tecle Enter" aria-label="Adicionar idioma" />
      <datalist id="epm-idiomas-{{actor.id}}">{{#each idiomasInfo.opcoes}}<option value="{{this.label}}"></option>{{/each}}</datalist>
    </div>
    <p class="epm-dica">{{#if idiomasInfo.polyglot}}Os idiomas da lista são os do Polyglot mais os do EPM. Um idioma digitado que não existe nela fica como personalizado.{{else}}A lista é a do EPM. Com o módulo Polyglot ativo, os idiomas dele entram também.{{/if}} Abissal, Carmesim, Primordial, Astral e Titânico não podem ser escolhidos (só o Mestre concede).</p>
    {{/if}}
    <ul class="epm-dica epm-regras-idioma">{{#each idiomasInfo.regras}}<li>{{this}}</li>{{/each}}</ul>
  </section>

  <section class="epm-painel epm-marca-painel">
    <header class="epm-painel-titulo"><h3>Marca</h3>{{#if edicao}}{{#if marca.imagem}}<button type="button" class="epm-link" data-action="removerImagemSobre" data-campo="imagemMarca">Remover imagem</button>{{/if}}{{/if}}</header>
    <div class="epm-marca-grade">
      <figure class="epm-imagem-slot epm-imagem-marca{{#unless marca.imagem}} vazia{{/unless}}" {{#if edicao}}data-action="imagemSobre" data-campo="imagemMarca" title="Imagem da Marca (PNG ou JPEG)"{{else}}{{#if marca.imagem}}data-action="verImagem" data-src="{{marca.imagem}}" data-titulo="Marca" title="Ampliar"{{/if}}{{/if}}>
        {{#if marca.imagem}}<img src="{{marca.imagem}}" alt="Marca de {{actor.name}}" />{{else}}<span>{{#if edicao}}Imagem da Marca (PNG ou JPEG){{else}}Sem imagem{{/if}}</span>{{/if}}
      </figure>
      <div class="epm-marca-textos">
        <p class="epm-dica">A tatuagem sobrenatural que liga você aos seus outros personagens e permite a Ressonância de Alma.</p>
        {{#if editavel}}<button type="button" class="epm-botao epm-ressonancia" data-action="ressonancia" title="Chamar outro personagem seu pela Marca (registra no chat e abre a ficha dele)"><i class="fa-solid fa-link" aria-hidden="true"></i> Ressonância de Alma</button>{{/if}}
        {{#if edicao}}
        <label class="epm-campo"><span>Onde fica</span><input type="text" name="flags.epm-ficha.sobre.marcaLocal" value="{{marca.local}}" placeholder="nuca, palma da mão esquerda…" /></label>
        <label class="epm-campo"><span>Como ela é</span><textarea name="flags.epm-ficha.sobre.marcaAparencia" rows="4">{{marca.aparencia}}</textarea></label>
        {{else}}
        <dl class="epm-campos-texto"><div><dt>Onde fica</dt><dd>{{#if marca.local}}{{marca.local}}{{else}}—{{/if}}</dd></div></dl>
        <p class="epm-texto-livre">{{#if marca.aparencia}}{{marca.aparencia}}{{else}}<span class="epm-vazio">Sem descrição.</span>{{/if}}</p>
        {{/if}}
      </div>
    </div>
  </section>

  {{#if edicao}}
  <section class="epm-painel epm-revelacoes-painel">
    <header class="epm-painel-titulo"><h3>Quem vê seu background</h3></header>
    <p class="epm-dica">Personagens que têm uma relação com você leem estas partes quando a afinidade deles chega ao nível escolhido.</p>
    <div class="epm-revelacoes-grade">
      {{#each revelacoes}}
      <label class="epm-campo"><span>{{this.label}}</span>
        <select name="flags.epm-ficha.sobre.revelar.{{this.id}}">{{#each opcoes}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
      </label>
      {{/each}}
    </div>
  </section>
  {{/if}}

  {{#each textosSobre}}
  {{#if (epmOr @root.edicao texto)}}
  <section class="epm-painel epm-texto-longo">
    <header class="epm-painel-titulo"><h3>{{this.label}}</h3></header>
    {{#if @root.edicao}}{{{this.editor}}}{{else}}{{#if texto}}<div class="epm-descricao">{{{this.texto}}}</div>{{else}}<p class="epm-vazio">Vazio. Escreva no modo edição.</p>{{/if}}{{/if}}
  </section>
  {{/if}}
  {{/each}}

  {{#if podeVerSegredos}}
  <section class="epm-painel epm-texto-longo epm-segredos">
    <header class="epm-painel-titulo"><h3><i class="fa-solid fa-user-secret" aria-hidden="true"></i> Segredos</h3><span class="epm-dica">Só você e o Mestre veem. Nunca aparece nas relações.</span></header>
    {{#if edicao}}{{{segredos.editor}}}{{else}}{{#if segredos.texto}}<div class="epm-descricao">{{{segredos.texto}}}</div>{{else}}<p class="epm-vazio">Nenhum segredo anotado. Escreva no modo edição.</p>{{/if}}{{/if}}
  </section>
  {{/if}}
  {{#if novas}}{{> "epm-novas" secao="sobre"}}{{/if}}
</section>
