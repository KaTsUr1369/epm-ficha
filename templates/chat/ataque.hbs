<div class="epm-chat epm-chat-ataque{{#if critico}} critico{{/if}}" style="--cor: {{this.cor}}" data-actor-uuid="{{this.actorUuid}}">
  <header class="epm-chat-topo">
    {{#if img}}<img src="{{this.img}}" alt="" />{{else}}<i class="fa-solid fa-burst" aria-hidden="true"></i>{{/if}}
    <div class="epm-chat-titulos">
      <h3>{{this.nome}}</h3>
      <span class="epm-chat-sub">{{this.periciaNome}}{{#if modo}}, {{this.modo}}{{/if}}</span>
    </div>
  </header>
  <div class="epm-chat-rolagem"><span class="epm-rotulo">Acerto</span>{{{this.htmlAtaque}}}</div>
  {{#if critico}}<p class="epm-chat-critico">Crítico! Dados da arma ×{{this.mult}}.</p>{{/if}}
  {{#if htmlDano}}<div class="epm-chat-rolagem"><span class="epm-rotulo">Dano{{#if tipoDano}} ({{this.tipoDano}}){{/if}}</span>{{{this.htmlDano}}}</div>{{/if}}
  {{#each notas}}<p class="epm-chat-requisitos">{{this}}</p>{{/each}}
  {{#if botoes.length}}
  <div class="epm-chat-botoes">
    {{#each botoes}}<button type="button" data-epm-action="{{this.acao}}"{{#if formula}} data-formula="{{this.formula}}"{{/if}}{{#if recurso}} data-recurso="{{this.recurso}}"{{/if}}{{#if valor}} data-valor="{{this.valor}}"{{/if}}{{#if alvos}} data-alvos="{{this.alvos}}"{{/if}}{{#if tipoDano}} data-tipo-dano="{{this.tipoDano}}"{{/if}} data-rotulo="{{this.rotulo}}"><i class="{{this.icone}}" aria-hidden="true"></i> {{this.label}}</button>{{/each}}
  </div>
  {{/if}}
</div>
