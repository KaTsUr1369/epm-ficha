<div class="epm-chat" style="--cor: {{this.raridadeCor}}" data-actor-uuid="{{this.actorUuid}}">
  <header class="epm-chat-topo">
    <img src="{{this.img}}" alt="" />
    <div class="epm-chat-titulos">
      <h3>{{this.nome}}</h3>
      <span class="epm-chat-sub">{{this.tipoLabel}} {{this.raridadeLabel}}{{#if circuloLabel}}, {{this.circuloLabel}}{{/if}}</span>
    </div>
  </header>
  {{#if formaNome}}<p class="epm-chat-forma">Forma <strong>{{this.formaNome}}</strong></p>{{/if}}
  {{#if linhas.length}}<dl class="epm-chat-linhas">{{#each linhas}}<dt>{{this.rotulo}}</dt><dd>{{this.valor}}</dd>{{/each}}</dl>{{/if}}
  {{#if requisitos.length}}<p class="epm-chat-requisitos">Requisitos: {{epmJoin requisitos}}</p>{{/if}}
  {{#if texto}}<div class="epm-chat-texto">{{{this.texto}}}</div>{{/if}}
  {{#each avisos}}<p class="epm-chat-aviso">{{this}}</p>{{/each}}
  {{#if botoes.length}}
  <div class="epm-chat-botoes">
    {{#each botoes}}<button type="button" data-epm-action="{{this.acao}}"{{#if formula}} data-formula="{{this.formula}}"{{/if}}{{#if pericia}} data-pericia="{{this.pericia}}"{{/if}}{{#if tipo}} data-tipo="{{this.tipo}}"{{/if}}{{#if recurso}} data-recurso="{{this.recurso}}"{{/if}}{{#if magico}} data-magico="1"{{/if}} data-rotulo="{{this.rotulo}}"><i class="{{this.icone}}" aria-hidden="true"></i> {{this.label}}</button>{{/each}}
  </div>
  {{/if}}
</div>
