<div class="epm-item-editor" style="--cor: {{this.raridadeCor}}">
  <header class="epm-item-editor-topo">
    <img class="epm-item-editor-img" src="{{item.img}}" alt="" {{#if editavel}}data-action="editarImagem" title="Trocar imagem"{{/if}} />
    <div class="epm-item-editor-titulo">
      <input type="text" name="name" value="{{item.name}}" class="epm-item-editor-nome" aria-label="Nome" {{#unless editavel}}disabled{{/unless}} />
      <div class="epm-item-editor-sub">
        {{#if editavel}}<label class="epm-mini" title="Muda o tipo do item (ex.: Loot → Ferramenta)"><span>categoria</span><select data-mudar-categoria aria-label="Categoria do item">{{#each opcoesCategoria}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>{{else}}<span class="epm-tag">{{item.tipoLabel}}</span>{{/if}}
        <label class="epm-mini"><span>raridade</span><select name="flags.epm-ficha.raridade">{{#each opcoesRaridade}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>
        {{#if equipavel}}<label class="epm-check"><input type="checkbox" name="system.equipped" {{#if equipado}}checked{{/if}} /> Equipado</label>{{/if}}
      </div>
    </div>
  </header>

  <section class="epm-painel">
    <header class="epm-painel-titulo"><h3>Detalhes</h3></header>
    <div class="epm-item-editor-campos">
      <label class="epm-campo"><span>Quantidade</span><input type="number" min="0" name="system.quantity" value="{{this.quantidade}}" /></label>
      <label class="epm-campo"><span>Peso (cada)</span><input type="number" min="0" step="any" name="system.weight.value" value="{{this.peso}}" /></label>
      <label class="epm-campo"><span>Preço</span><span class="epm-linha-campos"><input type="number" min="0" step="any" name="flags.epm-ficha.preco.valor" value="{{preco.valor}}" /><select name="flags.epm-ficha.preco.moeda">{{#each preco.moedas}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></span></label>
      {{#if eArmadura}}<label class="epm-campo" title="Soma em Armaduras e escudos, na CA, quando equipado"><span>CA de armadura ou escudo</span><input type="number" name="flags.epm-ficha.armadura" value="{{this.armadura}}" /></label>{{/if}}
      {{#if duravel}}<label class="epm-campo" title="0 a 100. Falha crítica com a arma ou crítico sofrido tiram 10; em 0 fica Quebrado e perde os efeitos até ser consertado"><span>Durabilidade</span><input type="number" min="0" max="100" name="flags.epm-ficha.durabilidade" value="{{durabilidade}}" /></label>{{/if}}
      {{#if duravel}}<label class="epm-campo" title="Itens feitos na Forja ganham +3. Cada ponto segura uma perda inteira de durabilidade (crítico sofrido ou falha crítica)"><span>Pontos de Estrutura</span><input type="number" min="0" name="flags.epm-ficha.pontosEstrutura" value="{{pontosEstrutura}}" /></label>{{/if}}
      {{#if eConsumivel}}<label class="epm-campo largo"><span>Rolagem ao usar</span><input type="text" name="flags.epm-ficha.formula" value="{{this.formulaUso}}" placeholder="2d4 + 2" /></label>{{/if}}
      {{#if eMochila}}<label class="epm-campo"><span>Capacidade (peso)</span><input type="number" min="0" step="any" name="system.capacity.weight.value" value="{{mochila.capacidade}}" /></label>{{/if}}
      {{#unless eMochila}}
      <label class="epm-campo" title="{{cargas.dica}}. 0 de máximo = sem cargas"><span>Cargas (atual / máx.)</span><span class="epm-linha-campos"><input type="number" min="0" name="flags.epm-ficha.cargas.valor" value="{{cargas.valor}}" aria-label="Cargas atuais" /><input type="number" min="0" name="flags.epm-ficha.cargas.max" value="{{cargas.max}}" aria-label="Cargas máximas" /></span></label>
      <label class="epm-campo"><span>Cargas recarregam</span><select name="flags.epm-ficha.cargas.recarga">{{#each cargas.opcoesRecarga}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>
      {{/unless}}
    </div>
  </section>

  {{#if eArma}}
  <section class="epm-painel">
    <header class="epm-painel-titulo"><h3>Ataque</h3></header>
    <div class="epm-item-editor-campos">
      <label class="epm-campo"><span>Perícia de ataque</span><select name="flags.epm-ficha.periciaAtaque">{{#each opcoesPericia}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.nome}}</option>{{/each}}</select></label>
      <label class="epm-campo" title="Decide quais bônus valem: os de corpo a corpo (ex.: Corpo Destruidor, Pele em Chamas, Força acima de 4) ou os de distância (penalidades de ataques à distância). Uma sniper fica À distância mesmo que use outra perícia."><span>Alcance</span><select name="flags.epm-ficha.alcanceCat">{{#each opcoesAlcance}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>
      <label class="epm-campo"><span>Bônus de acerto</span><input type="number" name="flags.epm-ficha.bonusAcerto" value="{{ataque.bonusAcerto}}" /></label>
      <label class="epm-campo"><span>Dano</span><input type="text" name="flags.epm-ficha.dano" value="{{ataque.dano}}" placeholder="2d10" /></label>
      <label class="epm-campo" title="O valor do atributo é somado ao dano em todo ataque com esta arma (e nos modos extras)"><span>Somar atributo no dano</span><select name="flags.epm-ficha.atributoDano">{{#each opcoesAtributoDano}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>
      <label class="epm-campo" title="Arma Favorita do Combatente vale para todas as armas deste tipo"><span>Tipo de arma</span><input type="text" name="flags.epm-ficha.tipoArma" value="{{tipoArma}}" list="epm-item-sug-tipo-arma" placeholder="Espada longa, Pistola…" /><datalist id="epm-item-sug-tipo-arma">{{#each sugestoesTipoArma}}<option value="{{this}}"></option>{{/each}}</datalist></label>
      <label class="epm-campo"><span>Tipo de dano</span><input type="text" name="flags.epm-ficha.tipoDano" value="{{ataque.tipoDano}}" list="epm-item-sug-dano" placeholder="Cortante" /></label>
      <label class="epm-campo" title="Menor resultado no d20 que conta como crítico"><span>Margem de crítico</span><input type="number" min="2" max="20" name="flags.epm-ficha.critMargem" value="{{ataque.critMargem}}" /></label>
      <label class="epm-campo" title="No crítico, os dados da arma são multiplicados por este valor"><span>Multiplicador</span><input type="number" min="2" name="flags.epm-ficha.critMult" value="{{ataque.critMult}}" /></label>
    </div>
    <label class="epm-check" title="Treino Sintonização com Arma (Notion): o que exige ataque desarmado pode ser usado com esta arma. Ela recebe os bônus de ataque desarmado (Porrada Franca, Força acima de 4 desarmado…) no lugar dos de arma."><input type="checkbox" name="flags.epm-ficha.contaDesarmado" {{epmChecked contaDesarmado}} /> Conta como ataque desarmado (Sintonização com Arma)</label>
    {{#if contaDesarmado}}<label class="epm-campo" title="Bônus de arma: dano da Força acima de 4 para armas corpo a corpo. Bônus de desarmado: Porrada Franca, dado desarmado da Força, Posições…"><span>Bônus que a arma recebe</span><select name="flags.epm-ficha.desarmadoBonus">{{#each opcoesDesarmado}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>{{/if}}
    <fieldset class="epm-municao-arma">
      <legend><label class="epm-check"><input type="checkbox" name="flags.epm-ficha.usaMunicao" {{epmChecked municao.usa}} /> Gasta munição</label></legend>
      {{#if municao.usa}}
      <div class="epm-item-editor-campos">
        <label class="epm-campo"><span>Tipo de munição</span><select name="flags.epm-ficha.municaoTipo">{{#each municao.opcoesTipo}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>
        {{#if municao.temDono}}
        <label class="epm-campo" title="Consumível ou loot do inventário: flechas, virotes, balas…"><span>{{#if municao.temPente}}Munição para recarregar{{else}}Munição{{/if}}</span><select name="flags.epm-ficha.municao">{{#each municao.opcoes}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>
        {{else}}
        <p class="epm-dica">A munição é escolhida quando a arma estiver na ficha de alguém.</p>
        {{/if}}
        <label class="epm-campo"><span>{{#if municao.temPente}}Tiros por ataque{{else}}Gasta por ataque{{/if}}</span><input type="number" min="1" name="flags.epm-ficha.municaoPorAtaque" value="{{municao.porAtaque}}" /></label>
        {{#if municao.temPente}}
        <label class="epm-campo" title="Quantos tiros cabem no pente"><span>Tamanho do pente</span><input type="number" min="1" name="flags.epm-ficha.pente.max" value="{{municao.penteMax}}" /></label>
        <div class="epm-campo"><span>No pente agora</span><div class="epm-custo"><input type="number" min="0" name="flags.epm-ficha.pente.atual" value="{{municao.penteAtual}}" />{{#if municao.temDono}}<button type="button" class="epm-botao" data-action="recarregar" title="Enche o pente com a munição escolhida"><i class="fa-solid fa-rotate" aria-hidden="true"></i> Recarregar</button>{{/if}}</div></div>
        <label class="epm-campo" title="Ação gasta ao recarregar esta arma"><span>Recarregar gasta</span><select name="flags.epm-ficha.recargaAcao">{{#each municao.opcoesRecarga}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>
        {{/if}}
      </div>
      <p class="epm-dica">{{#if municao.temPente}}Pente: os tiros saem do pente; quando acaba, Recarregar puxa da munição escolhida e gasta a ação acima.{{else if municao.pacote}}Pacote (mecânica opcional do Notion): o primeiro ataque do combate gasta 1 pacote da munição escolhida; o resto do combate não gasta nada.{{else}}Unitário: cada ataque tira direto do item de munição (ex.: 1 flecha).{{/if}}</p>
      {{/if}}
    </fieldset>
    <div class="epm-modos-arma">
      <div class="epm-modos-topo">
        <h4>Modos de ataque</h4>
        <span class="epm-dica">Para armas com mais de um jeito de atacar (ex.: lança: ponta perfurante, cabo contundente). Cada modo vira uma linha em Combate → Ataques. Perícia, acerto e crítico vazios = iguais aos da arma.</span>
      </div>
      {{#if modosArma.length}}
      <label class="epm-campo epm-modo-principal"><span>Nome do modo principal (acima)</span><input type="text" name="flags.epm-ficha.modoNome" value="{{ataque.modoNome}}" placeholder="{{#if ataque.tipoDano}}{{ataque.tipoDano}}{{else}}Ponta{{/if}}" /></label>
      {{/if}}
      {{#each modosArma}}
      <div class="epm-modo-linha">
        <label class="epm-mini"><span>nome</span><input type="text" name="flags.epm-ficha.modos.{{this.id}}.nome" value="{{this.nome}}" placeholder="Cabo" /></label>
        <label class="epm-mini"><span>dano</span><input type="text" name="flags.epm-ficha.modos.{{this.id}}.dano" value="{{this.dano}}" placeholder="1d4 + @for" /></label>
        <label class="epm-mini"><span>tipo de dano</span><input type="text" name="flags.epm-ficha.modos.{{this.id}}.tipoDano" value="{{this.tipoDano}}" list="epm-item-sug-dano" placeholder="Contundente" /></label>
        <label class="epm-mini"><span>perícia</span><select name="flags.epm-ficha.modos.{{this.id}}.pericia">{{#each opcoesPericia}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.nome}}</option>{{/each}}</select></label>
        <label class="epm-mini curto"><span>acerto</span><input type="number" name="flags.epm-ficha.modos.{{this.id}}.bonusAcerto" value="{{this.bonusTexto}}" placeholder="—" /></label>
        <button type="button" class="epm-icone-botao perigo" data-action="removerModo" data-modo="{{this.id}}" title="Remover modo"><i class="fa-solid fa-trash"></i></button>
      </div>
      {{/each}}
      <button type="button" class="epm-botao epm-botao-sutil" data-action="novoModo"><i class="fa-solid fa-plus" aria-hidden="true"></i> Modo de ataque</button>
    </div>
    <p class="epm-dica">Fórmulas aceitam os atalhos @for, @des, @con, @apa, @car, @int, @aut, @nuc (valor final do atributo), além de @per.luta, @nivel…</p>
  </section>
  {{/if}}

  {{#if formasItem.pode}}
  <section class="epm-painel epm-formas-item">
    <header class="epm-painel-titulo"><h3>Formas</h3><span class="epm-dica">Poderes do item que você escolhe ao usar (ex.: as cabeças de um cajado). Cada forma tem ação, custo, uso por turno/combate, teste e dano, como as formas de habilidade.</span></header>
    {{#if formasItem.tem}}
    <ul class="epm-formas-item-lista">{{#each formasItem.lista}}<li><strong>{{this.nome}}</strong>{{#if meta}} <span class="epm-dica">{{this.meta}}</span>{{/if}}</li>{{/each}}</ul>
    {{else}}<p class="epm-vazio">Sem formas. O item é usado do jeito normal.</p>{{/if}}
    {{#if editavel}}<div class="epm-linha-campos">
      <button type="button" class="epm-botao epm-botao-sutil" data-action="novaFormaItem"><i class="fa-solid fa-plus" aria-hidden="true"></i> Nova forma</button>
      {{#if formasItem.tem}}<button type="button" class="epm-botao epm-botao-sutil" data-action="editarFormasItem"><i class="fa-solid fa-shapes" aria-hidden="true"></i> Editar formas</button>{{/if}}
    </div>{{/if}}
  </section>
  {{/if}}

  {{#if notion060}}
  <section class="epm-painel epm-060-item-notion">
    <header class="epm-painel-titulo"><h3>{{#if notion060.eUso}}Tecnologia{{else}}Notion{{/if}}</h3><span class="epm-dica">{{#if notion060.eUso}}Região, nível e complexidade{{else}}Propriedades, região e tecnologia{{/if}}</span></header>
    <div class="epm-item-editor-campos">
      {{#unless notion060.eUso}}<div class="epm-campo largo epm-props-editor"><span>{{notion060.rotuloPropriedades}}</span>
        <div class="epm-props-chips">{{#each notion060.propriedades}}<span class="epm-chip" title="{{this.texto}}">{{this.nome}}{{#if @root.editavel}}<button type="button" class="epm-icone-botao" data-action="removerPropriedade" data-nome="{{this.nome}}" title="Tirar {{this.nome}}" aria-label="Tirar {{this.nome}}"><i class="fa-solid fa-xmark"></i></button>{{/if}}</span>{{else}}<span class="epm-dica">Nenhuma</span>{{/each}}</div>
        {{#if @root.editavel}}<div class="epm-props-adicionar">
          <select data-nova-propriedade aria-label="Propriedade para adicionar"><option value="">Escolher propriedade…</option>{{#each notion060.opcoesPropriedade}}<option value="{{this.nome}}" title="{{this.dica}}">{{this.label}}</option>{{/each}}</select>
          <input type="text" data-propriedade-livre placeholder="ou escreva outra" aria-label="Outra propriedade" />
          <button type="button" class="epm-botao epm-botao-mini" data-action="adicionarPropriedade"><i class="fa-solid fa-plus"></i> Adicionar</button>
        </div>{{/if}}
      </div>{{/unless}}
      <label class="epm-campo"><span>Região</span><select name="flags.epm-ficha.regiao">{{#each notion060.regioes}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>
      <label class="epm-campo" title="1 Umbra'Draxil, 2 Briavoterna, 3 Genesis (vem da região se ficar 0). Acima do nível do personagem: arma ou item de usar com desvantagem (2 acima: −5); armadura ou escudo com −2/−5 na CA e sem as propriedades especiais. 0 = sem tecnologia."><span>Nível de tecnologia</span><input type="number" min="0" max="3" name="flags.epm-ficha.nivelTec" value="{{notion060.nivelTec}}" /></label>
      {{#unless notion060.eArmadura}}<label class="epm-check" title="2 níveis acima do personagem: antes do primeiro uso, teste de Tecnologia DT 20"><input type="checkbox" name="flags.epm-ficha.complexo" {{epmChecked notion060.complexo}} /> Complexo{{#if notion060.tecEntendido}} <span class="epm-dica">(o dono já entendeu)</span>{{/if}}</label>{{/unless}}
      {{#if notion060.eArmadura}}
      <label class="epm-campo"><span>Tipo de armadura</span><select name="flags.epm-ficha.tipoArmadura">{{#each notion060.tiposArmadura}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>
      <label class="epm-campo" title="Descontada no Novo turno com a armadura equipada (armaduras de Genesis)"><span>Estamina por turno</span><input type="number" min="0" name="flags.epm-ficha.estaminaPorTurno" value="{{notion060.estaminaPorTurno}}" /></label>
      {{else if notion060.eUso}}
      {{/if}}
    </div>
    {{#if notion060.propriedades.length}}<ul class="epm-060-lista">{{#each notion060.propriedades}}<li><strong>{{this.nome}}</strong>{{#if tipo}} <em>({{this.tipo}})</em>{{/if}}{{#if texto}}: {{this.texto}}{{/if}}</li>{{/each}}</ul>{{/if}}
  </section>
  {{/if}}

  {{#if melhoriasItem}}
  <section class="epm-painel epm-melhorias-item">
    <header class="epm-painel-titulo"><h3>Melhorias</h3>
      {{#if melhoriasItem.temTitulos}}{{#each melhoriasItem.titulos}}<span class="epm-tag epm-selo-titulo"><i class="fa-solid fa-award" aria-hidden="true"></i> {{this}}</span>{{/each}}{{/if}}
      <span class="epm-dica">{{#if melhoriasItem.lote}}Modificação e Encantamento valem para o lote; Bênção e Maldição, para 1 unidade.{{else}}Modificações 3, Encantamentos 2 (3 com pergaminho), Maldições 3, Bênçãos 2.{{/if}}</span>
    </header>
    <label class="epm-campo epm-melhorias-nome" title="Nomeação: o nome próprio do item (ex.: A que Partiu o Céu). Os Títulos (regra opcional) só vão para itens com nome."><span>Nome do item (Nomeação)</span><input type="text" name="flags.epm-ficha.titulo" value="{{melhoriasItem.nomeProprio}}" placeholder="A que Partiu o Céu" {{#unless editavel}}disabled{{/unless}} /></label>
    {{#if editavel}}<label class="epm-campo epm-melhorias-categoria" title="Que listas de melhorias o item usa (a automática vem do catálogo ou do tipo do item)"><span>Tipo de item</span><select name="flags.epm-ficha.listaMelhorias">{{#each melhoriasItem.opcoesCategoria}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>{{/if}}
    {{#if melhoriasItem.semMelhorias}}<p class="epm-vazio">Este item não recebe melhorias (matéria-prima).</p>{{else}}
    {{#if melhoriasItem.temFazendo}}{{#with melhoriasItem.fazendo as |fz|}}
    <div class="epm-melhoria-fazendo">
      <p><i class="fa-solid fa-hammer" aria-hidden="true"></i> Fazendo <strong>{{fz.nome}}</strong>{{#if fz.escolha}} ({{fz.escolha}}){{/if}}: etapa {{fz.etapa}} de 3 · DT {{fz.dt}} · {{fz.horasTexto}} · material {{fz.custoEtapaTexto}} por etapa{{#if fz.falhas}} · {{fz.falhas}} falha(s){{/if}}</p>
      <div class="epm-barra"><span style="width: {{fz.pct}}%"></span></div>
      {{#if @root.editavel}}<div class="epm-linha-botoes">
        <button type="button" class="epm-botao epm-botao-forte" data-action="trabalharMelhoria">{{#if fz.prontaParaTeste}}<i class="fa-solid fa-dice-d20"></i> Testar a etapa{{else}}<i class="fa-solid fa-hammer"></i> Trabalhar{{/if}}</button>
        <button type="button" class="epm-botao" data-action="desistirMelhoria"><i class="fa-solid fa-xmark"></i> Desistir</button>
      </div>{{/if}}
    </div>{{/with}}{{/if}}
    {{#each melhoriasItem.tipos}}
    <div class="epm-melhoria-tipo">
      <p class="epm-rotulo"><i class="{{this.icone}}" aria-hidden="true"></i> {{this.plural}} <span class="epm-contador">{{this.usadas}}/{{this.max}}</span>{{#if completo}} <span class="epm-tag">{{this.titulo}}</span>{{/if}}
        {{#if podeAdicionar}} <button type="button" class="epm-icone-botao" data-action="adicionarMelhoria" data-tipo="{{this.tipo}}" title="Adicionar {{this.label}}"><i class="fa-solid fa-plus"></i></button>{{/if}}</p>
      {{#each entradas}}
      <div class="epm-melhoria-entrada{{#unless ativa}} desligada{{/unless}}">
        <div><strong>{{this.nome}}</strong>{{#if origem}} <em class="epm-dica">({{this.origem}})</em>{{/if}}{{#if selada}} <span class="epm-tag">selada</span>{{/if}}
          <br><span class="epm-dica">{{this.texto}}</span>
          {{#unless ativa}}<br><span class="epm-alerta-texto"><i class="fa-solid fa-power-off" aria-hidden="true"></i> Desligada: {{this.motivo}}</span>{{/unless}}
          {{#if feito}}<br><label class="epm-check"><input type="checkbox" data-action="marcarFeitoMelhoria" data-id="{{this.feitoId}}" {{#if feitoMarcado}}checked{{/if}} {{#unless @root.melhoriasItem.gm}}disabled{{/unless}}> Feito: {{this.feito}} (o Mestre marca)</label>{{/if}}
        </div>
        <div class="epm-linha-botoes">
          {{#if eMaterial}}{{#if @root.editavel}}<button type="button" class="epm-icone-botao" data-action="trocarMaterial" data-uid="{{this.uid}}" title="Trocar de material"><i class="fa-solid fa-right-left"></i></button>{{/if}}{{/if}}
          {{#if podeTirar}}<button type="button" class="epm-icone-botao perigo" data-action="removerMelhoria" data-uid="{{this.uid}}" title="Tirar do item"><i class="fa-solid fa-trash"></i></button>{{/if}}
        </div>
      </div>
      {{/each}}
    </div>
    {{/each}}
    {{#if melhoriasItem.pergaminho}}<p class="epm-dica"><i class="fa-solid fa-scroll" aria-hidden="true"></i> Pergaminho de Encantamento imbuído: 3ª vaga de Encantamento.</p>{{else}}{{#if melhoriasItem.podePergaminho}}<p><button type="button" class="epm-botao" data-action="imbuirPergaminho" title="Conhecimentos Mágicos DT 35 para identificar e Arcanismo DT 70 para imbuir; gasta 1 Pergaminho de Encantamento do inventário"><i class="fa-solid fa-scroll"></i> Imbuir Pergaminho de Encantamento</button></p>{{/if}}{{/if}}
    {{#if melhoriasItem.efeitosTexto}}<p class="epm-dica"><i class="fa-solid fa-gears" aria-hidden="true"></i> Automático: {{melhoriasItem.efeitosTexto}}</p>{{/if}}
    {{/if}}
  </section>
  {{/if}}

  <section class="epm-painel">
    <header class="epm-painel-titulo"><h3>Bônus e efeitos</h3><span class="epm-dica">{{this.dicaAtivo}}</span></header>
    <div class="epm-efeitos-editor">
      {{#unless temEfeitos}}<p class="epm-vazio">Nenhum. Adicione CA, RD, resistência, desvantagem, cura, dano extra…</p>{{/unless}}
      {{#each efeitos}}
      <div class="epm-efeito-item" data-efeito="{{this.id}}">
        <span class="epm-efeito-tipo">{{this.tipoLabel}}</span>
        {{#if eMod}}
        <select name="flags.epm-ficha.efeitos.{{this.id}}.alvo" aria-label="O que muda">
          <option value="">Escolha o que muda…</option>
          {{#each grupos}}<optgroup label="{{this.grupo}}">{{#each opcoes}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</optgroup>{{/each}}
        </select>
        <input type="number" step="any" name="flags.epm-ficha.efeitos.{{this.id}}.valor" value="{{this.valor}}" aria-label="Valor" />
        {{/if}}
        {{#if eRd}}
        <input type="number" min="0" name="flags.epm-ficha.efeitos.{{this.id}}.valor" value="{{this.valor}}" aria-label="Quanto reduz" />
        <input type="text" name="flags.epm-ficha.efeitos.{{this.id}}.tipoDano" value="{{this.tipoDano}}" placeholder="tipos (vazio = todos)" list="epm-item-sug-dano" aria-label="Tipos de dano" />
        {{/if}}
        {{#if eTipoDano}}{{#unless eFormula}}
        <input type="text" name="flags.epm-ficha.efeitos.{{this.id}}.tipoDano" value="{{this.tipoDano}}" placeholder="tipo de dano ou condição" list="epm-item-sug-dano" aria-label="Tipo" />
        {{/unless}}{{/if}}
        {{#if eEm}}
        <select name="flags.epm-ficha.efeitos.{{this.id}}.em" aria-label="Em quê"><option value="">Em quê…</option>{{#each opcoesEm}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
        {{/if}}
        {{#if eCura}}
        <select name="flags.epm-ficha.efeitos.{{this.id}}.recurso" aria-label="Recurso">{{#each opcoesRecurso}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
        <select name="flags.epm-ficha.efeitos.{{this.id}}.quando" aria-label="Quando">{{#each opcoesQuando}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
        {{/if}}
        {{#if eFormula}}
        <input type="text" name="flags.epm-ficha.efeitos.{{this.id}}.formula" value="{{this.formula}}" placeholder="1d6 + 2" aria-label="Fórmula" />
        {{#if eTipoDano}}<input type="text" name="flags.epm-ficha.efeitos.{{this.id}}.tipoDano" value="{{this.tipoDano}}" placeholder="tipo (Fogo…)" list="epm-item-sug-dano" aria-label="Tipo de dano" />{{/if}}
        {{/if}}
        <button type="button" class="epm-icone-botao perigo" data-action="removerEfeito" data-efeito="{{this.id}}" title="Remover"><i class="fa-solid fa-xmark"></i></button>
      </div>
      {{/each}}
      {{#if editavel}}
      <div class="epm-efeito-novo">
        <select class="epm-efeito-novo-tipo" aria-label="Tipo de bônus" data-novo-efeito="1">{{#each tiposEfeitoItem}}<option value="{{this.id}}" title="{{this.dica}}">{{this.label}}</option>{{/each}}</select>
        <button type="button" class="epm-link" data-action="adicionarEfeito"><i class="fa-solid fa-plus" aria-hidden="true"></i> Adicionar</button>
      </div>
      {{/if}}
    </div>
    <datalist id="epm-item-sug-dano">{{#each sugestoesDano}}<option value="{{this}}"></option>{{/each}}</datalist>
  </section>

  {{#if eMochila}}
  {{#if mochila.temMembros}}
  <section class="epm-painel epm-mochila-membros">
    <header class="epm-painel-titulo"><h3>Compartilhar</h3><span class="epm-dica">Os personagens marcados veem o que está nesta mochila e podem pegar e guardar itens. O peso continua com quem carrega.</span></header>
    <div class="epm-membros">{{#each mochila.membros}}<span class="epm-chip-membro"><img src="{{this.img}}" alt="" width="20" height="20" /> {{this.nome}}{{#if @root.editavel}} <button type="button" class="epm-icone-botao" data-action="alternarMembroMochila" data-ator-id="{{this.id}}" title="Parar de compartilhar com {{this.nome}}" aria-label="Tirar {{this.nome}}"><i class="fa-solid fa-xmark"></i></button>{{/if}}</span>{{else}}<span class="epm-vazio">Ainda não compartilhada.</span>{{/each}}
    {{#if @root.editavel}}<button type="button" class="epm-botao" data-action="escolherMembrosMochila"><i class="fa-solid fa-user-plus" aria-hidden="true"></i> Escolher personagens</button>{{/if}}</div>
  </section>
  {{/if}}
  <section class="epm-painel">
    <header class="epm-painel-titulo"><h3>Moedas na mochila</h3><span class="epm-contador">{{mochila.totalTexto}}</span></header>
    <div class="epm-mochila-moedas-editor">
      {{#each mochila.moedas}}
      <label class="epm-moeda-campo" title="{{this.label}}">
        <img src="{{this.img}}" alt="" />
        <input type="number" min="0" name="flags.epm-ficha.moedas.{{this.id}}" value="{{this.qtd}}" aria-label="{{this.label}}" />
        <span>{{this.abrev}}{{#if @root.mochila.temDono}} · carteira {{this.naCarteira}}{{/if}}</span>
      </label>
      {{/each}}
    </div>
    {{#if mochila.temDono}}{{#if editavel}}
    <div class="epm-chips">
      <button type="button" class="epm-botao" data-action="guardarMoedas"><i class="fa-solid fa-arrow-down" aria-hidden="true"></i> Guardar da carteira</button>
      <button type="button" class="epm-botao" data-action="pegarMoedas"><i class="fa-solid fa-arrow-up" aria-hidden="true"></i> Pegar para a carteira</button>
    </div>
    {{/if}}{{/if}}
  </section>

  <section class="epm-painel">
    <header class="epm-painel-titulo"><h3>Conteúdo</h3><span class="epm-contador">peso {{epmNumero mochila.pesoDentro}}{{#if mochila.capacidade}} de {{epmNumero mochila.capacidade}}{{/if}}</span></header>
    {{#if mochila.vazia}}<p class="epm-vazio">Vazia. Na ficha, arraste itens do inventário para a mochila.</p>{{/if}}
    <ol class="epm-mochila-lista">
      {{#each mochila.conteudo}}
      <li>
        <img src="{{this.img}}" alt="" /><button type="button" class="epm-link" data-action="abrirItem" data-item-id="{{this.id}}">{{this.name}}</button>
        <span class="epm-dica">×{{this.qtd}} · peso {{epmNumero peso}}</span>
        {{#if @root.editavel}}<button type="button" class="epm-icone-botao" data-action="tirarItem" data-item-id="{{this.id}}" title="Tirar da mochila"><i class="fa-solid fa-arrow-up-from-bracket"></i></button>{{/if}}
      </li>
      {{/each}}
    </ol>
  </section>
  {{/if}}

  <section class="epm-painel">
    <header class="epm-painel-titulo"><h3>Descrição</h3></header>
    {{{this.descricao}}}
  </section>
</div>
