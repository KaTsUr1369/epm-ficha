<section class="epm-painel epm-arq-painel" style="--cor: {{this.cor}}" data-arquetipo="{{this.id}}">
  <header class="epm-painel-titulo">
    <h3><i class="{{this.icone}}" aria-hidden="true"></i> {{this.nome}} <span class="epm-contador">Nv. {{this.nivel}}</span></h3>
    {{#if podeAdicionarTodas}}<button type="button" class="epm-botao epm-botao-sutil" data-action="adicionarHabilidadeArq" data-ref="{{this.id}}" title="Cria na ficha as habilidades de {{this.nome}} já liberadas que ainda faltam">Adicionar as liberadas ({{this.faltamAdicionar}})</button>{{/if}}
  </header>
  <p class="epm-dica">{{this.funcao}} <em>Arquétipo modelo 0.5.</em></p>
  <ol class="epm-arq-trilha" aria-label="Progressão do nível 1 ao 50">
    {{#each niveis}}<li class="{{#if alcancado}}alcancado{{/if}}{{#if atual}} atual{{/if}}{{#if marco}} marco{{/if}}" title="Nv. {{this.n}}: {{this.texto}}">{{this.n}}</li>{{/each}}
  </ol>
  {{#if proximo}}<p class="epm-arq-proximo"><i class="fa-solid fa-flag" aria-hidden="true"></i> Próximo: <strong>Nv. {{proximo.nivel}} · {{proximo.nome}}</strong>. {{proximo.resumo}}</p>{{/if}}

  {{#if combatente}}
  <div class="epm-arq-bloco">
    <h4>Arsenal de Maestrias <span class="epm-contador">{{combatente.escolhidas.length}}/{{combatente.maxMaestrias}} · etapa {{combatente.etapa}} de 5</span></h4>
    {{#if @root.edicao}}
    <div class="epm-dialogo-linha">
      <label class="epm-campo" title="Todas as Maestrias valem com armas deste tipo (o tipo é escrito no editor de cada arma)"><span>Arma Favorita (tipo de arma)</span><input type="text" name="flags.epm-ficha.arquetipoOpcoes.combatente.tipoFavorito" value="{{combatente.tipoFavorito}}" list="epm-sug-tipo-fav" placeholder="Espada longa, Pistola…" /><datalist id="epm-sug-tipo-fav">{{#each combatente.sugestoesTipo}}<option value="{{this}}"></option>{{/each}}</datalist></label>
    </div>
    <div class="epm-chips" aria-label="Maestrias">{{#each combatente.maestrias}}<button type="button" class="epm-chip-botao{{#if escolhida}} ativo{{/if}}" data-action="alternarMaestria" data-maestria="{{this.id}}" title="{{this.texto}}" {{#unless podeMarcar}}disabled{{/unless}} aria-pressed="{{#if escolhida}}true{{else}}false{{/if}}">{{this.nome}}</button>{{/each}}</div>
    {{/if}}
    {{#each combatente.escolhidas}}
    <p class="epm-arq-destaque"><strong>{{this.nome}}</strong>{{#if this.tipo}} com {{this.tipo}}{{else if ../combatente.tipoFavorito}} com {{../combatente.tipoFavorito}}{{/if}}: {{this.resumo}}</p>
    {{#if ../combatente.variasArmas}}{{#if @root.edicao}}<label class="epm-campo epm-campo-mini" title="Regra opcional do Mestre: esta Maestria vale com outra arma favorita"><span>Arma desta Maestria</span><input type="text" name="flags.epm-ficha.arquetipoOpcoes.combatente.maestriaTipos.{{this.id}}" value="{{this.tipo}}" list="epm-sug-tipo-fav" placeholder="igual à Arma Favorita" /></label>{{/if}}{{/if}}
    {{else}}
    <p class="epm-vazio">Escolha a Arma Favorita e {{combatente.maxMaestrias}} Maestria{{#unless (epmEq combatente.maxMaestrias 1)}}s{{/unless}}{{#unless @root.edicao}} no modo edição{{/unless}}. Elas entram no diálogo de ataque, no cartão e na CA.</p>
    {{/each}}
    {{#if combatente.tipoFavorito}}<p class="epm-dica">{{#if combatente.armasDoTipo.length}}Valem: {{#each combatente.armasDoTipo}}{{this.nome}}{{#unless equipada}} (não equipada){{/unless}}{{#unless @last}}, {{/unless}}{{/each}}.{{else}}Nenhuma arma do inventário é do tipo "{{combatente.tipoFavorito}}". Escreva o tipo no editor da arma.{{/if}} Sacar ou guardar a Arma Favorita é ação livre. Retreino: troque 1 Maestria ou a Arma Favorita a cada Descanso Longo.</p>{{/if}}
    {{#if combatente.proximaMaestria}}<p class="epm-dica">Próxima Maestria no nível {{combatente.proximaMaestria}}.</p>{{/if}}
    <h4>Ataque Extra</h4>
    <p>{{#if combatente.ataqueExtra}}{{combatente.ataqueExtra}}. Aparece no diálogo de ataque.{{else}}Libera no nível 4.{{/if}}{{#if combatente.proximoAtaqueExtra}} <span class="epm-dica">Próximo: {{combatente.proximoAtaqueExtra}}.</span>{{/if}}</p>
    {{#if combatente.estilosPermitidos}}
    <h4>Estilo de Combate <span class="epm-contador">{{combatente.estilosPermitidos}} no seu nível</span></h4>
    <div class="epm-chips">{{#each combatente.estilos}}<button type="button" class="epm-chip-botao{{#if escolhido}} ativo{{/if}}" data-action="alternarEstilo" data-estilo="{{this.id}}" title="{{this.texto}}" {{#unless podeMarcar}}disabled{{/unless}} aria-pressed="{{#if escolhido}}true{{else}}false{{/if}}">{{this.nome}}</button>{{/each}}</div>
    {{#if combatente.estilosTexto}}<p class="epm-dica">Duelista, Atirador e Arma Dupla já valem no diálogo de ataque (Arma Dupla soma Acerto e Esquiva com duas armas equipadas).</p>{{/if}}
    {{/if}}
    {{#if combatente.folego}}<h4>Fôlego de Combate</h4><p>Ação Bônus: recupera {{combatente.folego.dado}} PV, {{combatente.folego.usos}}× por cena (usados nesta cena: {{combatente.folego.usados}}). Botão na aba Combate.</p>{{/if}}
    {{#if combatente.cacador}}<h4>Caçador Natural</h4><p>{{#if combatente.cacador.presa}}Presa: <strong>{{combatente.cacador.presa}}</strong> (até o fim do combate).{{else}}{{combatente.cacador.custo}} PE para marcar uma Presa. Botão na aba Combate.{{/if}}</p>{{/if}}
  </div>
  {{/if}}

  {{#if conjurador}}
  <div class="epm-arq-bloco">
    <h4>Custo das magias e círculos</h4>
    <div class="epm-arq-custos">{{#each conjurador.custos}}<span class="epm-arq-custo{{#unless liberado}} trancado{{/unless}}" title="{{#if liberado}}Liberado{{else}}Libera no nível {{this.liberaEm}}{{/if}}">{{#unless liberado}}<i class="fa-solid fa-lock" aria-hidden="true"></i> {{/unless}}<strong>{{this.label}}</strong> {{this.pm}} PM</span>{{/each}}</div>
    <p class="epm-dica">Magias novas já vêm com o custo do círculo. Círculos ainda trancados aparecem com cadeado na aba Magias.</p>
    {{#with conjurador.acumulo}}
    <h4>Acúmulo de Magias</h4>
    <p><span class="epm-contador{{#if excedeu}} excedido{{/if}}">Magias {{temMagias}} de {{magias}}</span> <span class="epm-contador{{#if excedeu}} excedido{{/if}}">Truques {{temTruques}} de {{truques}}</span>
      {{#if faltamMagias}}<span class="epm-tag epm-tag-alerta">Escolha {{faltamMagias}} magia{{#unless (epmEq faltamMagias 1)}}s{{/unless}}</span>{{/if}}{{#if faltamTruques}} <span class="epm-tag epm-tag-alerta">Escolha {{faltamTruques}} Truque{{#unless (epmEq faltamTruques 1)}}s{{/unless}}</span>{{/if}}</p>
    <p class="epm-dica">+1 magia gratuita por nível, de qualquer círculo liberado; +1 Truque nos níveis 10, 20, 30, 40 e 50. Magias com origem Classe, Pergaminho, Treinamento ou Raça somam por fora. Troque 1 magia a cada Descanso Longo.</p>
    {{/with}}
    {{#if conjurador.assinatura}}
    <h4>Magia Assinatura <span class="epm-contador">{{conjurador.assinatura.qtd}}, até {{conjurador.assinatura.circuloMax}}º círculo</span></h4>
    {{#if @root.edicao}}<div class="epm-chips">{{#each conjurador.assinatura.opcoes}}<button type="button" class="epm-chip-botao{{#if escolhida}} ativo{{/if}}" data-action="alternarAssinatura" data-magia="{{this.id}}" {{#unless podeMarcar}}disabled{{/unless}} aria-pressed="{{#if escolhida}}true{{else}}false{{/if}}">{{this.nome}}</button>{{else}}<span class="epm-vazio">Nenhuma magia de até {{conjurador.assinatura.circuloMax}}º círculo na ficha.</span>{{/each}}</div>
    {{else}}<p>{{#if conjurador.assinatura.escolhidas}}{{conjurador.assinatura.escolhidas}}: metade dos PM (já descontado ao conjurar) e sempre sem movimentos.{{else}}<span class="epm-vazio">Escolha no modo edição.</span>{{/if}}</p>{{/if}}
    {{/if}}
    {{#if conjurador.elemental}}<label class="epm-campo" title="Suas magias desse tipo ganham +1 dado de dano e ignoram Resistência a ele"><span>Maestria Elemental (tipo de dano)</span>{{#if @root.edicao}}<input type="text" name="flags.epm-ficha.arquetipoOpcoes.conjurador.elemento" value="{{conjurador.elemental.tipo}}" placeholder="Fogo, Gelo, Arcano…" />{{else}}<span>{{#if conjurador.elemental.tipo}}{{conjurador.elemental.tipo}}{{else}}—{{/if}}</span>{{/if}}</label>{{/if}}
    {{#if conjurador.reserva}}<p><strong>Reserva Arcana:</strong> +{{conjurador.reserva}} PM máximo (já somado).{{#if conjurador.proximaReserva}} <span class="epm-dica">Próximo: {{conjurador.proximaReserva}}.</span>{{/if}}</p>{{/if}}
    {{#if conjurador.recuperar}}<p><button type="button" class="epm-botao" data-action="recuperarMana" {{#unless conjurador.recuperar.pode}}disabled{{/unless}}><i class="fa-solid fa-droplet" aria-hidden="true"></i> Recuperar Mana: {{conjurador.recuperar.pe}} PE → {{conjurador.recuperar.pm}} PM</button>{{#if conjurador.recuperar.usado}} <span class="epm-dica">Já usado nesta cena.</span>{{/if}}</p>{{/if}}
    {{#if conjurador.manipulacao}}<p><strong>Manipulação Mágica:</strong> {{conjurador.manipulacao.custo}}; exclui até {{conjurador.manipulacao.exclui}} criaturas da área. O botão aparece no cartão da magia, no chat.</p>{{/if}}
    {{#if conjurador.sobrecarga}}<p><strong>Sobrecarga Mágica:</strong> 12 PE por +1 dado ou 22 PE por +2 dados; acumula com a Canalização. Botão no cartão da magia.</p>{{/if}}
    {{#if conjurador.dominio}}
    <label class="epm-campo"><span>Domínio de Conjuração</span>{{#if @root.edicao}}<select name="flags.epm-ficha.arquetipoOpcoes.conjurador.dominio"><option value="">Escolha…</option>{{#each conjurador.dominio}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>{{else}}<span>{{#if conjurador.dominioTexto}}{{conjurador.dominioTexto}}{{else}}—{{/if}}</span>{{/if}}</label>
    {{/if}}
  </div>
  {{/if}}

  {{#if artifice}}
  <div class="epm-arq-bloco epm-artifice">
    <h4>Projetos de Criação <span class="epm-contador">{{artifice.reserva.disponivel}} em aberto de {{artifice.reserva.max}}</span> <span class="epm-contador">Grau máx. {{artifice.grauMax}}</span> <span class="epm-contador" title="{{artifice.cdDica}}">CD de Projeto {{artifice.cd}}</span></h4>
    <label class="epm-campo epm-campo-linha" title="A CD usa metade do bônus desta perícia (sem o atributo); os ataques de Projeto usam o total dela"><span>Perícia do Projeto</span>{{#if @root.editavel}}<select name="flags.epm-ficha.arquetipoOpcoes.artifice.periciaProjeto">{{#each artifice.periciasProjeto}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.nome}}</option>{{/each}}</select>{{else}}<strong>{{artifice.periciaNome}}</strong>{{/if}}</label>
    <div class="epm-reserva-projetos" aria-label="Reserva: ocupados por Engenhocas, gastos e em aberto">{{#each artifice.reserva.pips}}<span class="epm-pip-projeto {{this}}" title="{{#if (epmEq this "ocupado")}}Ocupado por Engenhoca{{else if (epmEq this "gasto")}}Gasto (volta no descanso){{else}}Em aberto{{/if}}"></span>{{/each}}</div>
    <p class="epm-dica">Reserva = {{artifice.reserva.formula}}. Volta no Descanso Longo (menos o que as Engenhocas ocupam); ¼ no Descanso Curto. Consumíveis carregados: {{artifice.carregados}} de {{artifice.carregar}}.{{#if artifice.proximo}} Próximo Grau no nível {{artifice.proximo}}.{{/if}}</p>
    {{#with artifice.valores}}<div class="epm-arq-projetos"><span><strong>Dano</strong> {{dano}}</span><span><strong>Cura</strong> {{cura}}</span><span><strong>Soma</strong> +{{soma}}</span><span><strong>Proteção</strong> +{{protecao}}</span><span><strong>Aprimoramento</strong> {{aprimoramento}}</span><span><strong>Engenhoca</strong> {{cenas}} cenas, ocupa {{ocupa}}</span></div>{{/with}}

    <h4>Livro de Projetos <span class="epm-contador">{{artifice.livroUsado}}/{{artifice.livroMax}}</span>{{#if @root.editavel}} <button type="button" class="epm-link" data-action="novaReceitaArtifice"><i class="fa-solid fa-plus" aria-hidden="true"></i> Receita</button>{{/if}}</h4>
    <ul class="epm-livro-projetos">
      {{#each artifice.livro}}
      <li><span class="epm-tag">{{this.categoria}}</span> <strong>{{this.nome}}</strong> <em>[{{this.tipo}}]</em>{{#if temporaria}} <span class="epm-tag">temporária</span>{{/if}}
        <span class="epm-dica">{{this.uso}} · {{this.valor}}</span>
        {{#if @root.editavel}}<button type="button" class="epm-botao" data-action="fabricarProjeto" data-receita="{{this.chave}}" title="{{this.efeito}}">Fabricar</button>
        <button type="button" class="epm-link" data-action="esquecerReceita" data-receita="{{this.chave}}" title="Tirar do Livro"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>{{/if}}</li>
      {{else}}<li class="epm-vazio">Livro vazio. Ponha receitas com "+ Receita" ou arraste do compêndio "Receitas do Artífice".</li>{{/each}}
    </ul>

    {{#if artifice.engenhocas.length}}
    <h4>Engenhocas</h4>
    <ul class="epm-livro-projetos">
      {{#each artifice.engenhocas}}
      <li class="{{#if quebrada}}quebrada{{/if}}"><strong>{{this.nome}}</strong> <span class="epm-cenas" title="Durabilidade em cenas">{{#each pips}}<span class="epm-pip-cena{{#if this}} cheio{{/if}}"></span>{{/each}}</span> <span class="epm-dica">{{this.cenas}}/{{this.cenasMax}} cenas · ocupa {{this.ocupa}}{{#if portador}} · portador {{portador}}{{/if}}{{#if quebrada}} · Quebrada{{/if}}</span>
        {{#if @root.editavel}}<button type="button" class="epm-botao" data-action="usarProjeto" data-item-id="{{this.id}}" {{#if quebrada}}disabled{{/if}}>Usar</button>
        {{#if ../artifice.sobrecarga}}{{#unless ../artifice.mente}}<button type="button" class="epm-botao" data-action="sobrecargaProjeto" data-item-id="{{this.id}}" {{#if quebrada}}disabled{{/if}} title="Funciona 1 Grau acima neste uso e perde 1 cena">Sobrecarga</button>{{/unless}}{{/if}}
        <button type="button" class="epm-link" data-action="repararEngenhoca" data-item-id="{{this.id}}" title="Reparo Rápido: Ação Bônus e 5 PE, +1 cena (1× por cena)"><i class="fa-solid fa-wrench" aria-hidden="true"></i></button>
        <button type="button" class="epm-link" data-action="enviarProjeto" data-item-id="{{this.id}}" title="Enviar ou instalar em outra ficha (Afiação na arma de um aliado, Placas na armadura, Torreta, Escudo…)"><i class="fa-solid fa-share-from-square" aria-hidden="true"></i></button>
        <button type="button" class="epm-link" data-action="desmontarEngenhoca" data-item-id="{{this.id}}" title="Desmontar (ação livre): os Projetos voltam"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>{{/if}}</li>
      {{/each}}
    </ul>
    {{/if}}
    {{#if artifice.enviados.length}}
    <h4>Em outras fichas</h4>
    <ul class="epm-livro-projetos">
      {{#each artifice.enviados}}
      <li><strong>{{this.nome}}</strong> <span class="epm-dica">{{#if alvoItemNome}}instalada em {{this.alvoItemNome}} de {{else}}com {{/if}}{{this.alvoNome}} · ocupa {{this.ocupa}}</span>
        {{#if @root.editavel}}<button type="button" class="epm-link" data-action="recolherProjeto" data-enviado="{{this.id}}" title="Recolher: volta para o seu inventário (com as cenas que sobraram)"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i> Recolher</button>{{/if}}</li>
      {{/each}}
    </ul>
    {{/if}}
    {{#if artifice.mente}}<p class="epm-dica">Mente Inventora: as Engenhocas funcionam sempre 1 Grau acima, sem perder cenas.</p>{{/if}}
    {{#if artifice.consumiveis.length}}
    <h4>Consumíveis</h4>
    <ul class="epm-livro-projetos">{{#each artifice.consumiveis}}<li><strong>{{this.nome}}</strong>{{#if (epmMenor 1 this.qtd)}} ×{{this.qtd}}{{/if}} {{#if @root.editavel}}<button type="button" class="epm-botao" data-action="usarProjeto" data-item-id="{{this.id}}">Usar</button>{{/if}}</li>{{/each}}</ul>
    {{/if}}
    {{#if artifice.montagem}}<p class="epm-dica">Montagem em Campo: {{artifice.montagem}} (botões na aba Combate). Reparo Rápido: Ação Bônus e 5 PE.{{#if artifice.sobrecarga}} Sobrecarga: 1 Grau acima, perde 1 cena.{{/if}}</p>{{/if}}
    {{#if artifice.encantados}}<p><strong>Itens Encantados:</strong> dano {{artifice.encantados.dano}} (1×/turno), cura {{artifice.encantados.cura}}, Auxílio {{artifice.encantados.auxilio}} (já somados no "Usar").</p>{{/if}}
    {{#if artifice.utensilios}}
    <h4>Utensílios <span class="epm-contador">4 PE por +{{artifice.utensilios.dado}}</span></h4>
    {{#if @root.edicao}}
    <div class="epm-chips">{{#each artifice.utensilios.opcoes}}<button type="button" class="epm-chip-botao{{#if escolhida}} ativo{{/if}}" data-action="alternarUtensilio" data-pericia="{{this.id}}" {{#unless podeMarcar}}disabled{{/unless}} aria-pressed="{{#if escolhida}}true{{else}}false{{/if}}">{{this.nome}}</button>{{/each}}</div>
    {{else}}
    <p>{{#if artifice.utensilios.escolhidasTexto}}{{artifice.utensilios.escolhidasTexto}}: botão "Utensílios" na aba Combate.{{else}}<span class="epm-vazio">Escolha as 3 perícias no modo edição.</span>{{/if}}</p>
    {{/if}}
    {{/if}}
    {{#if artifice.modificacao}}
    <h4>Modificações Permanentes <span class="epm-contador">até {{artifice.modificacao.criaturas}} criaturas · +{{artifice.modificacao.bonus}}</span></h4>
    {{#if @root.edicao}}
    <div class="epm-dialogo-linha">
      <label class="epm-campo"><span>Sua parte</span><select name="flags.epm-ficha.arquetipoOpcoes.artifice.modificacao.parte"><option value="">—</option>{{#each artifice.modificacao.partes}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.nome}}</option>{{/each}}</select></label>
      {{#each artifice.modificacao.partes}}{{#if selected}}<label class="epm-campo"><span>Opção</span><select name="flags.epm-ficha.arquetipoOpcoes.artifice.modificacao.opcao" data-dtype="Number">{{#each opcoes}}<option value="{{this.k}}" {{#if selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>{{/if}}{{/each}}
    </div>
    {{else}}<p>{{#if artifice.modificacao.escolhida}}{{artifice.modificacao.escolhida}} (já somado na ficha).{{else}}<span class="epm-vazio">Escolha a sua parte no modo edição.</span>{{/if}}</p>{{/if}}
    <p class="epm-dica">As outras criaturas modificadas recebem a parte delas na própria ficha. Trocar leva um Descanso Longo.</p>
    {{/if}}
    {{#if artifice.automato}}<p><button type="button" class="epm-botao" data-action="criarAutomato" {{#unless artifice.automato.podeCriar}}disabled{{/unless}}><i class="fa-solid fa-robot" aria-hidden="true"></i> Criar Pequeno Autômato</button> <span class="epm-dica">Vai para a aba Companheiros{{#if artifice.automato.bonus.atributos}}, com +{{artifice.automato.bonus.atributos}} nos atributos e +{{artifice.automato.bonus.recursos}} PV, PM e PE{{/if}}.</span></p>{{/if}}
    <p class="epm-dica">Classes: {{artifice.subclasses}}.</p>
  </div>
  {{/if}}

  <details class="epm-arq-habilidades">
    <summary>Habilidades do arquétipo: {{liberadas.length}} liberada{{#unless (epmEq liberadas.length 1)}}s{{/unless}}</summary>
    <ul class="epm-arq-lista">
      {{#each liberadas}}
      <li class="liberada"><span class="epm-arq-nivel">{{this.nivel}}</span><div><strong>{{this.nome}}</strong><p>{{this.resumo}}</p></div>
        {{#if naFicha}}<span class="epm-tag epm-tag-ok" title="Já está na ficha"><i class="fa-solid fa-check" aria-hidden="true"></i> na ficha</span>{{else if podeAdicionar}}<button type="button" class="epm-link" data-action="adicionarHabilidadeArq" data-ref="{{this.ref}}">Adicionar</button>{{/if}}</li>
      {{/each}}
      {{#each proximas}}
      <li class="trancada"><span class="epm-arq-nivel">{{this.nivel}}</span><div><strong>{{this.nome}}</strong><p>{{this.resumo}}</p></div><i class="fa-solid fa-lock" aria-hidden="true" title="Libera no nível {{this.nivel}}"></i></li>
      {{/each}}
    </ul>
  </details>
</section>
