<div class="epm-busca-barra"><label class="epm-busca epm-busca-lista"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" data-busca-lista="{{this.chave}}" placeholder="{{this.dica}}" aria-label="{{this.dica}}" autocomplete="off" spellcheck="false" /><span class="epm-busca-qtd" data-busca-qtd title="Resultados"></span></label></div>
<p class="epm-vazio epm-busca-vazia" data-busca-de="{{this.chave}}" hidden>Nada encontrado para essa busca.</p>
