<div class="epm-exaustao{{#if ficha.exaustao.morte}} morte{{else if ficha.exaustao.colapso}} colapso{{/if}}">
  <div class="epm-exaustao-topo">
    <span class="epm-rotulo">Exaustão</span>
    <span class="epm-exaustao-nivel">{{#if ficha.exaustao.nivel}}nível {{ficha.exaustao.nivel}}: {{ficha.exaustao.nome}}{{else}}nenhuma{{/if}}</span>
  </div>
  <div class="epm-exaustao-pips">
    {{#each ficha.exaustao.pips}}
    <button type="button" class="epm-pip-exaustao{{#if ativo}} ativo{{/if}}{{#if (epmEq nivel 6)}} fatal{{/if}}" data-action="exaustao" data-nivel="{{this.nivel}}" title="Nível {{this.nivel}} ({{this.nome}}): {{this.texto}}" {{#unless @root.editavel}}disabled{{/unless}}>{{this.nivel}}</button>
    {{/each}}
  </div>
  {{#if ficha.exaustao.nivel}}
  <ul class="epm-exaustao-efeitos">{{#each ficha.exaustao.efeitos}}<li><strong>{{this.nome}}</strong> {{this.texto}}</li>{{/each}}</ul>
  {{/if}}
  {{#if ficha.exaustao.morte}}<p class="epm-exaustao-alerta"><i class="fa-solid fa-skull" aria-hidden="true"></i> Exaustão 6: o personagem está morto.</p>
  {{else if ficha.exaustao.colapso}}<p class="epm-exaustao-alerta"><i class="fa-solid fa-bed" aria-hidden="true"></i> Colapso: Incapacitado e Inconsciente (marcados no token).</p>{{/if}}
  <p class="epm-dica">Cada descanso longo reduz 1 nível.</p>
</div>
