<li class="epm-item{{#if expandido}} expandido{{/if}}" data-item-id="{{this.id}}" draggable="true" style="--cor: {{this.raridadeCor}}">
  <div class="epm-item-linha">
    <img class="epm-item-img" src="{{this.img}}" alt="" {{#if @root.edicao}}data-action="imagemItem" data-item-id="{{this.id}}" title="Trocar imagem"{{/if}} />
    <button type="button" class="epm-item-nome" data-action="expandirItem" data-item-id="{{this.id}}" aria-expanded="{{#if expandido}}true{{else}}false{{/if}}">
      <span class="epm-item-titulo">{{this.name}}</span>
      {{#if eArma}}<span class="epm-item-dentro">{{ataque.periciaNome}} {{epmSinal ataque.acertoTotal}}, crítico {{ataque.critTexto}}</span>{{/if}}
      {{#if pente}}<span class="epm-item-recurso{{#if pente.vazio}} acabou{{/if}}" title="Tiros no pente"><i class="fa-solid fa-gun" aria-hidden="true"></i> {{pente.atual}}/{{pente.max}}</span> {{/if}}{{#if municao}}<span class="epm-item-recurso{{#if municao.acabou}} acabou{{/if}}" title="Munição gasta a cada ataque"><i class="fa-solid fa-bullseye" aria-hidden="true"></i> {{municao.nome}} ×{{municao.qtd}}</span>{{/if}}
      {{#if cargas}}<span class="epm-item-recurso{{#unless cargas.valor}} acabou{{/unless}}" title="Cargas{{#if cargas.recarga}}: recarregam em {{cargas.recarga}}{{/if}}"><i class="fa-solid fa-bolt" aria-hidden="true"></i> {{cargas.valor}}/{{cargas.max}}</span>{{/if}}
      {{#with (lookup @root.novas.durabilidade this.id) as |du|}}{{#if du.gasto}}<span class="epm-durabilidade{{#if du.quebrado}} quebrado{{/if}}" title="Durabilidade {{du.valor}} de 100{{#if du.quebrado}}: Quebrado, sem efeitos até consertar{{/if}}"><span class="epm-durabilidade-barra"><span style="width: {{du.valor}}%; background: {{du.cor}}"></span></span>{{#if du.quebrado}}Quebrado{{else}}{{du.valor}}{{/if}}</span>{{/if}}{{/with}}
      {{#if tecPenal}}<span class="epm-item-tec" title="{{tecPenal}}"><i class="fa-solid fa-microchip" aria-hidden="true"></i> {{tecPenal}}</span>{{/if}}
      {{#if resumoEfeitos.length}}<span class="epm-item-efeitos{{#unless efeitosAtivos}} inativos{{/unless}}" title="{{epmJoin resumoEfeitos " · "}}&#10;{{#if efeitosAtivos}}Bônus valendo{{else}}{{this.dicaAtivo}}{{/if}}">{{epmJoin resumoEfeitos " · "}}</span>{{/if}}
    </button>
    <span class="epm-raridade" title="Raridade">{{this.raridadeLabel}}</span>
    {{#if eArma}}
    <button type="button" class="epm-botao" data-action="atacar" data-tipo="arma" data-ref="{{this.id}}" title="Escolher vantagem, bônus e crítico, depois rolar acerto e dano"><i class="fa-solid fa-dice-d20"></i> Atacar</button>
    {{#if ataque.dano}}<button type="button" class="epm-dano" data-action="danoArma" data-item-id="{{this.id}}" title="Rolar só o dano ({{ataque.dano}})">{{ataque.danoBase}}</button>{{/if}}
    {{/if}}
    {{#if eConsumivel}}<button type="button" class="epm-botao" data-action="usarItem" data-item-id="{{this.id}}" title="Gasta 1 unidade e mostra no chat">Usar</button>{{/if}}
    <div class="epm-quantidade">
      <button type="button" data-action="quantidade" data-item-id="{{this.id}}" data-delta="-1" aria-label="Diminuir quantidade" {{#unless @root.editavel}}disabled{{/unless}}>−</button>
      <input type="number" min="0" value="{{this.quantidade}}" data-item-campo="system.quantity" data-item-id="{{this.id}}" aria-label="Quantidade" {{#unless @root.editavel}}disabled{{/unless}} />
      <button type="button" data-action="quantidade" data-item-id="{{this.id}}" data-delta="1" aria-label="Aumentar quantidade" {{#unless @root.editavel}}disabled{{/unless}}>+</button>
    </div>
    <span class="epm-item-peso" title="Peso ({{epmNumero peso}} cada)">{{epmNumero pesoLinha}}</span>
    <div class="epm-item-controles">
      {{#if equipavel}}<button type="button" class="epm-icone-botao{{#if equipado}} ativo{{/if}}" data-action="equiparItem" data-item-id="{{this.id}}" title="{{#if equipado}}Equipado (clique para tirar){{else}}Equipar{{/if}}" aria-pressed="{{#if equipado}}true{{else}}false{{/if}}"><i class="fa-solid fa-shirt"></i></button>{{/if}}
      <button type="button" class="epm-icone-botao epm-favorito{{#if favorito}} ativo{{/if}}" data-action="favoritar" data-item-id="{{this.id}}" title="{{#if favorito}}Tirar dos favoritos{{else}}Favoritar (fica no topo da categoria){{/if}}" aria-pressed="{{#if favorito}}true{{else}}false{{/if}}"><i class="fa-{{#if favorito}}solid{{else}}regular{{/if}} fa-star"></i></button>
      <button type="button" class="epm-icone-botao" data-action="chatItem" data-item-id="{{this.id}}" title="Mostrar no chat"><i class="fa-solid fa-comment"></i></button>
      {{#with (lookup @root.novas.durabilidade this.id) as |du|}}{{#if du.gasto}}{{#if @root.editavel}}<button type="button" class="epm-icone-botao" data-action="consertarItem" data-item-id="{{../id}}" title="Consertar: ferramenta, 10 minutos e teste de Ofício DT 12 (+50)"><i class="fa-solid fa-screwdriver-wrench"></i></button>{{/if}}{{/if}}{{/with}}
      {{#if manual}}{{#if @root.editavel}}<button type="button" class="epm-icone-botao" data-action="moverNaMochila" data-item-id="{{this.id}}" data-dir="-1" title="Subir na mochila" {{#if primeiraM}}disabled{{/if}}><i class="fa-solid fa-chevron-up"></i></button><button type="button" class="epm-icone-botao" data-action="moverNaMochila" data-item-id="{{this.id}}" data-dir="1" title="Descer na mochila" {{#if ultimaM}}disabled{{/if}}><i class="fa-solid fa-chevron-down"></i></button>{{/if}}{{/if}}
      {{#if @root.temMochilas}}{{#if @root.editavel}}<button type="button" class="epm-icone-botao" data-action="moverItemPara" data-item-id="{{this.id}}" title="Mover para… (mochila ou fora dela)"><i class="fa-solid fa-right-left"></i></button>{{/if}}{{/if}}
      {{#if containerNome}}{{#if @root.editavel}}<button type="button" class="epm-icone-botao" data-action="tirarDaMochila" data-item-id="{{this.id}}" title="Tirar de {{this.containerNome}}"><i class="fa-solid fa-arrow-up-from-bracket"></i></button>{{/if}}{{/if}}
      {{#if @root.edicao}}
      <button type="button" class="epm-icone-botao" data-action="editarItem" data-item-id="{{this.id}}" title="Abrir a ficha do item"><i class="fa-solid fa-pen-to-square"></i></button>
      <button type="button" class="epm-icone-botao perigo" data-action="excluirItem" data-item-id="{{this.id}}" title="Excluir"><i class="fa-solid fa-trash"></i></button>
      {{/if}}
    </div>
  </div>
  {{#if expandido}}
  <div class="epm-item-detalhes">
    {{#if @root.edicao}}
    <div class="epm-item-config">
      <label class="epm-mini"><span>raridade</span><select data-item-campo="flags.epm-ficha.raridade" data-item-id="{{this.id}}">{{#each opcoesRaridade}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>
      {{#if eArmadura}}<label class="epm-mini curto" title="Soma na CA (Armaduras e escudos) quando equipado"><span>CA</span><input type="number" value="{{this.armadura}}" data-item-campo="flags.epm-ficha.armadura" data-item-id="{{this.id}}" /></label>{{/if}}
      {{#if eArma}}
      <label class="epm-mini"><span>perícia de ataque</span><select data-item-campo="flags.epm-ficha.periciaAtaque" data-item-id="{{this.id}}">{{#each opcoesPericia}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.nome}}</option>{{/each}}</select></label>
      <label class="epm-mini curto"><span>acerto</span><input type="number" value="{{ataque.bonusAcerto}}" data-item-campo="flags.epm-ficha.bonusAcerto" data-item-id="{{this.id}}" /></label>
      <label class="epm-mini"><span>dano</span><input type="text" value="{{ataque.dano}}" data-item-campo="flags.epm-ficha.dano" data-item-id="{{this.id}}" placeholder="2d10 + @atr.forca" /></label>
      <label class="epm-mini"><span>tipo de dano</span><input type="text" value="{{ataque.tipoDano}}" data-item-campo="flags.epm-ficha.tipoDano" data-item-id="{{this.id}}" list="epm-sug-dano-{{@root.actor.id}}" placeholder="Cortante" /></label>
      {{#if ataque.temModos}}<span class="epm-dica" title="Os outros modos (ex.: cabo contundente) são editados nos detalhes do item">+ outros modos de ataque (detalhes do item)</span>{{/if}}
      <label class="epm-mini curto" title="Menor resultado no d20 que conta como crítico"><span>margem</span><input type="number" min="2" max="20" value="{{ataque.critMargem}}" data-item-campo="flags.epm-ficha.critMargem" data-item-id="{{this.id}}" /></label>
      <label class="epm-mini curto" title="No crítico, os dados da arma são multiplicados por este valor"><span>×crítico</span><input type="number" min="2" value="{{ataque.critMult}}" data-item-campo="flags.epm-ficha.critMult" data-item-id="{{this.id}}" /></label>
      {{/if}}
      {{#if eConsumivel}}<label class="epm-mini largo"><span>rolagem ao usar</span><input type="text" value="{{this.formulaUso}}" data-item-campo="flags.epm-ficha.formula" data-item-id="{{this.id}}" placeholder="2d4 + 2" /></label>{{/if}}
    </div>
    <div class="epm-efeitos-editor">
      <span class="epm-rotulo">Bônus e efeitos <span class="epm-dica">({{this.dicaAtivo}})</span></span>
      {{#each efeitos}}
      <div class="epm-efeito-item" data-efeito="{{this.id}}">
        <span class="epm-efeito-tipo">{{this.tipoLabel}}</span>
        {{#if eMod}}
        <select data-item-campo="flags.epm-ficha.efeitos.{{this.id}}.alvo" data-item-id="{{../id}}" aria-label="O que muda">
          <option value="">Escolha o que muda…</option>
          {{#each grupos}}<optgroup label="{{this.grupo}}">{{#each opcoes}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</optgroup>{{/each}}
        </select>
        <input type="number" step="any" value="{{this.valor}}" data-item-campo="flags.epm-ficha.efeitos.{{this.id}}.valor" data-item-id="{{../id}}" aria-label="Valor" title="Valor (use negativo para penalidade, ex.: −1,5 m de deslocamento)" />
        {{/if}}
        {{#if eRd}}
        <input type="number" min="0" value="{{this.valor}}" data-item-campo="flags.epm-ficha.efeitos.{{this.id}}.valor" data-item-id="{{../id}}" aria-label="Quanto reduz" title="Quanto reduz" />
        <input type="text" value="{{this.tipoDano}}" data-item-campo="flags.epm-ficha.efeitos.{{this.id}}.tipoDano" data-item-id="{{../id}}" placeholder="tipos (vazio = todos)" list="epm-sug-dano-{{@root.actor.id}}" aria-label="Tipos de dano" />
        {{/if}}
        {{#if eTipoDano}}{{#unless eFormula}}
        <input type="text" value="{{this.tipoDano}}" data-item-campo="flags.epm-ficha.efeitos.{{this.id}}.tipoDano" data-item-id="{{../id}}" placeholder="tipo de dano ou condição" list="epm-sug-dano-{{@root.actor.id}}" aria-label="Tipo" />
        {{/unless}}{{/if}}
        {{#if eEm}}
        <select data-item-campo="flags.epm-ficha.efeitos.{{this.id}}.em" data-item-id="{{../id}}" aria-label="Em quê">
          <option value="">Em quê…</option>
          {{#each opcoesEm}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
        </select>
        {{/if}}
        {{#if eCura}}
        <select data-item-campo="flags.epm-ficha.efeitos.{{this.id}}.recurso" data-item-id="{{../id}}" aria-label="Recurso">{{#each opcoesRecurso}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
        <select data-item-campo="flags.epm-ficha.efeitos.{{this.id}}.quando" data-item-id="{{../id}}" aria-label="Quando">{{#each opcoesQuando}}<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
        {{/if}}
        {{#if eFormula}}
        <input type="text" value="{{this.formula}}" data-item-campo="flags.epm-ficha.efeitos.{{this.id}}.formula" data-item-id="{{../id}}" placeholder="1d6 + 2" aria-label="Fórmula" />
        {{#if eTipoDano}}<input type="text" value="{{this.tipoDano}}" data-item-campo="flags.epm-ficha.efeitos.{{this.id}}.tipoDano" data-item-id="{{../id}}" placeholder="tipo (Fogo…)" list="epm-sug-dano-{{@root.actor.id}}" aria-label="Tipo de dano" />{{/if}}
        {{/if}}
        <button type="button" class="epm-icone-botao perigo" data-action="removerEfeitoItem" data-item-id="{{../id}}" data-efeito="{{this.id}}" title="Remover"><i class="fa-solid fa-xmark"></i></button>
      </div>
      {{/each}}
      <div class="epm-efeito-novo">
        <select class="epm-efeito-novo-tipo" aria-label="Tipo de bônus" data-novo-efeito="{{this.id}}">
          {{#each @root.tiposEfeitoItem}}<option value="{{this.id}}" title="{{this.dica}}">{{this.label}}</option>{{/each}}
        </select>
        <button type="button" class="epm-link" data-action="adicionarEfeitoItem" data-item-id="{{this.id}}"><i class="fa-solid fa-plus" aria-hidden="true"></i> Adicionar</button>
      </div>
    </div>
    {{/if}}
    <div class="epm-descricao">{{#if descricao}}{{{this.descricao}}}{{else}}<p class="epm-vazio">Sem descrição.{{#if @root.edicao}} Use o lápis para escrever uma.{{/if}}</p>{{/if}}</div>
  </div>
  {{/if}}
</li>
