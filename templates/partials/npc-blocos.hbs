{{!-- Blocos das fichas de NPC (0.8.11), iguais aos modelos em PDF. Uso: {{> "epm-npc" secao="atributos"}} --}}

{{#if (epmEq secao "atributos")}}
<section class="epm-npcv-painel">
  <h3>Atributos<span class="tag">{{#if npcVisual.eImportante}}igual à ficha de jogador{{else}}valor direto{{/if}}</span></h3>
  <div class="in">
    <div class="epm-npcv-attrs">
      {{#each npcVisual.atributos}}
      <div class="epm-npcv-attr">
        <button type="button" class="n" data-action="rolarAtributo" data-atributo="{{this.id}}" title="Rolar {{this.label}}">{{this.label}}</button>
        {{#if @root.edicao}}{{#unless @root.npcVisual.eImportante}}<input type="number" class="v-input" name="{{this.campo}}" value="{{this.base}}" aria-label="{{this.label}}" title="Valor direto (vai para a base)" />{{else}}<span class="v">{{this.valor}}</span>{{/unless}}{{else}}<span class="v">{{this.valor}}{{#if pen}}<span class="pen{{#unless penNeg}} bonus{{/unless}}">{{this.pen}}</span>{{/if}}</span>{{/if}}
        <span class="c">{{this.grupo}}</span>
      </div>
      {{/each}}
    </div>
    {{#if npcVisual.eImportante}}<p class="epm-npcv-nota">Mesmo cálculo dos jogadores (Base + Raça + Aumento + Outros). O selo mostra penalidades de condições, exaustão, bênçãos e maldições e entra nas rolagens.</p>
    {{else}}{{#if edicao}}<p class="epm-npcv-nota">Valor direto: o número vai para a base (raça, aumento e outros continuam somando, se houver).</p>{{else}}<p class="epm-npcv-nota">Só o valor final, sem Base/Raça/Aumento. Clicar rola o teste.</p>{{/if}}{{/if}}
  </div>
</section>
{{/if}}

{{#if (epmEq secao "combate")}}
<section class="epm-npcv-painel">
  <h3>Combate{{#if npcVisual.eImportante}}<span class="tag"></span>{{/if}}</h3>
  <div class="in">
    <div class="epm-npcv-stats">
      {{#each npcVisual.stats}}
      {{#if acao}}<button type="button" class="epm-npcv-stat{{#if ac}} ac{{/if}}" data-action="{{this.acao}}" {{#if defesa}}data-defesa="{{this.defesa}}"{{/if}} title="{{#if defesa}}Usar {{this.l}}{{else}}Rolar iniciativa{{/if}}"><span class="v">{{this.v}}</span><span class="l">{{this.l}}</span></button>
      {{else}}<div class="epm-npcv-stat{{#if ac}} ac{{/if}}"><span class="v">{{this.v}}</span><span class="l">{{this.l}}</span></div>{{/if}}
      {{/each}}
    </div>
    <div class="epm-npcv-pills">
      {{#each npcVisual.pills}}{{#if acao}}<button type="button" class="epm-npcv-pill {{this.cls}}" data-action="alternarAcao" data-acao="{{this.acao}}" title="Marcar/desmarcar">{{this.texto}}</button>{{else}}<span class="epm-npcv-pill {{this.cls}}">{{this.texto}}</span>{{/if}}{{/each}}
      <span class="epm-npcv-dim"> · {{npcVisual.caTexto}}</span>
    </div>
    {{#if edicao}}
    <div class="epm-npcv-edit">
      <label class="epm-mini"><span>CA base</span><input type="number" name="flags.epm-ficha.ca.base" value="{{dados.ca.base}}" /></label>
      <label class="epm-mini"><span>CA outros</span><input type="number" name="flags.epm-ficha.ca.bonus" value="{{dados.ca.bonus}}" /></label>
      <label class="epm-mini"><span>iniciativa</span><input type="number" name="flags.epm-ficha.iniciativa.bonus" value="{{dados.iniciativa.bonus}}" /></label>
      <label class="epm-mini"><span>desloc. (m)</span><input type="number" step="0.5" name="flags.epm-ficha.deslocamento.base" value="{{dados.deslocamento.base}}" /></label>
      {{#if npcVisual.eCriatura}}<label class="epm-mini largo"><span>deslocamentos</span><input type="text" name="flags.epm-ficha.npc.defesas.deslocamentos" value="{{npcFicha.defesas.deslocamentos}}" placeholder="Andar 9 m, Escalar 6 m" /></label>{{/if}}
    </div>
    {{/if}}
  </div>
</section>
{{/if}}

{{#if (epmEq secao "condicoes")}}
<section class="epm-npcv-painel">
  <h3>Condições e efeitos ativos<button type="button" class="tag-btn" data-action="irAba" data-tab="condicoes">gerenciar</button></h3>
  <div class="in">
    <div class="epm-npcv-chips">{{#each npcVisual.condicoes}}<span class="epm-npcv-chip red">{{this.texto}}</span>{{/each}}{{#unless npcVisual.condicoes.length}}<span class="epm-npcv-dim">Nenhuma condição ativa.</span>{{/unless}}</div>
    <p class="epm-npcv-nota">Motor de efeitos completo: 131 condições, combinações, imunidades, Novo turno, descanso e fim de combate.</p>
  </div>
</section>
{{/if}}

{{#if (epmEq secao "pericias")}}
<section class="epm-npcv-painel">
  <h3>{{#if npcVisual.eImportante}}Perícias{{else}}Perícias de destaque{{/if}}<span class="tag">{{#if npcVisual.eImportante}}30 oficiais · ★ favoritas{{else}}até 5{{/if}}</span></h3>
  <div class="in">
    <table class="epm-npcv-tab">
      <tr>{{#if npcVisual.eImportante}}<th class="w4"></th>{{/if}}<th>Perícia</th>{{#if npcVisual.eImportante}}<th>Atributo</th>{{/if}}<th class="w10">Total</th></tr>
      {{#each npcVisual.destaque}}
      <tr>{{#if @root.npcVisual.eImportante}}<td>{{#if favorita}}★{{/if}}</td>{{/if}}<td><button type="button" class="epm-npcv-link{{#if favorita}} b{{/if}}" data-action="rolarPericia" data-pericia="{{this.id}}" title="Rolar">{{this.nome}}</button></td>{{#if @root.npcVisual.eImportante}}<td>{{this.atributo}}</td>{{/if}}<td><b>{{this.total}}</b></td></tr>
      {{/each}}
    </table>
    {{#unless npcVisual.destaque.length}}<p class="epm-npcv-dim">Nenhuma perícia com pontos.</p>{{/unless}}
    <p class="epm-npcv-nota">{{#if npcVisual.eImportante}}Lista oficial das 30 perícias, igual à dos jogadores; “Favoritas no topo” ligado.{{else}}Até 5. As outras usam só o atributo.{{#if edicao}} Marque ★ na aba Principal para escolher.{{/if}}{{/if}}</p>
  </div>
</section>
{{/if}}

{{#if (epmEq secao "habResumo")}}
<section class="epm-npcv-painel">
  <h3>Habilidades e magias (resumo)<button type="button" class="tag-btn" data-action="irAba" data-tab="habilidades">abrir</button></h3>
  <div class="in">
    <table class="epm-npcv-tab">
      <tr><th>Nome</th><th>Tipo</th><th>Ação</th><th>Custo</th><th>Efeito</th></tr>
      {{#each npcVisual.habResumo}}
      <tr><td><button type="button" class="epm-npcv-link b" data-action="usarPoder" data-item-id="{{this.itemId}}" title="Usar">{{this.nome}}</button></td><td>{{this.tipo}}</td><td>{{this.acao}}</td><td>{{#if custoCls}}<span class="epm-npcv-pill {{this.custoCls}}">{{this.custo}}</span>{{else}}{{this.custo}}{{/if}}</td><td>{{this.efeito}}</td></tr>
      {{/each}}
    </table>
    {{#unless npcVisual.habResumo.length}}<p class="epm-npcv-dim">Nenhuma habilidade ou magia.</p>{{/unless}}
  </div>
</section>
{{/if}}

{{#if (epmEq secao "ataques")}}
<section class="epm-npcv-painel">
  <h3>Ataques<span class="tag">1 a 3</span></h3>
  <div class="in">
    <table class="epm-npcv-tab">
      <tr><th>Ataque</th><th>Acerto</th><th>Dano</th><th></th></tr>
      {{#each npcVisual.ataques}}
      <tr><td><b>{{this.nome}}</b>{{#if sub}} <span class="epm-npcv-dim">· {{this.sub}}</span>{{/if}}</td><td>{{this.acerto}}</td><td><span class="epm-npcv-dado">{{this.dano}}</span> {{this.tipoDano}}</td><td class="epm-npcv-acoesbtn">{{#each formas}}<button type="button" class="epm-npcv-btn{{#if bloqueada}} off{{/if}}" data-action="usarFormaItem" data-item-id="{{../itemId}}" data-forma-id="{{this.id}}" title="{{this.dica}}">{{this.nome}}</button>{{/each}}<button type="button" class="epm-npcv-btn" data-action="atacar" data-tipo="{{this.tipo}}" data-ref="{{this.ref}}">Atacar</button></td></tr>
      {{/each}}
    </table>
    {{#unless npcVisual.ataques.length}}<p class="epm-npcv-dim">Equipe uma arma ou crie um ataque.</p>{{/unless}}
    {{#if edicao}}<p class="epm-npcv-nota"><button type="button" class="epm-npcv-btn" data-action="novoAtaque">+ Novo ataque</button> Os detalhes de cada ataque se editam na aba Combate.</p>{{/if}}
  </div>
</section>
{{/if}}

{{#if (epmEq secao "acoes")}}
<section class="epm-npcv-painel">
  <h3>Ações<span class="tag">{{#if npcVisual.eChefe}}contadores ◆ ◇ ▲ na ficha{{else}}{{#if npcVisual.eElite}}recarga e lendárias controladas pela ficha{{else}}as condições são aplicadas pelo cartão{{/if}}{{/if}}</span></h3>
  <div class="in">
    <table class="epm-npcv-tab">
      <tr><th class="w22">Ação</th><th>Nome</th><th>Teste</th><th>Efeito</th><th class="w11"></th></tr>
      {{#each npcVisual.acoes}}
      <tr><td><span class="epm-npcv-pill {{this.cls}}">{{this.pill}}</span></td><td><b>{{this.nome}}</b></td><td>{{this.teste}}</td><td>{{this.efeito}}</td>
        <td>{{#unless passiva}}{{#if (epmEq acao "atacar")}}{{#each formas}}<button type="button" class="epm-npcv-btn{{#if bloqueada}} off{{/if}}" data-action="usarFormaItem" data-item-id="{{../itemId}}" data-forma-id="{{this.id}}" title="{{this.dica}}">{{this.nome}}</button>{{/each}}<button type="button" class="epm-npcv-btn" data-action="atacar" data-tipo="{{this.tipo}}" data-ref="{{this.ref}}">Usar</button>{{else}}<button type="button" class="epm-npcv-btn{{#if bloqueada}} off{{/if}}" data-action="usarPoder" data-item-id="{{this.itemId}}">Usar</button>{{/if}}{{/unless}}</td></tr>
      {{/each}}
    </table>
    {{#unless npcVisual.acoes.length}}<p class="epm-npcv-dim">Nenhuma ação. No modo edição: crie um ataque ou uma habilidade.</p>{{/unless}}
    {{#if edicao}}<p class="epm-npcv-nota"><button type="button" class="epm-npcv-btn" data-action="novoAtaque">+ Ataque</button> <button type="button" class="epm-npcv-btn" data-action="novoPoder" data-tipo="habilidade">+ Habilidade</button> <button type="button" class="epm-npcv-btn" data-action="novoPoder" data-tipo="magia">+ Magia</button> As formas (ação, custo, teste, dano) se editam no editor de habilidade; a ação Lendária/Mítica/Arcaica é escolhida na forma.</p>{{/if}}
  </div>
</section>
{{/if}}

{{#if (epmEq secao "defesas")}}
<section class="epm-npcv-painel">
  <h3>Defesas e sentidos{{#if npcVisual.eMonstro}}<span class="tag">entram no motor de efeitos</span>{{/if}}</h3>
  <div class="in">
    <table class="epm-npcv-tab">
      {{#each npcVisual.defesas}}<tr><td class="w30"><b>{{this.l}}</b></td><td>{{this.v}}</td></tr>{{/each}}
    </table>
    {{#if edicao}}
    <div class="epm-npcv-edit">
      <label class="epm-mini largo"><span>RD</span><input type="text" name="flags.epm-ficha.npc.defesas.rd" value="{{npcFicha.defesas.rd}}" placeholder="2 contra Cortante" /></label>
      <label class="epm-mini largo"><span>imune a condições</span><input type="text" name="flags.epm-ficha.npc.defesas.imunesCondicoes" value="{{npcFicha.defesas.imunesCondicoes}}" placeholder="Em Chamas" /></label>
      <label class="epm-mini largo"><span>sentidos</span><input type="text" name="flags.epm-ficha.npc.defesas.sentidos" value="{{npcFicha.defesas.sentidos}}" placeholder="Sentido sísmico 9 m" /></label>
    </div>
    <p class="epm-npcv-nota">Resistência, vulnerabilidade e imunidade a dano (e a RD que entra no “Aplicar dano”) se editam na aba Combate.</p>
    {{/if}}
  </div>
</section>
{{/if}}

{{#if (epmEq secao "comportamento")}}
<section class="epm-npcv-painel">
  <h3>Comportamento</h3>
  <div class="in">
    {{#if edicao}}
    <div class="epm-npcv-edit">
      <label class="epm-mini"><span>moral: Vida ≤ %</span><input type="number" min="0" max="99" name="flags.epm-ficha.npc.moral.pct" value="{{npcFicha.moral.pct}}" /></label>
      <label class="epm-mini largo"><span>moral: observação</span><input type="text" name="flags.epm-ficha.npc.moral.texto" value="{{npcFicha.moral.texto}}" placeholder="menos dentro da toca" /></label>
      <label class="epm-mini largo"><span>tática</span><input type="text" name="flags.epm-ficha.npc.tatica" value="{{npcFicha.tatica}}" placeholder="chama reforço antes de lutar" /></label>
      {{#if npcVisual.eCriatura}}<label class="epm-mini"><span>bando</span><input type="text" name="flags.epm-ficha.npc.bando" value="{{npcFicha.bando}}" placeholder="1d4 + 1" /></label>{{/if}}
    </div>
    {{else}}
    {{#if npcFicha.moral.pct}}<div class="epm-npcv-ln"><span><b>Moral</b> <span class="epm-npcv-dim">· pergunta com {{npcFicha.moral.pct}}% da Vida{{#if npcFicha.moral.texto}}, {{npcFicha.moral.texto}}{{/if}}</span></span><span class="epm-npcv-pill gold">pergunta ao Mestre</span></div>{{/if}}
    {{#if npcFicha.tatica}}<div class="epm-npcv-ln"><span><b>Tática</b> <span class="epm-npcv-dim">· {{npcFicha.tatica}}</span></span><span></span></div>{{/if}}
    {{#if npcVisual.eCriatura}}<div class="epm-npcv-ln"><span><b>Bando</b> <span class="epm-npcv-dim">· {{#if npcFicha.bando}}{{npcFicha.bando}}; {{/if}}iniciativa única para o grupo; cada um com Vida rolada</span></span>{{#if isGM}}<button type="button" class="epm-npcv-btn gm" data-action="npcDuplicar">Criar bando</button>{{/if}}</div>{{/if}}
    {{/if}}
  </div>
</section>
{{/if}}

{{#if (epmEq secao "interpretacao")}}
<section class="epm-npcv-painel">
  <h3>Interpretação rápida<span class="tag">1 linha cada</span></h3>
  <div class="in">
    {{#if edicao}}
    <label class="epm-mini largo"><span>jeito</span><input type="text" name="flags.epm-ficha.npc.interp.jeito" value="{{npcFicha.interp.jeito}}" /></label>
    <label class="epm-mini largo"><span>quer</span><input type="text" name="flags.epm-ficha.npc.interp.quer" value="{{npcFicha.interp.quer}}" /></label>
    <label class="epm-mini largo"><span>sabe</span><input type="text" name="flags.epm-ficha.npc.interp.sabe" value="{{npcFicha.interp.sabe}}" /></label>
    {{else}}
    <p><b>Jeito:</b> {{npcFicha.interp.jeito}}</p>
    <p><b>Quer:</b> {{npcFicha.interp.quer}}</p>
    <p><b>Sabe:</b> {{#if npcFicha.interp.sabe}}“{{npcFicha.interp.sabe}}”{{/if}}</p>
    {{/if}}
  </div>
</section>
{{/if}}

{{#if (epmEq secao "relacao")}}
<section class="epm-npcv-painel">
  <h3>Relação com o grupo</h3>
  <div class="in">
    <div class="epm-npcv-ln"><span>Grupo inteiro</span><span class="epm-npcv-aff-wrap">{{#if isGM}}<button type="button" class="epm-npcv-seta" data-action="npcAfinidade" data-delta="-1" aria-label="Menos 1">−</button>{{/if}}<span class="epm-npcv-aff">{{#each npcVisual.afinidadeCelulas}}<span class="{{this.cls}}"></span>{{/each}}</span> <b>{{npcVisual.afinidadeTexto}}</b>{{#if isGM}}<button type="button" class="epm-npcv-seta" data-action="npcAfinidade" data-delta="1" aria-label="Mais 1">+</button>{{/if}}</span></div>
    <p class="epm-npcv-nota">Uma afinidade só para o grupo. Dá para separar por personagem promovendo a NPC Importante.</p>
  </div>
</section>
{{/if}}

{{#if (epmEq secao "lootCurto")}}
<section class="epm-npcv-painel">
  <h3>Loot<span class="tag">rola ao derrotar</span></h3>
  <div class="in">
    {{#if npcFicha.moedasLoot}}<div class="epm-npcv-ln"><span>Moedas</span><span class="epm-npcv-dado">{{npcFicha.moedasLoot}}</span></div>{{/if}}
    {{#each npcFicha.loot}}<div class="epm-npcv-ln"><span>{{this.nome}}</span><span>{{#if (epmEq chance 100)}}sempre{{else}}{{this.chance}}%{{/if}}</span></div>{{/each}}
    {{#if edicao}}<button type="button" class="epm-npcv-btn" data-action="irAba" data-tab="npc">Editar o loot na aba Mestre</button>{{else}}{{#if isGM}}<button type="button" class="epm-npcv-btn gm" data-action="npcSaquear">Saquear</button>{{/if}}{{/if}}
  </div>
</section>
{{/if}}

{{#if (epmEq secao "loot")}}
<section class="epm-npcv-painel">
  <h3>Loot e materiais de criação<span class="tag">liga com a Criação de itens</span></h3>
  <div class="in">
    {{#if edicao}}
    <label class="epm-mini"><span>moedas</span><input type="text" name="flags.epm-ficha.npc.moedasLoot" value="{{npcFicha.moedasLoot}}" placeholder="2d6 PP" /></label>
    {{#each npcFicha.loot}}
    <div class="epm-npc-linha">
      <input type="text" name="flags.epm-ficha.npc.loot.{{this.id}}.nome" value="{{this.nome}}" placeholder="Material" aria-label="Material" />
      <label class="epm-mini"><span>qtd.</span><input type="text" name="flags.epm-ficha.npc.loot.{{this.id}}.qtd" value="{{this.qtd}}" /></label>
      <label class="epm-mini"><span>chance %</span><input type="number" min="0" max="100" name="flags.epm-ficha.npc.loot.{{this.id}}.chance" value="{{this.chance}}" /></label>
      <input type="text" name="flags.epm-ficha.npc.loot.{{this.id}}.uso" value="{{this.uso}}" placeholder="Uso sugerido" aria-label="Uso" />
      <button type="button" class="epm-icone-botao perigo" data-action="npcApagar" data-lista="loot" data-id="{{this.id}}" title="Apagar"><i class="fa-solid fa-trash"></i></button>
    </div>
    {{/each}}
    <button type="button" class="epm-npcv-btn" data-action="npcNovo" data-lista="loot">+ Material</button>
    {{else}}
    <table class="epm-npcv-tab">
      <tr><th>Material</th><th class="w13">Qtd.</th><th class="w12">Chance</th><th>Uso sugerido</th></tr>
      {{#if npcFicha.moedasLoot}}<tr><td><b>Moedas</b></td><td><span class="epm-npcv-dado">{{npcFicha.moedasLoot}}</span></td><td>100%</td><td></td></tr>{{/if}}
      {{#each npcFicha.loot}}<tr><td><b>{{this.nome}}</b></td><td>{{#if (epmEq qtd "1")}}1{{else}}<span class="epm-npcv-dado">{{this.qtd}}</span>{{/if}}</td><td>{{this.chance}}%</td><td>{{this.uso}}</td></tr>{{/each}}
    </table>
    {{#if isGM}}<p class="epm-npcv-nota"><button type="button" class="epm-npcv-btn gm" data-action="npcSaquear">Saquear</button> Rola as chances ao derrotar e manda o resultado para o chat.</p>{{/if}}
    {{/if}}
  </div>
</section>
{{/if}}

{{#if (epmEq secao "elite")}}
<section class="epm-npcv-painel">
  <h3>Traços de elite<span class="tag">o que separa do Monstro comum</span></h3>
  <div class="in">
    <div class="epm-npcv-g2">
      <div class="epm-npcv-fase{{#if npcVisual.aura}} cur{{/if}}"><div class="ph"><b>Aura de Horror</b>{{#if npcVisual.aura}}<span class="epm-npcv-pill v">{{npcVisual.aura.dado}} · DT {{npcVisual.aura.dt}}</span>{{else}}<span class="epm-npcv-pill">sem aura</span>{{/if}}</div>
        <p class="epm-npcv-small">No começo do combate, quem ainda não o viu testa Vontade. Falha: perde {{#if npcVisual.aura}}{{npcVisual.aura.dado}}{{else}}1dX{{/if}} PS.{{#if npcVisual.aura.vistos}} <span class="epm-npcv-dim">Já viram: {{npcVisual.aura.vistos}}.</span>{{/if}}{{#if edicao}} <span class="epm-npcv-dim">(Configure no painel Aura de Horror da aba Combate.)</span>{{/if}}</p></div>
      <div class="epm-npcv-fase"><div class="ph"><b>Tenacidade</b><span class="epm-npcv-pill gold">{{npcFicha.tenacidade.livres}} / {{npcFicha.tenacidade.max}} por combate</span></div>
        <p class="epm-npcv-small">Ao receber uma condição, o Mestre pode recusar.{{#if isGM}} <button type="button" class="epm-npcv-btn" data-action="npcContador" data-campo="tenacidade">Usar</button>{{/if}}{{#if edicao}} <label class="epm-mini"><span>por combate</span><input type="number" min="0" max="10" name="flags.epm-ficha.npc.tenacidade.max" value="{{npcFicha.tenacidade.max}}" /></label>{{/if}}</p></div>
      <div class="epm-npcv-fase"><div class="ph"><b>Ações Lendárias</b><span class="epm-npcv-pill gold">{{npcFicha.lendarias}} por rodada</span></div>
        <p class="epm-npcv-small">Usadas no fim do turno de outra criatura. Recarregam no começo do turno dele.{{#if isGM}} <button type="button" class="epm-npcv-seta" data-action="npcAcaoEspecial" data-acao="lendaria" data-delta="-1">−</button><button type="button" class="epm-npcv-seta" data-action="npcAcaoEspecial" data-acao="lendaria" data-delta="1">+</button>{{/if}}</p></div>
