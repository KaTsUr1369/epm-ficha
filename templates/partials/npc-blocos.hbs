  <h3>O que os jogadores veem<span class="tag">barra de chefe</span></h3>
  <div class="in">
    <div class="epm-npcv-tela">
      <div class="nome">{{actor.name}}</div>
      <div class="epm-npcv-hpstrip"><div class="f" style="width: {{npcVisual.vidaPct}}%"></div>{{#each npcVisual.fases}}{{#unless primeira}}<div class="mk" style="left: {{this.limiar}}%"></div>{{/unless}}{{/each}}</div>
      <div class="rod"><span class="ac">Fase {{npcVisual.faseAtual}}{{#each npcVisual.fases}}{{#if atual}}{{#if nome}} · {{this.nome}}{{/if}}{{/if}}{{/each}}</span><span class="epm-npcv-dim">{{#if npcFicha.barraNumeros}}com números{{else}}sem números · só a barra{{/if}}</span></div>
    </div>
    {{#if isGM}}<label class="epm-check"><input type="checkbox" name="flags.epm-ficha.npc.barra" {{#if npcFicha.barra}}checked{{/if}} /> Mostrar a barra no topo da tela de todos durante o combate</label>
    <label class="epm-check"><input type="checkbox" name="flags.epm-ficha.npc.barraNumeros" {{#if npcFicha.barraNumeros}}checked{{/if}} /> Mostrar a Vida exata</label>{{/if}}
    <p class="epm-npcv-nota">Ao mudar de fase, a fala aparece na barra.</p>
  </div>
</section>
{{/if}}

{{#if (epmEq secao "covil")}}
<section class="epm-npcv-painel">
  <h3>Ações de Covil<span class="tag">só dentro do covil</span></h3>
  <div class="in">
    {{#if edicao}}
    {{#each npcFicha.covil.entradas}}
    <div class="epm-npc-linha"><span class="epm-npc-num">{{this.n}}</span>
      <input type="text" name="flags.epm-ficha.npc.covil.entradas.{{this.id}}.texto" value="{{this.texto}}" placeholder="Pilares desabam: área de 6 m, Acrobacia DT 18 ou 4d10 Contundente e Caído." aria-label="Ação de Covil" />
      <button type="button" class="epm-icone-botao perigo" data-action="npcApagar" data-lista="covil.entradas" data-id="{{this.id}}" title="Apagar"><i class="fa-solid fa-trash"></i></button></div>
    {{/each}}
    <button type="button" class="epm-npcv-btn" data-action="npcNovo" data-lista="covil.entradas">+ Ação de Covil</button>
    <label class="epm-mini largo"><span>nome do covil</span><input type="text" name="flags.epm-ficha.npc.covilNome" value="{{npcFicha.covilNome}}" placeholder="Cripta do Eclipse" /></label>
    {{else}}
    <table class="epm-npcv-tab">
      <tr><th class="w9">d{{npcFicha.covil.entradas.length}}</th><th>Na iniciativa 20, perdendo empates</th></tr>
      {{#each npcFicha.covil.entradas}}<tr><td><b>{{this.n}}</b></td><td>{{this.texto}}</td></tr>{{/each}}
    </table>
    {{#unless npcFicha.covil.entradas.length}}<p class="epm-npcv-dim">Nenhuma Ação de Covil. Use o modo edição.</p>{{/unless}}
    {{/if}}
    {{#if isGM}}<p class="epm-npcv-nota"><button type="button" class="epm-npcv-btn gm" data-action="npcCovil">Rolar covil</button> <label class="epm-check"><input type="checkbox" name="flags.epm-ficha.npc.covil.ativo" {{#if npcFicha.covil.ativo}}checked{{/if}} /> rolar sozinho a cada rodada</label></p>{{/if}}
  </div>
</section>
{{/if}}

{{#if (epmEq secao "recompensas")}}
<section class="epm-npcv-painel">
  <h3>Recompensas<span class="tag">fim do combate</span></h3>
  <div class="in">
    {{#if edicao}}
    <label class="epm-mini largo"><span>feito</span><input type="text" name="flags.epm-ficha.npc.recomp.feito" value="{{npcFicha.recomp.feito}}" placeholder="Devorador Devorado" /></label>
    <label class="epm-mini largo"><span>título</span><input type="text" name="flags.epm-ficha.npc.recomp.titulo" value="{{npcFicha.recomp.titulo}}" placeholder="Quebra-Núcleos" /></label>
    <label class="epm-mini largo"><span>item</span><input type="text" name="flags.epm-ficha.npc.recomp.item" value="{{npcFicha.recomp.item}}" placeholder="Cajado do Último Eclipse · Lendário" /></label>
    <label class="epm-mini largo"><span>bênção</span><input type="text" name="flags.epm-ficha.npc.recomp.bencao" value="{{npcFicha.recomp.bencao}}" placeholder="do catálogo · para quem der o golpe final" /></label>
    <label class="epm-mini"><span>moedas</span><input type="text" name="flags.epm-ficha.npc.moedasLoot" value="{{npcFicha.moedasLoot}}" placeholder="4d10 PL" /></label>
    <label class="epm-mini largo"><span>outras</span><textarea name="flags.epm-ficha.npc.recompensas" rows="2">{{npcFicha.recompensas}}</textarea></label>
    {{else}}
    <div class="epm-npcv-ln"><span><b>PEv</b> <span class="epm-npcv-dim">· 5 × ND, +2 por nível de diferença</span></span><span>{{npcFicha.pev}}</span></div>
    {{#if npcFicha.recomp.feito}}<div class="epm-npcv-ln"><span><b>Feito</b> “{{npcFicha.recomp.feito}}”</span>{{#if npcFicha.recomp.titulo}}<span class="epm-npcv-pill gold">título: {{npcFicha.recomp.titulo}}</span>{{/if}}</div>{{/if}}
    {{#if npcFicha.recomp.item}}<div class="epm-npcv-ln"><span><b>Item</b> {{npcFicha.recomp.item}}</span><span>100%</span></div>{{/if}}
    {{#if npcFicha.recomp.bencao}}<div class="epm-npcv-ln"><span><b>Bênção</b> <span class="epm-npcv-dim">· {{npcFicha.recomp.bencao}}</span></span>{{#if isGM}}<button type="button" class="epm-npcv-btn gm" data-action="irAba" data-tab="bencaos">Escolher</button>{{/if}}</div>{{/if}}
    {{#if npcFicha.moedasLoot}}<div class="epm-npcv-ln"><span><b>Moedas</b></span><span class="epm-npcv-dado">{{npcFicha.moedasLoot}}</span></div>{{/if}}
    {{#if npcFicha.recompensas}}<p class="epm-npcv-small">{{npcFicha.recompensas}}</p>{{/if}}
    {{#if isGM}}<p class="epm-npcv-nota"><button type="button" class="epm-npcv-btn gm" data-action="npcEntregar">Entregar no chat</button></p>{{/if}}
    {{/if}}
  </div>
</section>
{{/if}}

{{#if (epmEq secao "notas")}}{{#if isGM}}
<section class="epm-npcv-painel gm">
  <h3>Notas do Mestre<span class="tag gm">só o Mestre vê</span></h3>
  <div class="in">
    {{#if edicao}}
    <label class="epm-mini largo"><span>{{#if npcVisual.eCriatura}}motivação / onde aparece{{else}}agenda{{/if}}</span><textarea rows="2" name="flags.epm-ficha.npc.notas.agenda">{{npcFicha.notas.agenda}}</textarea></label>
    <label class="epm-mini largo"><span>segredo</span><textarea rows="2" name="flags.epm-ficha.npc.notas.segredo">{{npcFicha.notas.segredo}}</textarea></label>
    <label class="epm-mini largo"><span>ganchos</span><textarea rows="2" name="flags.epm-ficha.npc.notas.ganchos">{{npcFicha.notas.ganchos}}</textarea></label>
    <label class="epm-mini largo"><span>{{#if npcVisual.eChefe}}se fugir / ritmo{{else}}se morrer{{/if}}</span><textarea rows="2" name="flags.epm-ficha.npc.notas.seMorrer">{{npcFicha.notas.seMorrer}}</textarea></label>
    {{else}}
    {{#if npcFicha.notas.agenda}}<p><b>{{#if npcVisual.eCriatura}}{{#if npcVisual.eChefe}}Motivação{{else}}Onde aparece{{/if}}{{else}}Agenda{{/if}}:</b> {{npcFicha.notas.agenda}}</p>{{/if}}
    {{#if npcFicha.notas.segredo}}<p><b>Segredo:</b> {{npcFicha.notas.segredo}}</p>{{/if}}
    {{#if npcFicha.notas.ganchos}}<p><b>{{#if npcVisual.eCriatura}}Gancho{{else}}Ganchos{{/if}}:</b> {{npcFicha.notas.ganchos}}</p>{{/if}}
    {{#if npcFicha.notas.seMorrer}}<p><b>{{#if npcVisual.eChefe}}Se fugir{{else}}Se morrer{{/if}}:</b> {{npcFicha.notas.seMorrer}}</p>{{/if}}
    {{#unless npcFicha.temNotas}}<p class="epm-npcv-dim">Sem notas. Use o modo edição.</p>{{/unless}}
    {{/if}}
  </div>
</section>
{{/if}}{{/if}}
