    <div class="epm-060-opcoes">{{#each aa.sobrecarga.opcoes}}<button type="button" class="epm-chip{{#if ativo}} ativo{{/if}}" data-action="sobrecargaArcana" data-id="{{this.id}}" title="{{this.texto}}{{#if ativo}} (clique para encerrar){{/if}}" {{#unless @root.editavel}}disabled{{/unless}}>{{this.nome}}</button>{{/each}}</div>
    {{/if}}
  </div>
  {{/with}}
  {{#if v.classe.posicoes}}
  <p class="epm-rotulo">Posições (até {{v.classe.posicoes.max}})</p>
  <div class="epm-060-opcoes">{{#each v.classe.posicoes.opcoes}}<button type="button" class="epm-chip{{#if ativo}} ativo{{/if}}" data-action="posicaoLutador" data-id="{{this.id}}" data-max="{{v.classe.posicoes.max}}" title="{{this.texto}}" {{#unless @root.editavel}}disabled{{/unless}}>{{this.nome}}</button>{{/each}}</div>
  {{/if}}
  <p class="epm-dica"><i class="fa-solid fa-book" aria-hidden="true"></i> As habilidades da classe ficam na aba Arquétipo e Classe, sub-aba Classe.</p>
</section>
{{/if}}
{{#if v.classeElemental}}<p class="epm-dica epm-060-elemental"><i class="fa-solid fa-fire"></i> Elementos: Fogo, Água, Ar e Terra (Nv. 3); Raio e Gelo (12); Som e Pressão (27); Fogo Azul, Raio Negro, Ácido, Zero Absoluto, Vendaval, Ruído, Gravidade e Abalo Sísmico (39). A partir do Nv. 39, um crítico ou 15+ de dano elemental pede Fortitude ao alvo (o botão aparece no cartão do ataque).</p>{{/if}}
