<li class="epm-poder{{#if ativa}} ativa{{/if}}{{#if bloqueada}} bloqueada{{/if}}{{#if expandido}} expandido{{/if}}{{#if selecionado}} selecionado{{/if}}" data-item-id="{{this.id}}" draggable="true" style="--cor: {{this.raridadeCor}}">
  <div class="epm-poder-linha{{#if selecionando}} com-selecao{{/if}}">
    {{#if selecionando}}<label class="epm-selecionar" title="Selecionar"><input type="checkbox" data-selecionar-poder="{{this.id}}" {{#if selecionado}}checked{{/if}} aria-label="Selecionar {{this.name}}" /></label>{{/if}}
    <img class="epm-poder-img" src="{{this.img}}" alt="" {{#if @root.edicao}}data-action="imagemItem" data-item-id="{{this.id}}" title="Trocar imagem"{{/if}} />
    <div class="epm-poder-info">
      <button type="button" class="epm-poder-nome" data-action="expandirItem" data-item-id="{{this.id}}" aria-expanded="{{#if expandido}}true{{else}}false{{/if}}">{{#if favorito}}<i class="fa-solid fa-star epm-estrela" aria-hidden="true"></i>{{/if}}{{this.name}}</button>
      <div class="epm-poder-meta">
        <span class="epm-raridade">{{this.raridadeLabel}}</span>
        {{#if origemLabel}}<span class="epm-tag">{{this.origemLabel}}</span>{{/if}}
        {{#if foraDoLimite}}<span class="epm-tag epm-tag-ok" title="Não conta no limite de habilidades/magias da raridade">Fora do limite</span>{{/if}}
        {{#if tipoHab}}<span class="epm-tag" title="{{#if tema}}Tema: {{this.tema}}{{/if}}">{{this.tipoHab}}</span>{{/if}}
        {{#if nivelHab}}<span class="epm-tag" title="Nível da habilidade">Nv {{this.nivelHab}}</span>{{/if}}
        {{#if gatilho}}<span class="epm-tag epm-tag-gatilho" title="Ativação condicional: entra sozinha, uma vez por cena"><i class="fa-solid fa-bolt" aria-hidden="true"></i> {{this.gatilho}}</span>{{/if}}
        {{#if elemento}}<span class="epm-tag epm-tag-elemento"><i class="fa-solid fa-fire-flame-curved" aria-hidden="true"></i> {{this.elemento}}</span>{{/if}}
        {{#if passiva}}<span class="epm-tag">Passiva</span>{{/if}}
        {{#each formas}}<span class="epm-forma-chip{{#if bloqueada}} bloqueada{{/if}}{{#if semRecurso}} sem-recurso{{/if}}" {{#if bloqueada}}title="Bloqueada: {{this.motivosTexto}}"{{else if semRecurso}}title="Recurso insuficiente"{{/if}}>{{#if ../variasFormas}}<strong>{{this.nome}}</strong> {{/if}}{{this.acaoLabel}}, {{this.custoTexto}}{{#if resistencia}}, DT {{@root.ficha.cd.valor}}{{/if}}{{#if usoLabel}}, <span class="epm-uso-forma{{#if usoGasto}} gasto{{/if}}" title="{{#if usoGasto}}Já usada; volta conforme o limite{{else}}Disponível{{/if}}">{{this.usoLabel}}{{#if usoGasto}} (usada){{/if}}</span>{{/if}}</span>{{/each}}
        {{#unless nFormas}}{{#unless passiva}}<span class="epm-tag fraca">sem formas</span>{{/unless}}{{/unless}}
        {{#if alertas.length}}<span class="epm-alerta" title="{{this.alertasTexto}}"><i class="fa-solid fa-triangle-exclamation" aria-label="Acima dos limites da raridade"></i></span>{{/if}}
      </div>
    </div>
    <button type="button" class="epm-botao epm-usar{{#if bloqueada}} bloqueado{{/if}}" data-action="usarPoder" data-item-id="{{this.id}}" title="{{#if bloqueada}}Bloqueada por: {{this.motivosTexto}}{{else}}Usar{{#if variasFormas}} (você escolhe a forma){{/if}}{{/if}}">{{#if bloqueada}}<i class="fa-solid fa-lock" aria-hidden="true"></i> Bloqueada{{else}}Usar{{/if}}</button>
    {{#if alternavel}}<button type="button" class="epm-chave-hab{{#if ativa}} ligado{{/if}}" role="switch" aria-checked="{{#if ativa}}true{{else}}false{{/if}}" data-action="alternarHabilidade" data-item-id="{{this.id}}" title="{{#if ativa}}Ativa: clique para desligar (tira o bônus de cena e a sustentação){{else}}Desligada: clique para ativar{{#unless passiva}} (usa a habilidade e paga o custo){{/unless}}{{/if}}" {{#unless @root.editavel}}disabled{{/unless}}><span class="epm-chave-hab-trilho"><span class="epm-chave-hab-bola"></span></span><span class="epm-chave-hab-texto">{{#if ativa}}Ativa{{else}}Inativa{{/if}}</span></button>{{/if}}
    {{#if (epmEq tipo "magia")}}{{#unless bloqueada}}<button type="button" class="epm-icone-botao epm-conjunta" data-action="magiaConjunta" data-item-id="{{this.id}}" title="Magia conjunta: lançar junto com outro conjurador (dividem a Mana; CD maior + 2)"><i class="fa-solid fa-people-arrows"></i></button>{{/unless}}{{/if}}
    <div class="epm-item-controles">
      <button type="button" class="epm-icone-botao epm-favorito{{#if favorito}} ativo{{/if}}" data-action="favoritar" data-item-id="{{this.id}}" title="{{#if favorito}}Tirar dos favoritos{{else}}Favoritar (fica no topo){{/if}}" aria-pressed="{{#if favorito}}true{{else}}false{{/if}}"><i class="fa-{{#if favorito}}solid{{else}}regular{{/if}} fa-star"></i></button>
      <button type="button" class="epm-icone-botao" data-action="chatItem" data-item-id="{{this.id}}" title="Mostrar descrição no chat"><i class="fa-solid fa-comment"></i></button>
      {{#if @root.edicao}}
      <button type="button" class="epm-icone-botao" data-action="editarPoder" data-item-id="{{this.id}}" title="Editar formas, custos e melhorias"><i class="fa-solid fa-pen-to-square"></i></button>
      <button type="button" class="epm-icone-botao" data-action="duplicarPoder" data-item-id="{{this.id}}" title="Duplicar (criar uma variante)"><i class="fa-solid fa-clone"></i></button>
      <button type="button" class="epm-icone-botao perigo" data-action="excluirItem" data-item-id="{{this.id}}" title="Excluir"><i class="fa-solid fa-trash"></i></button>
      {{/if}}
    </div>
  </div>
  {{#if expandido}}
  <div class="epm-poder-detalhes">
    {{#if descricao}}<div class="epm-descricao">{{{this.descricao}}}</div>{{/if}}
    {{#each formas}}
    <div class="epm-forma-resumo{{#if bloqueada}} bloqueada{{/if}}">
      <strong>{{this.nome}}</strong>
      <span class="epm-tag">{{this.acaoLabel}}</span>
      <span class="epm-tag">{{this.custoTexto}}</span>
      {{#if resistencia}}<span class="epm-tag" title="{{@root.ficha.cd.formula}}">DT {{@root.ficha.cd.valor}}</span>{{/if}}
      {{#if dano}}<span class="epm-tag epm-tag-dano" data-tooltip="{{this.danoDica}}" data-tooltip-class="epm-dica-tooltip">{{this.dano}}</span>{{/if}}
      {{#if requisitos.length}}<span class="epm-tag fraca">{{epmJoin requisitos}}</span>{{/if}}
      {{#if duracao}}<span class="epm-tag" title="Duração">{{this.duracao}}</span>{{/if}}
      {{#if usoLabel}}<span class="epm-tag epm-uso-forma{{#if usoGasto}} gasto{{/if}}">{{this.usoLabel}}{{#if usoGasto}} (usada){{/if}}</span>{{/if}}
      {{#if bloqueada}}<span class="epm-bloqueio">bloqueada por {{this.motivosTexto}}</span>{{/if}}
    </div>
    {{#if efeito}}<div class="epm-forma-efeito-texto">{{{this.efeito}}}</div>{{/if}}
    {{/each}}
    {{#each alertas}}<p class="epm-aviso">{{this}}</p>{{/each}}
    {{#unless descricao}}{{#unless nFormas}}<p class="epm-vazio">Sem descrição nem formas.</p>{{/unless}}{{/unless}}
  </div>
  {{/if}}
</li>
